root = true

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true

csharp_new_line_before_open_brace = none
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = true

csharp_space_after_keywords_in_control_flow_statements = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_after_cast = false
csharp_space_after_comma = false
csharp_space_before_comma = false
csharp_space_around_binary_operators = none
csharp_space_around_declaration_statements = false
csharp_space_before_colon_in_inheritance_clause = false
csharp_space_after_colon_in_inheritance_clause = false
# カンマ後のスペースも排除（現在は before/after 両方が false なので、それに合わせる）
dotnet_style_parentheses_in_arithmetic_binary_operators = never_if_unnecessary:silent

# 以下の設定で「型キャスト」の後のスペースも詰められます
csharp_space_after_cast = false

# this 修飾を必須化
dotnet_style_qualification_for_field = true:warning
dotnet_style_qualification_for_property = true:warning
dotnet_style_qualification_for_method = true:warning
dotnet_style_qualification_for_event = true:warning

# 「this は冗長です」(IDE0003) を無効化
dotnet_diagnostic.ide0003.severity = none

# ReSharper properties
resharper_align_first_arg_by_paren = false
resharper_align_multiline_array_and_object_initializer = false
resharper_align_multiline_list_pattern = false
resharper_align_multiline_property_pattern = false
resharper_align_multiline_switch_expression = false
resharper_csharp_align_multiline_expression = false
resharper_indent_anonymous_method_block = false

# 名前空間はプロジェクト名と 1 対 1 で、サブフォルダーは分類専用。
# フォルダー階層から名前空間を提案する IDE0130 は無効化する。詳細は AI_SYNTAX_RULES.md を参照。
dotnet_diagnostic.IDE0130.severity = none
csharp_style_namespace_declarations = file_scoped:warning

[*.md]
charset = utf-8-bom
