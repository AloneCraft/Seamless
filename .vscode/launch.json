{
    // IntelliSense を使用して利用可能な属性を学べます。
    // 既存の属性の説明をホバーして表示します。
    // 詳細情報は次を確認してください: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Default",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-benchmark",
            "program": "${workspaceFolder}/sandbox/Benchmark/bin/Debug/net10.0/Benchmark.dll",
            "args": ["--filter", "*", "--", "Default"],
            "cwd": "${workspaceFolder}/sandbox/Benchmark",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Select Benchmark",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-benchmark",
            "program": "${workspaceFolder}/sandbox/Benchmark/bin/Debug/net10.0/Benchmark.dll",
            "args": [],
            "env": {
                "BDN_DEBUG": "1"
            },
            "cwd": "${workspaceFolder}/sandbox/Benchmark",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Run All Benchmarks",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-benchmark",
            "program": "${workspaceFolder}/sandbox/Benchmark/bin/Debug/net10.0/Benchmark.dll",
            "args": ["--filter", "*"],
            "cwd": "${workspaceFolder}/sandbox/Benchmark",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Run All Benchmarks with --join",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-benchmark",
            "program": "${workspaceFolder}/sandbox/Benchmark/bin/Debug/net10.0/Benchmark.dll",
            "args": ["--filter", "*", "--join"],
            "cwd": "${workspaceFolder}/sandbox/Benchmark",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "List Benchmark",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-benchmark",
            "program": "${workspaceFolder}/sandbox/Benchmark/bin/Debug/net10.0/Benchmark.dll",
            "args": ["--list", "tree"],
            "cwd": "${workspaceFolder}/sandbox/Benchmark",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Help",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-benchmark",
            "program": "${workspaceFolder}/sandbox/Benchmark/bin/Debug/net10.0/Benchmark.dll",
            "args": ["--help"],
            "cwd": "${workspaceFolder}/sandbox/Benchmark",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Run All Benchmarks (Release)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-benchmark-release",
            "program": "${workspaceFolder}/sandbox/Benchmark/bin/Release/net10.0/Benchmark.dll",
            "args": ["--filter", "*", "--", "Default"],
            "cwd": "${workspaceFolder}/sandbox/Benchmark",
            "console": "integratedTerminal",
            "stopAtEntry": false
        }
    ]
}
