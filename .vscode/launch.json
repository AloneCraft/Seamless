{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Seamless 開発サーバー",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/Seamless/Database/Server/bin/Debug/net10.0/Server.exe",
      "cwd": "${workspaceFolder}/Seamless/Database/Server/bin/Debug/net10.0",
      "console": "internalConsole",
      "args": ["ide-server", "--root", "Work/IdeLaunch/server"],
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Seamless テストクライアント",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/Samples/Sample.Management.Client/bin/Debug/net10.0-windows/Sample.Management.Client.exe",
      "cwd": "${workspaceFolder}/Samples/Sample.Management.Client/bin/Debug/net10.0-windows",
      "console": "internalConsole",
      "args": ["--root", "Work/IdeLaunch/server"],
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "SeamlessDB + Manager (Standalone)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/Seamless/Management/bin/Debug/net10.0/Manager.exe",
      "cwd": "${workspaceFolder}/Seamless/Management/bin/Debug/net10.0",
      "console": "internalConsole",
      "args": ["ide-standalone", "--root", "Work/IdeLaunch/standalone"],
      "preLaunchTask": "build-seamless-standalone"
    },
    {
      "name": "Benchmark.Dynamic.UI (Debug)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/Benchmark/Benchmark.Dynamic.UI/bin/Debug/net10.0-windows/win-x64/Benchmark.Dynamic.UI.exe",
      "cwd": "${workspaceFolder}/Benchmark/Benchmark.Dynamic.UI/bin/Debug/net10.0-windows/win-x64",
      "console": "internalConsole",
      "stopAtEntry": false,
      "preLaunchTask": "build-benchmark-dynamic-ui-debug"
    },
    {
      "name": "Benchmark.Dynamic.UI (Release)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/Benchmark/Benchmark.Dynamic.UI/bin/Release/net10.0-windows/win-x64/Benchmark.Dynamic.UI.exe",
      "cwd": "${workspaceFolder}/Benchmark/Benchmark.Dynamic.UI/bin/Release/net10.0-windows/win-x64",
      "console": "internalConsole",
      "stopAtEntry": false,
      "preLaunchTask": "build-benchmark-dynamic-ui-release"
    },
    {
      "name": "▶ Benchmark.Audit",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Benchmark/Benchmark.Audit/Benchmark.Audit.csproj"
    },
    {
      "name": "▶ Benchmark.Dynamic.UI",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Benchmark/Benchmark.Dynamic.UI/Benchmark.Dynamic.UI.csproj"
    },
    {
      "name": "▶ Benchmark.Dynamic.Worker",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Benchmark/Benchmark.Dynamic.Worker/Benchmark.Dynamic.Worker.csproj"
    },
    {
      "name": "▶ Benchmark.Headless",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Benchmark/Benchmark.Headless/Benchmark.Headless.csproj"
    },
    {
      "name": "▶ Benchmark.Scalable.UI",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Benchmark/Benchmark.Scalable.UI/Benchmark.Scalable.UI.csproj"
    },
    {
      "name": "▶ Benchmark.TpcC",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Benchmark/Benchmark.TpcC/Benchmark.TpcC.csproj"
    },
    {
      "name": "▶ Benchmark.TpcC.Spike",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Benchmark/Benchmark.TpcC.Spike/Benchmark.TpcC.Spike.csproj"
    },
    {
      "name": "▶ Benchmark.TpcE",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Benchmark/Benchmark.TpcE/Benchmark.TpcE.csproj"
    },
    {
      "name": "▶ Benchmark.TpcE.Compliance",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Benchmark/Benchmark.TpcE.Compliance/Benchmark.TpcE.Compliance.csproj"
    },
    {
      "name": "▶ DataGrip.Stage1.Server",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/tools/Seamless.DataGrip/Server/DataGrip.Stage1.Server.csproj"
    },
    {
      "name": "▶ Experiments",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Benchmark/Experiments/Experiments.csproj"
    },
    {
      "name": "▶ Sample.NetShop",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Samples/Sample.NetShop/Sample.NetShop.csproj"
    },
    {
      "name": "▶ Sample.VirtualDb",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Samples/Sample.VirtualDb/Sample.VirtualDb.csproj"
    },
    {
      "name": "▶ TestSeamless",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/TestSeamless/TestSeamless.csproj"
    },
    {
      "name": "▶ Worker",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Benchmark/Worker/Worker.csproj"
    }
  ],
  "compounds": [
    {
      "name": "SeamlessDB Server + Manager + Client",
      "configurations": ["Seamless 開発サーバー", "Seamless テストクライアント"],
      "preLaunchTask": "build-seamless-server-and-client",
      "stopAll": true
    }
  ]
}
