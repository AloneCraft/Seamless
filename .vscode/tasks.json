{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Seamless.slnx",
                "-m:1",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build-release",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Seamless.slnx",
                "-c",
                "Release",
                "-m:1",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "build-benchmark-ui-debug",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Benchmark/Benchmark.UI/Benchmark.UI.csproj",
                "-m:1",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-benchmark-ui-release",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Benchmark/Benchmark.UI/Benchmark.UI.csproj",
                "-c",
                "Release",
                "-m:1",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-benchmark-ui-aot-release",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Benchmark/Benchmark.UI/Benchmark.UI.csproj",
                "-c",
                "Release",
                "-m:1",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-benchmark-scalable-ui-debug",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Benchmark/Benchmark.Scalable.UI/Benchmark.Scalable.UI.csproj",
                "-m:1",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-benchmark-scalable-ui-release",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Benchmark/Benchmark.Scalable.UI/Benchmark.Scalable.UI.csproj",
                "-m:1",
                "-c",
                "Release",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-benchmark-parameter-sweep-ui-debug",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Benchmark/Benchmark.Tsavorite.ParameterSweep.UI/Benchmark.Tsavorite.ParameterSweep.UI.csproj",
                "-m:1",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-benchmark-parameter-sweep-ui-release",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Benchmark/Benchmark.Tsavorite.ParameterSweep.UI/Benchmark.Tsavorite.ParameterSweep.UI.csproj",
                "-c",
                "Release",
                "-m:1",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test-release",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/Seamless.slnx",
                "-m:1",
                "/nodeReuse:false",
                "-c",
                "Release",
                "--no-restore",
                "--settings",
                "${workspaceFolder}/test.runsettings"
            ],
            "problemMatcher": "$msCompile",
            "group": "test"
        },
        {
            "label": "test-release-diagnostics",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/Seamless.slnx",
                "-m:1",
                "/nodeReuse:false",
                "-c",
                "Release",
                "--no-restore",
                "--settings",
                "${workspaceFolder}/test.runsettings",
                "--logger",
                "console;verbosity=diagnostic",
                "--logger",
                "trx;LogFileName=artifacts/test-release-diagnostic.trx"
            ],
            "problemMatcher": "$msCompile",
            "group": "test"
        }
    ]
