<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <RootNamespace>Benchmark.Persisted.Collection</RootNamespace>
    <AssemblyName>Benchmark.Persisted.Collection</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="MemoryPack" Version="1.*" />
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="BenchmarkDotNet.Attributes" />
    <Using Include="BenchmarkDotNet.Configs" />
    <Using Include="BenchmarkDotNet.Engines" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Seamless\Seamless.csproj" />
  </ItemGroup>
  <Import Project="..\Collections.Shared\Collections.Shared.projitems" Label="Shared" />
  <ItemGroup>
    <Compile Include="..\Test\Seamless\Persisted\Collections\**\*.cs" Exclude="..\Test\Seamless\Persisted\Collections\ListTestBase.cs;..\Test\Seamless\Persisted\Collections\ListTestStrategy.cs" />
  </ItemGroup>
</Project>
