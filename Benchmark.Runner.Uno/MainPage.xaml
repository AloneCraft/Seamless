<Page x:Class="Benchmark.Runner.Uno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Benchmark.Runner.Uno"
      Loaded="OnPageLoaded"
      KeyDown="OnPageKeyDown"
      KeyUp="OnPageKeyUp"
      MinWidth="1180"
      MinHeight="720"
      Background="#F8F7F2">
  <Page.Resources>
    <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <Style TargetType="ScrollBar">
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="Width" Value="18" />
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="CompactButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Page.Resources>

  <Grid RowDefinitions="80,54,*,Auto">
    <Border Background="#DDF5F8">
      <Grid Padding="16,0"
            ColumnDefinitions="320,*,Auto"
            ColumnSpacing="12">
        <StackPanel VerticalAlignment="Center"
                    Spacing="3">
          <TextBlock Text="Seamless Benchmark"
                     FontSize="28"
                     FontWeight="SemiBold"
                     Foreground="#172026" />
          <TextBlock Text="ベンチマークを選び、CPUを指定して計測します。"
                     FontSize="13"
                     Foreground="#58646B" />
        </StackPanel>
        <Grid x:Name="ProjectGrid"
              Grid.Column="1"
              VerticalAlignment="Center"
              ColumnSpacing="10"
              RowSpacing="0"
              ColumnDefinitions="Auto,Auto"
              RowDefinitions="20,20,20,20" />
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="10">
          <ComboBox x:Name="ConfigurationComboBox"
                    Width="120"
                    SelectedIndex="1"
                    SelectionChanged="OnConfigurationSelectionChanged">
            <ComboBoxItem Content="Debug" />
            <ComboBoxItem Content="Release" />
          </ComboBox>
          <ComboBox x:Name="ElementScaleComboBox"
                    Width="110"
                    SelectedIndex="4">
            <ComboBoxItem Content="0.06125" />
            <ComboBoxItem Content="0.125" />
            <ComboBoxItem Content="0.25" />
            <ComboBoxItem Content="0.5" />
            <ComboBoxItem Content="1" />
            <ComboBoxItem Content="2" />
            <ComboBoxItem Content="4" />
            <ComboBoxItem Content="8" />
            <ComboBoxItem Content="16" />
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          Padding="14,8"
          ColumnSpacing="8"
          ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,220,Auto,Auto,*,Auto"
          Background="#FAFBFC">
      <Button Content="更新"
              Style="{StaticResource ToolbarButtonStyle}"
              Click="OnRefreshClick" />
      <Button x:Name="SelectAllButton"
              Grid.Column="1"
              Content="全選択"
              Style="{StaticResource ToolbarButtonStyle}"
              Click="OnSelectAllClick" />
      <Button x:Name="ClearSelectionButton"
              Grid.Column="2"
              Content="解除"
              Style="{StaticResource ToolbarButtonStyle}"
              Click="OnClearSelectionClick" />
      <TextBlock Grid.Column="3"
                 Text="Scale"
                 VerticalAlignment="Center"
                 Foreground="#344254" />
      <TextBlock Grid.Column="4"
                 Text="{Binding SelectedItem.Content, ElementName=ElementScaleComboBox}"
                 MinWidth="58"
                 Padding="12,6"
                 TextAlignment="Center"
                 VerticalAlignment="Center"
                 Background="#FFFFFF" />
      <Button x:Name="RunButton"
              Grid.Column="5"
              Content="実行"
              Style="{StaticResource ToolbarButtonStyle}"
              Click="OnRunClick" />
      <Button x:Name="CancelButton"
              Grid.Column="6"
              Content="中止"
              Style="{StaticResource ToolbarButtonStyle}"
              Click="OnCancelClick"
              IsEnabled="False" />
      <Button x:Name="SelectTop10Button"
              Grid.Column="7"
              Content="上位10件"
              Style="{StaticResource ToolbarButtonStyle}"
              Click="OnSelectTop10Click" />
      <Button x:Name="RerunNextScaleButton"
              Grid.Column="8"
              Content="次スケール"
              Style="{StaticResource ToolbarButtonStyle}"
              Click="OnRerunNextScaleClick" />
      <TextBox x:Name="CsvPathTextBox"
               Grid.Column="9"
               MinWidth="220"
               PlaceholderText="実測値CSVのパス" />
      <Button x:Name="CsvLoadButton"
              Grid.Column="10"
              Content="CSV"
              Style="{StaticResource ToolbarButtonStyle}"
              Click="OnLoadCsvClick" />
      <Button x:Name="ChartToggleButton"
              Grid.Column="11"
              Content="分析を隠す"
              Style="{StaticResource ToolbarButtonStyle}"
              Click="OnChartToggleClick" />
      <TextBlock x:Name="SelectionSummaryText"
                 Grid.Column="12"
                 VerticalAlignment="Center"
                 Foreground="#344254" />
      <ProgressRing x:Name="BusyRing"
                    Grid.Column="13"
                    Width="24"
                    Height="24"
                    IsActive="False" />
    </Grid>

    <Grid Grid.Row="2"
          ColumnDefinitions="44*,56*">
      <Border BorderBrush="#E3E8EE"
              BorderThickness="0,1,1,0"
              Background="#FFFFFF">
        <Grid RowDefinitions="38,*">
          <Grid Padding="12,0"
                ColumnDefinitions="24,*">
            <Button x:Name="SelectionHeaderButton"
                    Content="☐"
                    Width="20"
                    Height="20"
                    Padding="0"
                    FontSize="11"
                    VerticalAlignment="Center"
                    Click="OnSelectionHeaderClick" />
            <Button x:Name="BenchmarkHeaderButton"
                    Grid.Column="1"
                    Content="ベンチマーク"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Padding="0"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Click="OnBenchmarkHeaderClick" />
          </Grid>
          <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="BenchmarkItemsControl">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:BenchmarkItem">
                  <Grid Height="44"
                        Padding="12,0"
                        ColumnDefinitions="30,*"
                        Tag="{Binding}"
                        Tapped="OnBenchmarkRowTapped"
                        Background="Transparent">
                    <Border Width="18"
                            Height="18"
                            BorderBrush="#8F938D"
                            BorderThickness="1"
                            CornerRadius="3"
                            Background="#FFFFFF"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding CheckGlyph}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="#0B73C7" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding DisplayName}"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Foreground="#142033" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <Grid x:Name="AnalysisPanel"
            Grid.Column="1"
            RowDefinitions="38,Auto,*,178"
            Background="#FFFFFF">
        <Grid Padding="12,0">
          <TextBlock Text="結果"
                     FontSize="15"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Foreground="#142033" />
        </Grid>

        <Grid Grid.Row="1"
              Padding="10,6,10,8"
              RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="6"
              BorderBrush="#E3E8EE"
              BorderThickness="0,1,0,1">
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal"
                        Spacing="6">
              <Button Content="System比" Tag="System" Style="{StaticResource CompactButtonStyle}" Click="OnAnalysisPairClick" />
              <Button Content="Persisted比" Tag="Persisted" Style="{StaticResource CompactButtonStyle}" Click="OnAnalysisPairClick" />
              <Button Content="Tsavorite比" Tag="Tsavorite" Style="{StaticResource CompactButtonStyle}" Click="OnAnalysisPairClick" />
              <Button Content="PersistedLinq/TsavoriteLinq比" Tag="PersistedLinqTsavoriteLinq" Style="{StaticResource CompactButtonStyle}" Click="OnAnalysisPairClick" />
              <Button Content="PersistedFLinq/TsavoriteFLinq比" Tag="PersistedFLinqTsavoriteFLinq" Style="{StaticResource CompactButtonStyle}" Click="OnAnalysisPairClick" />
            </StackPanel>
          </ScrollViewer>
          <Grid Grid.Row="1"
                ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*"
                ColumnSpacing="6">
            <Button Content="時間" Tag="Time" Style="{StaticResource CompactButtonStyle}" Click="OnAnalysisMetricClick" />
            <Button Grid.Column="1" Content="割当" Tag="Allocated" Style="{StaticResource CompactButtonStyle}" Click="OnAnalysisMetricClick" />
            <CheckBox x:Name="CheckedOnlyCheckBox"
                      Grid.Column="2"
                      Content="チェック済みのみ"
                      VerticalAlignment="Center"
                      Click="OnCheckedOnlyClick" />
            <Button Grid.Column="3" Content="ランキング" Tag="Ranking" Style="{StaticResource CompactButtonStyle}" Click="OnAnalysisTabClick" />
            <Button Grid.Column="4" Content="ヒートマップ" Tag="Heatmap" Style="{StaticResource CompactButtonStyle}" Click="OnAnalysisTabClick" />
            <Button Grid.Column="5" Content="詳細" Tag="Detail" HorizontalAlignment="Left" Style="{StaticResource CompactButtonStyle}" Click="OnAnalysisTabClick" />
          </Grid>
          <TextBlock x:Name="AnalysisSummaryText"
                     Grid.Row="2"
                     Foreground="#344254"
                     TextWrapping="Wrap" />
          <ScrollViewer Grid.Row="3"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="BenchmarkTableHeaderItemsControl">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:BenchmarkTableColumn">
                  <Grid Width="154"
                        RowDefinitions="18,24"
                        ColumnDefinitions="77,77"
                        Margin="0,0,6,0"
                        ToolTipService.ToolTip="{Binding TooltipText}">
                    <TextBlock Grid.ColumnSpan="2"
                               Text="{Binding HeaderText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Row="1"
                            Content="{Binding TimeHeaderText}"
                            Tag="{Binding}"
                            FontSize="10"
                            Padding="0"
                            Click="OnTableColumnTimeHeaderClick" />
                    <Button Grid.Row="1"
                            Grid.Column="1"
                            Content="{Binding AllocatedHeaderText}"
                            Tag="{Binding}"
                            FontSize="10"
                            Padding="0"
                            Click="OnTableColumnAllocatedHeaderClick" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      Padding="10,6"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
          <Grid>
            <ItemsControl x:Name="RankingItemsControl">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:AnalysisRankingItem">
                  <Grid Height="28"
                        ColumnDefinitions="230,220,70,76"
                        ColumnSpacing="8"
                        Tag="{Binding}"
                        Tapped="OnAnalysisRankingTapped">
                    <TextBlock Text="{Binding Benchmark}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Grid Grid.Column="1"
                          Height="14"
                          VerticalAlignment="Center">
                      <Border Background="{Binding BarBrush}"
                              BorderBrush="{Binding BorderBrush}"
                              BorderThickness="{Binding BorderThickness}"
                              CornerRadius="3"
                              HorizontalAlignment="Left"
                              Width="{Binding BarWidth}" />
                    </Grid>
                    <TextBlock Grid.Column="2"
                               Text="{Binding DisplayText}"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="3"
                            Content="追加"
                            Tag="{Binding}"
                            Style="{StaticResource CompactButtonStyle}"
                            Click="OnAnalysisAddBenchmarkClick" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl x:Name="HeatmapItemsControl"
                          Visibility="Collapsed">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:AnalysisHeatmapRow">
                  <Grid Height="30"
                        ColumnDefinitions="230,110,110,110,180,180"
                        ColumnSpacing="4">
                    <TextBlock Text="{Binding Benchmark}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{Binding SystemDisplay}" Background="{Binding SystemCell.Background}" Tag="{Binding SystemCell}" Click="OnAnalysisHeatmapCellClick" />
                    <Button Grid.Column="2" Content="{Binding PersistedDisplay}" Background="{Binding PersistedCell.Background}" Tag="{Binding PersistedCell}" Click="OnAnalysisHeatmapCellClick" />
                    <Button Grid.Column="3" Content="{Binding TsavoriteDisplay}" Background="{Binding TsavoriteCell.Background}" Tag="{Binding TsavoriteCell}" Click="OnAnalysisHeatmapCellClick" />
                    <Button Grid.Column="4" Content="{Binding PersistedLinqTsavoriteLinqDisplay}" Background="{Binding PersistedLinqTsavoriteLinqCell.Background}" Tag="{Binding PersistedLinqTsavoriteLinqCell}" Click="OnAnalysisHeatmapCellClick" />
                    <Button Grid.Column="5" Content="{Binding PersistedFLinqTsavoriteFLinqDisplay}" Background="{Binding PersistedFLinqTsavoriteFLinqCell.Background}" Tag="{Binding PersistedFLinqTsavoriteFLinqCell}" Click="OnAnalysisHeatmapCellClick" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl x:Name="DetailItemsControl"
                          Visibility="Collapsed">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:AnalysisDetailItem">
                  <Grid Height="30"
                        ColumnDefinitions="220,70,70,120,120"
                        ColumnSpacing="8">
                    <TextBlock Text="{Binding PairName}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding TimeRatio}" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding AllocatedRatio}" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding LeftValue}" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding RightValue}" TextAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </ScrollViewer>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,*"
              ColumnSpacing="8"
              Padding="10,0,10,8">
          <Border BorderBrush="#E3E8EE"
                  BorderThickness="1"
                  Background="#FFFEFA"
                  CornerRadius="4">
            <Grid RowDefinitions="Auto,Auto,*">
              <Grid Padding="8,4"
                    ColumnDefinitions="*,Auto">
                <TextBlock Text="CPU"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="CpuSummaryText"
                           Grid.Column="1"
                           Text="0 / 0 CPUを選択中"
                           FontSize="12"
                           Foreground="#58646B" />
              </Grid>
              <Grid x:Name="CpuPresetGrid"
                    Grid.Row="1"
                    Padding="6,0,6,4"
                    ColumnSpacing="6" />
              <ListView x:Name="CpuItemsControl"
                        Grid.Row="2"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionMode="None"
                        IsItemClickEnabled="False"
                        HorizontalContentAlignment="Stretch"
                        Padding="2,0,2,2"
                        BorderThickness="0"
                        Background="Transparent">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="Height" Value="16" />
                    <Setter Property="MaxHeight" Value="16" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="local:CpuRowItem">
                    <Grid Height="16"
                          Padding="4,0"
                          ColumnSpacing="4"
                          ColumnDefinitions="*,*,*,*">
                      <Grid Tag="{Binding Column0}"
                            Tapped="OnCpuCellTapped"
                            ColumnDefinitions="13,*"
                            Visibility="{Binding Column0, Converter={StaticResource NullToVisibilityConverter}}"
                            Background="Transparent">
                        <Border Width="10" Height="10" BorderBrush="#8F938D" BorderThickness="1" CornerRadius="2" Background="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Column0.CheckGlyph}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#202020" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Column0.DisplayText}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </Grid>
                      <Grid Grid.Column="1"
                            Tag="{Binding Column1}"
                            Tapped="OnCpuCellTapped"
                            ColumnDefinitions="13,*"
                            Visibility="{Binding Column1, Converter={StaticResource NullToVisibilityConverter}}"
                            Background="Transparent">
                        <Border Width="10" Height="10" BorderBrush="#8F938D" BorderThickness="1" CornerRadius="2" Background="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Column1.CheckGlyph}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#202020" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Column1.DisplayText}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </Grid>
                      <Grid Grid.Column="2"
                            Tag="{Binding Column2}"
                            Tapped="OnCpuCellTapped"
                            ColumnDefinitions="13,*"
                            Visibility="{Binding Column2, Converter={StaticResource NullToVisibilityConverter}}"
                            Background="Transparent">
                        <Border Width="10" Height="10" BorderBrush="#8F938D" BorderThickness="1" CornerRadius="2" Background="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Column2.CheckGlyph}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#202020" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Column2.DisplayText}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </Grid>
                      <Grid Grid.Column="3"
                            Tag="{Binding Column3}"
                            Tapped="OnCpuCellTapped"
                            ColumnDefinitions="13,*"
                            Visibility="{Binding Column3, Converter={StaticResource NullToVisibilityConverter}}"
                            Background="Transparent">
                        <Border Width="10" Height="10" BorderBrush="#8F938D" BorderThickness="1" CornerRadius="2" Background="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Column3.CheckGlyph}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#202020" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Column3.DisplayText}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Border>

          <Border Grid.Column="1"
                  BorderBrush="#E3E8EE"
                  BorderThickness="1"
                  Background="#FFFEFA"
                  CornerRadius="4">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Text="実行中"
                         Padding="8,4"
                         FontSize="12"
                         FontWeight="SemiBold" />
              <ScrollViewer Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RunningItemsControl">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:BenchmarkRunItem">
                      <Grid Height="20"
                            Padding="6,0"
                            ColumnDefinitions="1.2*,*,70,50">
                        <TextBlock Text="{Binding ProjectDisplayName}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding MethodName}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11" />
                        <TextBlock Grid.Column="3" Text="{Binding ProcessIdText}" FontSize="11" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <Grid Grid.Row="3"
          RowDefinitions="Auto,Auto,142"
          Padding="14,8,14,14"
          Background="#F8F7F2">
      <ProgressBar x:Name="ProgressBar"
                   Height="4"
                   Minimum="0"
                   Maximum="1"
                   Value="0" />
      <StackPanel Grid.Row="1"
                  Spacing="2"
                  Margin="0,6,0,6">
        <TextBlock x:Name="StatusText"
                   Text="準備完了"
                   Foreground="#344254" />
        <TextBlock x:Name="RunTimeText"
                   Text="実行時間: -"
                   FontSize="12"
                   Foreground="#58646B" />
        <TextBlock x:Name="ProgressText"
                   Text="実行待ちはありません"
                   FontSize="12"
                   Foreground="#344254" />
      </StackPanel>
      <TextBox x:Name="LogTextBox"
               Grid.Row="2"
               AcceptsReturn="True"
               FontFamily="Cascadia Mono, Yu Gothic UI, Meiryo, Consolas"
               FontSize="12"
               IsReadOnly="True"
               TextWrapping="NoWrap"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
  </Grid>
</Page>
