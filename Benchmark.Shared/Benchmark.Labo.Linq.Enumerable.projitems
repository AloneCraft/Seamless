<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Infrastructure\**\*.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)Infrastructure\TsavoriteBase.cs" Condition="'$(LaboTsavorite)'!='true'" />
    <Compile Remove="$(MSBuildThisFileDirectory)Infrastructure\TsavoriteConsumerExtensions.cs" Condition="'$(LaboTsavorite)'!='true'" />
    <Compile Include="$(MSBuildThisFileDirectory)Labo\Linq.Enumerable\**\*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Labo\Linq.Enumerable.Benchmark\**\*.cs" Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('Labo.Benchmark.'))" />
    <Compile Remove="$(MSBuildThisFileDirectory)Labo\Linq.Enumerable\TsavoriteEnumerableMethods.cs" Condition="'$(LaboTsavorite)'!='true'" />
    <Compile Remove="$(MSBuildThisFileDirectory)Labo\Linq.Enumerable\EnumerableMethods.cs" Condition="'$(LaboTsavorite)'=='true'" />
  </ItemGroup>
</Project>