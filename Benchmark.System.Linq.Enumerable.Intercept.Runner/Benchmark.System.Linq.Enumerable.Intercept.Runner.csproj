<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <StartupObject>Tsavorite.Benchmark.Program</StartupObject>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <RootNamespace>Benchmark.System.Linq.Enumerable.Intercept.Runner</RootNamespace>
    <AssemblyName>Benchmark.System.Linq.Enumerable.Intercept.Runner</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <SeamlessBenchmarkOutputLabel Condition="'$(SeamlessBenchmarkOutputLabel)' == ''">System.Linq.Enumerable.Intercept</SeamlessBenchmarkOutputLabel>
    <SeamlessBenchmarkOutputFrameworkLabel Condition="'$(SeamlessBenchmarkOutputFrameworkLabel)' == ''">net10</SeamlessBenchmarkOutputFrameworkLabel>
    <SeamlessBaseConfiguration Condition="'$(SeamlessBaseConfiguration)' == ''">$(Configuration)</SeamlessBaseConfiguration>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BenchmarkSourceAssembly</_Parameter1>
      <_Parameter2>Benchmark.System.Linq.Enumerable.Intercept</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BenchmarkProjectDir</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SeamlessBenchmarkOutputLabel</_Parameter1>
      <_Parameter2>$(SeamlessBenchmarkOutputLabel)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SeamlessBenchmarkOutputFrameworkLabel</_Parameter1>
      <_Parameter2>$(SeamlessBenchmarkOutputFrameworkLabel)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SeamlessBaseConfiguration</_Parameter1>
      <_Parameter2>$(SeamlessBaseConfiguration)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Benchmark\Program.cs" Link="Program.cs" />
    <Compile Include="..\Benchmark\BenchmarkColumnsConfig.cs" Link="BenchmarkColumnsConfig.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.Intercept\Benchmark.System.Linq.Enumerable.Intercept.csproj" />
  </ItemGroup>
</Project>
