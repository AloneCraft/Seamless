<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <RootNamespace>Benchmark.Tsavorite.Collection</RootNamespace>
    <AssemblyName>Benchmark.Tsavorite.Collection</AssemblyName>
    <DefineConstants>$(DefineConstants);TSAVORITE2_0BETA3</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="MemoryPack" Version="1.*" />
    <PackageReference Include="Microsoft.Garnet" Version="2.0.1-beta.5" />
    <PackageReference Include="ZLinq" Version="1.5.6" />
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="BenchmarkDotNet.Attributes" />
    <Using Include="BenchmarkDotNet.Configs" />
    <Using Include="BenchmarkDotNet.Engines" />
    <Using Include="Benchmark.Shared" />
    <Using Include="Seamless.Serialization" />
    <Using Include="Seamless.Tsavorite.Collections" />
    <Using Include="Seamless.Tsavorite.Stores" />
    <Using Include="Test.Collections" />
    <Using Include="Xunit" />
    <Using Include="ZLinq" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Seamless\Seamless.csproj" />
    <ProjectReference Include="..\Test.Collections\Test.Collections.csproj" />
  </ItemGroup>
  <Import Project="..\Tsavorite.Collection.Shared\Tsavorite.Collection.Shared.projitems" Label="Shared" />
</Project>
