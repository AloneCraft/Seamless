<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)*.cs" />
    <MauiXaml Include="$(MSBuildThisFileDirectory)App.xaml" Link="App.xaml" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Compile Include="$(MSBuildThisFileDirectory)Platforms\Windows\*.cs" Link="Platforms\Windows\%(Filename)%(Extension)" />
    <ApplicationDefinition Include="$(MSBuildThisFileDirectory)Platforms\Windows\App.xaml" Link="Platforms\Windows\App.xaml" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <Compile Include="$(MSBuildThisFileDirectory)Platforms\MacCatalyst\*.cs" Link="Platforms\MacCatalyst\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon Include="$(MSBuildThisFileDirectory)Resources\AppIcon\appicon.svg" Link="Resources\AppIcon\appicon.svg" />
    <MauiSplashScreen Include="$(MSBuildThisFileDirectory)Resources\Splash\splash.svg" Link="Resources\Splash\splash.svg" Color="#1F2937" BaseSize="128,128" />
    <MauiImage Include="$(MSBuildThisFileDirectory)Resources\Images\*.svg" Link="Resources\Images\%(Filename)%(Extension)" BaseSize="24,24" />
  </ItemGroup>
</Project>