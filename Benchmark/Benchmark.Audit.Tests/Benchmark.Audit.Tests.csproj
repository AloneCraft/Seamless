<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Benchmark.Audit.Tests</RootNamespace>
    <AssemblyName>Benchmark.Audit.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- ベンチ本体を読み込んで結果ダイジェストを取るため、ベンチ本体が使うパッケージを出力へ置く。 -->
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="ZLinq" Version="1.5.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\Benchmark.Audit\Benchmark.Audit.csproj" />
  </ItemGroup>
  <!-- 監査対象のベンチ本体。先にビルドさせるだけで、出力は参照しない(同名の型が衝突するため)。各出力フォルダーから読む。 -->
  <ItemGroup>
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.FLinq\Benchmark.System.Linq.Enumerable.FLinq.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.List.FLinq\Benchmark.System.Linq.Enumerable.List.FLinq.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.IEnumerable.FLinq\Benchmark.System.Linq.Enumerable.IEnumerable.FLinq.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.Range.FLinq\Benchmark.System.Linq.Enumerable.Range.FLinq.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Benchmark.Optimization.All\Benchmark.Optimization.All.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.ZLinq\Benchmark.System.Linq.Enumerable.ZLinq.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.List.ZLinq\Benchmark.System.Linq.Enumerable.List.ZLinq.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.Ideal\Benchmark.System.Linq.Enumerable.Ideal.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.List.Ideal\Benchmark.System.Linq.Enumerable.List.Ideal.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.IEnumerable.ZLinq\Benchmark.System.Linq.Enumerable.IEnumerable.ZLinq.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.IEnumerable.Ideal\Benchmark.System.Linq.Enumerable.IEnumerable.Ideal.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.Range.ZLinq\Benchmark.System.Linq.Enumerable.Range.ZLinq.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.Range.Ideal\Benchmark.System.Linq.Enumerable.Range.Ideal.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
