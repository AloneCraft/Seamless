    ],
    "Expression": "source.GroupBy(x=>x&15).Select(g=>g.Key*10+g.Count()).Where(x=>(x&1)==0).Sum(x=>(long)x)",
    "IdealBody": "                // A.B(GroupBy 1パス件数集計) + B.C(Whereフィルタ) + C.D(Sum直接加算)\n                var counts=new Dictionary<int,int>(16);\n                for(var i=0;i<raw.Length;i++){\n                    var k=raw[i]&15;\n                    if(counts.TryGetValue(k,out var c)){\n                        counts[k]=c+1;\n                    }else{\n                        counts[k]=1;\n                    }\n                }\n                var sum=0L;\n                foreach(var kv in counts){\n                    var val=kv.Key*10+kv.Value;\n                    if((val&1)==0){\n                        sum+=val;\n                    }\n                }\n                return sum;",
    "ValueType": "Long",
    "Cardinality": "Scalar",
    "OriginalSHA256": "4b914b3315b34dc4f62fed85c37d1f7a933fdace66eb49e5ba7d5f202252571f"
  },
