    ],
    "Expression": "source.GroupBy(x=>x&15,x=>x).Select(g=>g.Key+g.Sum()).OrderByDescending(x=>x&31).Take(12).ToArray()",
    "IdealBody": "                // A.B(GroupBy 1パス集計) + B.C(OrderByDescending直接転送) + C.D(Take Top-K抽出)\n                var dict=new Dictionary<int,int>(16);\n                var order=new List<int>(16);\n                for(var i=0;i<raw.Length;i++){\n                    var x=raw[i];\n                    var k=x&15;\n                    if(dict.TryGetValue(k,out var cur)){\n                        dict[k]=cur+x;\n                    }else{\n                        dict[k]=x;\n                        order.Add(k);\n                    }\n                }\n                var items=new int[order.Count];\n                for(var i=0;i<order.Count;i++){\n                    var k=order[i];\n                    items[i]=k+dict[k];\n                }\n                return items.OrderByDescending(x=>x&31).Take(12).ToArray();",
    "ValueType": "Int",
    "Cardinality": "Sequence",
    "OriginalSHA256": "4b914b3315b34dc4f62fed85c37d1f7a933fdace66eb49e5ba7d5f202252571f"
  },
