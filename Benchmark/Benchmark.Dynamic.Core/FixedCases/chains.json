    "IdealBody": "                // A.B(Where->Select) + B.C(Select->Take) + C.D(Take->ToArray) => 最大12件で即時breakする単一ループ\n                var buf=new List<int>(12);\n                for(var i=0;i<raw.Length;i++){\n                    var x=raw[i];\n                    if((x&1)==0){\n                        buf.Add(x*3+1);\n                        if(buf.Count>=12){\n                            break;\n                        }\n                    }\n                }\n                return buf.ToArray();",
