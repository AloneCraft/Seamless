    "Expression": "source.OrderBy(x=>x&31).Where(x=>(x&1)==0).Select(x=>x*3+1).FirstOrDefault()",
    "IdealBody": "                // A.B(OrderBy->Where Pushdown) + B.C(Where->Select) + C.D(Select->FirstOrDefault) => 偶数のみから最小キー要素を1パス選択\n                var found=false;\n                var bestVal=0;\n                var bestKey=int.MaxValue;\n                for(var i=0;i<raw.Length;i++){\n                    var x=raw[i];\n                    if((x&1)==0){\n                        var k=x&31;\n                        if(!found||k<bestKey){\n                            found=true;\n                            bestKey=k;\n                            bestVal=x*3+1;\n                        }\n                    }\n                }\n                if(found){\n                    return bestVal;\n                }else{\n                    return 0;\n                }",
    "ValueType": "Int",
    "Cardinality": "Scalar",
    "OriginalSHA256": "4b914b3315b34dc4f62fed85c37d1f7a933fdace66eb49e5ba7d5f202252571f"
