    "Expression": "source.Reverse().Where(x=>(x&1)==0).Select(x=>x*3+1).Take(12).ToArray()",
    "IdealBody": "                // A.B(Reverse逆順走査) + B.C(Where) + C.D(Select->Take) => 末尾から逆順forループで最大12件収集\n                var list=new List<int>(12);\n                for(var i=raw.Length-1;i>=0;i--){\n                    var x=raw[i];\n                    if((x&1)==0){\n                        list.Add(x*3+1);\n                        if(list.Count>=12){\n                            break;\n                        }\n                    }\n                }\n                return list.ToArray();",
