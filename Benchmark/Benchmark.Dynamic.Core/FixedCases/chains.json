    "IdealBody": "                // A.B(Distinct<-Where Pushdown) + B.C(Select) + C.D(Count) => 偶数のみHashSet投入して件数取得\n                var set=new HashSet<int>();\n                for(var i=0;i<raw.Length;i++){\n                    var x=raw[i];\n                    if((x&1)==0){\n                        set.Add(x);\n                    }\n                }\n                return set.Count;",
