<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Benchmark.Dynamic.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="DynamicBackground">#F4F7FB</Color>
            <Color x:Key="DynamicPanel">#FFFFFF</Color>
            <Color x:Key="DynamicBorder">#CBD5E1</Color>
            <Color x:Key="DynamicText">#1E293B</Color>
            <Color x:Key="DynamicAccent">#2563EB</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
