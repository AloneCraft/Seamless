<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Benchmark.Dynamic</RootNamespace>
    <AssemblyName>Benchmark.Dynamic</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ApplicationTitle>Seamless Dynamic Benchmark</ApplicationTitle>
    <ApplicationId>com.seamless.benchmark.dynamic</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Syncfusion.Maui.Buttons" Version="33.2.15" />
    <PackageReference Include="Syncfusion.Maui.DataGrid" Version="33.2.15" />
    <PackageReference Include="Syncfusion.Licensing" Version="33.2.15" />
    <PackageReference Include="Syncfusion.Maui.Toolkit" Version="1.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Benchmark.Dynamic.Core\Benchmark.Dynamic.Core.csproj" />
    <ProjectReference Include="..\Benchmark.Dynamic.Infrastructure\Benchmark.Dynamic.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="CopyBenchmarkDynamicWorker" AfterTargets="Build" Condition="'$(IsCrossTargetingBuild)'!='true' and '$(TargetDir)'!='' and '$(SkipBenchmarkDynamicWorkerBuild)'!='true'">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\Benchmark.Dynamic.Worker\Benchmark.Dynamic.Worker.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=net10.0" />
    <ItemGroup>
      <_BenchmarkDynamicWorkerFiles Include="$(MSBuildProjectDirectory)\..\Benchmark.Dynamic.Worker\bin\$(Configuration)\net10.0\*.exe" />
      <_BenchmarkDynamicWorkerFiles Include="$(MSBuildProjectDirectory)\..\Benchmark.Dynamic.Worker\bin\$(Configuration)\net10.0\*.dll" />
      <_BenchmarkDynamicWorkerFiles Include="$(MSBuildProjectDirectory)\..\Benchmark.Dynamic.Worker\bin\$(Configuration)\net10.0\*.json" />
      <_BenchmarkDynamicWorkerFiles Include="$(MSBuildProjectDirectory)\..\Benchmark.Dynamic.Worker\bin\$(Configuration)\net10.0\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_BenchmarkDynamicWorkerFiles)" DestinationFolder="$(TargetDir)DynamicWorker" SkipUnchangedFiles="true" Condition="'@(_BenchmarkDynamicWorkerFiles)'!=''" />
  </Target>
</Project>
