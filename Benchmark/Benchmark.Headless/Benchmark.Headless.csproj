<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'==''">win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Benchmark.UI\Benchmark.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Manifests/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Benchmark.Headless.Tests" />
  </ItemGroup>
  <Target Name="CopyBenchmarkWorkerHost" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\Worker\Worker.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=net10.0" />
    <ItemGroup>
      <_WorkerFiles Include="$(MSBuildProjectDirectory)\..\Worker\bin\$(Configuration)\net10.0\Worker.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WorkerFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyBenchmarkAotWorkerHost" AfterTargets="Build">
    <PropertyGroup>
      <_BenchmarkAotWorkerSourceDir>$(MSBuildProjectDirectory)\..\Benchmark.UI\bin\$(Configuration)\net10.0-windows\win-x64\AOTWorker\</_BenchmarkAotWorkerSourceDir>
      <_BenchmarkAotWorkerTargetDir>$(TargetDir)AOTWorker\</_BenchmarkAotWorkerTargetDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(_BenchmarkAotWorkerSourceDir)Worker.Aot.exe')" Text="Benchmark.UIの完全なAOTWorker publish成果物がありません。" />
    <ItemGroup>
      <_BenchmarkAotWorkerFiles Include="$(_BenchmarkAotWorkerSourceDir)**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(_BenchmarkAotWorkerTargetDir)" />
    <Copy SourceFiles="@(_BenchmarkAotWorkerFiles)" DestinationFiles="@(_BenchmarkAotWorkerFiles->'$(_BenchmarkAotWorkerTargetDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
  </Target>
</Project>
