<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <Features>InterceptorsPreview</Features>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Intercept</InterceptorsPreviewNamespaces>
    <PlatformTarget>x64</PlatformTarget>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'==''">win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Benchmark.Infrastructure.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/UI/LinqInterceptAssembly.cs" Link="Shared\LinqInterceptAssembly.cs" />
    <Compile Include="../Shared/UI/BenchmarkAppProfile.cs" Link="Shared\BenchmarkAppProfile.cs" />
    <Compile Include="../Shared/UI/BenchmarkWorkerClient.cs" Link="Shared\BenchmarkWorkerClient.cs" />
    <Compile Include="../Shared/UI/BenchmarkRunnerServices.cs" Link="Shared\BenchmarkRunnerServices.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Shared/UI.Storage/UI.Storage.csproj" />
    <ProjectReference Include="../../Seamless/Database/Database.csproj" />
    <ProjectReference Include="../../Seamless/FLinq/Generator/Compiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Benchmark.System.Linq.Enumerable.FLinq/Benchmark.System.Linq.Enumerable.FLinq.csproj" />
    <ProjectReference Include="../Benchmark.System.Linq.Enumerable.ZLinq/Benchmark.System.Linq.Enumerable.ZLinq.csproj" />
    <ProjectReference Include="../Benchmark.System.Linq.Enumerable.IEnumerable.FLinq/Benchmark.System.Linq.Enumerable.IEnumerable.FLinq.csproj" />
    <ProjectReference Include="../Benchmark.System.Linq.Enumerable.IEnumerable.ZLinq/Benchmark.System.Linq.Enumerable.IEnumerable.ZLinq.csproj" />
    <ProjectReference Include="../Benchmark.Optimization.All/Benchmark.Optimization.All.csproj" />
    <ProjectReference Include="../Benchmark.Optimization.NoRewrite/Benchmark.Optimization.NoRewrite.csproj" />
    <ProjectReference Include="../Benchmark.Optimization.NoPipelineFusion/Benchmark.Optimization.NoPipelineFusion.csproj" />
    <ProjectReference Include="../Benchmark.Optimization.NoPredicatePushdown/Benchmark.Optimization.NoPredicatePushdown.csproj" />
    <ProjectReference Include="../Benchmark.Optimization.NoProjectionMerge/Benchmark.Optimization.NoProjectionMerge.csproj" />
    <ProjectReference Include="../Benchmark.System.Linq.Enumerable.Range.FLinq/Benchmark.System.Linq.Enumerable.Range.FLinq.csproj" />
    <ProjectReference Include="../Benchmark.System.Linq.Enumerable.Range.ZLinq/Benchmark.System.Linq.Enumerable.Range.ZLinq.csproj" />
    <ProjectReference Include="../Benchmark.System.Linq.Enumerable.List.FLinq/Benchmark.System.Linq.Enumerable.List.FLinq.csproj" />
    <ProjectReference Include="../Benchmark.System.Linq.Enumerable.List.ZLinq/Benchmark.System.Linq.Enumerable.List.ZLinq.csproj" />
    <ProjectReference Include="../Benchmark.System.Linq.Enumerable.Ideal/Benchmark.System.Linq.Enumerable.Ideal.csproj" />
    <ProjectReference Include="../Benchmark.System.Linq.Enumerable.List.Ideal/Benchmark.System.Linq.Enumerable.List.Ideal.csproj" />
    <ProjectReference Include="../Benchmark.System.Linq.Enumerable.IEnumerable.Ideal/Benchmark.System.Linq.Enumerable.IEnumerable.Ideal.csproj" />
    <ProjectReference Include="../Benchmark.System.Linq.Enumerable.Range.Ideal/Benchmark.System.Linq.Enumerable.Range.Ideal.csproj" />
    <ProjectReference Include="../Benchmark.Optimization.Ideal/Benchmark.Optimization.Ideal.csproj" />
    <ProjectReference Include="../Benchmark.Persisted.Linq.Enumerable.FLinq/Benchmark.Persisted.Linq.Enumerable.FLinq.csproj" />
    <ProjectReference Include="../Benchmark.Persisted.Linq.Enumerable.IEnumerable.FLinq/Benchmark.Persisted.Linq.Enumerable.IEnumerable.FLinq.csproj" />
    <ProjectReference Include="../Benchmark.Persisted.Linq.Enumerable.Linq/Benchmark.Persisted.Linq.Enumerable.Linq.csproj" />
    <ProjectReference Include="../Benchmark.Persisted.Linq.Enumerable.ValueLinq/Benchmark.Persisted.Linq.Enumerable.ValueLinq.csproj" />
    <ProjectReference Include="../Benchmark.Tsavorite.Linq.Enumerable.FLinq/Benchmark.Tsavorite.Linq.Enumerable.FLinq.csproj" />
    <ProjectReference Include="../Benchmark.Tsavorite.Linq.Enumerable.IEnumerable.FLinq/Benchmark.Tsavorite.Linq.Enumerable.IEnumerable.FLinq.csproj" />
    <ProjectReference Include="../Benchmark.Tsavorite.Linq.Enumerable.Linq/Benchmark.Tsavorite.Linq.Enumerable.Linq.csproj" />
    <ProjectReference Include="../Benchmark.Tsavorite.Linq.Enumerable.ValueLinq/Benchmark.Tsavorite.Linq.Enumerable.ValueLinq.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Worker/Worker.csproj" ReferenceOutputAssembly="false" OutputItemType="BenchmarkWorkerOutput" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>
  <ItemGroup>
    <UpToDateCheckBuilt Include="$(TargetDir)Worker.dll" Original="$(MSBuildProjectDirectory)\..\Worker\bin\$(Configuration)\net10.0\Worker.dll" />
    <UpToDateCheckBuilt Include="$(TargetDir)Worker.exe" Original="$(MSBuildProjectDirectory)\..\Worker\bin\$(Configuration)\net10.0\Worker.exe" />
    <UpToDateCheckBuilt Include="$(TargetDir)Worker.deps.json" Original="$(MSBuildProjectDirectory)\..\Worker\bin\$(Configuration)\net10.0\Worker.deps.json" />
    <UpToDateCheckBuilt Include="$(TargetDir)Worker.runtimeconfig.json" Original="$(MSBuildProjectDirectory)\..\Worker\bin\$(Configuration)\net10.0\Worker.runtimeconfig.json" />
  </ItemGroup>
  <Target Name="CopyBenchmarkWorkerHost" AfterTargets="Build">
    <PropertyGroup>
      <_BenchmarkWorkerDirectory>@(BenchmarkWorkerOutput-&gt;'%(RootDir)%(Directory)')</_BenchmarkWorkerDirectory>
    </PropertyGroup>
    <Error Condition="'$(_BenchmarkWorkerDirectory)' == ''" Text="Worker の出力先を解決できませんでした。Worker.csproj への ProjectReference を確認してください。" />
    <ItemGroup>
      <_WorkerFiles Include="$(_BenchmarkWorkerDirectory)Worker.exe;$(_BenchmarkWorkerDirectory)Worker.dll;$(_BenchmarkWorkerDirectory)Worker.deps.json;$(_BenchmarkWorkerDirectory)Worker.runtimeconfig.json;$(_BenchmarkWorkerDirectory)Worker.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_WorkerFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
  </Target>
  <Import Project="../../Shared/UI.Core/UI.Core.projitems" Label="Shared" />
  <PropertyGroup>
    <SeamlessLinqAnalysis>false</SeamlessLinqAnalysis>
  </PropertyGroup>
</Project>
