<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Benchmark.Infrastructure/Benchmark.Infrastructure.csproj" />
    <ProjectReference Include="../../Seamless/Runtime.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.*" />
    <PackageReference Include="Microsoft.Garnet" Version="[2.2.8]" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Tests/Seamless.TestKit/Seamless.TestKit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Seamless/Tsavorite/Core/Tsavorite.Core.csproj" />
    <Reference Include="Garnet.common">
      <HintPath>$(PkgMicrosoft_Garnet)/lib/net10.0/Garnet.common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Tsavorite.devices.AzureStorageDevice">
      <HintPath>$(PkgMicrosoft_Garnet)/lib/net10.0/Tsavorite.devices.AzureStorageDevice.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Import Project="../../Seamless/Tsavorite/Core/buildTransitive/Seamless.Tsavorite.Core.targets" />
</Project>
