<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Benchmark.Scalable.Tests</RootNamespace>
    <AssemblyName>Benchmark.Scalable.Tests</AssemblyName>
    <LangVersion>preview</LangVersion>
    <DefineConstants>$(DefineConstants);BENCH_AS_TEST</DefineConstants>
    <NoWarn>$(NoWarn);BDN1400</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Benchmark.Scalable.UI/ScalableRunService.cs" Link="UI/ScalableRunService.cs" />
    <Compile Include="../Benchmark.Scalable.UI/ScalableApplicationSettings.cs" Link="UI/ScalableApplicationSettings.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <ProjectReference Include="../Benchmark.Scalable.Core/Benchmark.Scalable.Core.csproj" />
    <ProjectReference Include="../../Seamless/Seamless.csproj" />
    <ProjectReference Include="../../Tests/Seamless.TestKit/Seamless.TestKit.csproj" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="MemoryPack" Version="1.*" />
    <PackageReference Include="Microsoft.Garnet" Version="2.2.8" />
    <PackageReference Include="ZLinq" Version="1.5.6" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" PrivateAssets="all" />
    <Using Include="Common" />
    <Using Include="BenchmarkDotNet.Attributes" />
    <Using Include="Seamless.Collections" />
    <Using Include="Seamless.Collections.Tsavorite" />
    <Using Include="Seamless.TestKit" />
    <Using Include="Xunit" />
    <Using Include="ZLinq" />
  </ItemGroup>
  <Import Project="../../Shared/Scalable.Persisted.Collections/Scalable.Persisted.Collections.projitems" Label="Shared" />
  <Import Project="../../Shared/Scalable.Tsavorite.Collections/Scalable.Tsavorite.Collections.projitems" Label="Shared" />
</Project>
