<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <RootNamespace>Benchmark.Scalable.Tsavorite.Collections</RootNamespace>
    <AssemblyName>Benchmark.Scalable.Tsavorite.Collections</AssemblyName>
    <NoWarn>$(NoWarn);BDN1400</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="MemoryPack" Version="1.*" />
    <PackageReference Include="Microsoft.Garnet" Version="[2.2.1]" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="ZLinq" Version="1.5.6" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="BenchmarkDotNet.Attributes" />
    <Using Include="BenchmarkDotNet.Configs" />
    <Using Include="BenchmarkDotNet.Engines" />
    <Using Include="Common" />
    <Using Include="Seamless.Collections" />
    <Using Include="Seamless.TestKit" />
    <Using Include="Seamless.Collections.Tsavorite" />
    <Using Include="ZLinq" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Seamless\Seamless.csproj" />
    <ProjectReference Include="..\..\Tests\Seamless.TestKit\Seamless.TestKit.csproj" />
  </ItemGroup>
  <Import Project="..\..\Shared\Scalable.Tsavorite.Collections\Scalable.Tsavorite.Collections.projitems" Label="Shared" />
  <!-- 元packageはsupport DLLの取得専用。Coreは修正済みprojectを公開参照する。 -->
  <ItemGroup>
    <ProjectReference Include="../../Seamless.Tsavorite.Core/Seamless.Tsavorite.Core.csproj" />
    <Reference Include="Garnet.common">
      <HintPath>$(PkgMicrosoft_Garnet)/lib/net10.0/Garnet.common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Tsavorite.devices.AzureStorageDevice">
      <HintPath>$(PkgMicrosoft_Garnet)/lib/net10.0/Tsavorite.devices.AzureStorageDevice.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Import Project="../../Seamless.Tsavorite.Core/buildTransitive/Seamless.Tsavorite.Core.targets" />
</Project>
