<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RootNamespace>Benchmark.Tpc.Core</RootNamespace>
    <AssemblyName>Benchmark.Tpc.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Artifacts/**;Work/**" />
    <None Remove="Artifacts/**;Work/**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Benchmark.Tpc.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.*" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Seamless/Database/Database.csproj" />
  </ItemGroup>
</Project>
