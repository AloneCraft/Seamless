  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="ZLinq" Version="1.5.6" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="BenchmarkDotNet.Attributes" />
    <Using Include="BenchmarkDotNet.Configs" />
    <Using Include="BenchmarkDotNet.Engines" />
    <Using Include="Common" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Seamless\Seamless.csproj" />
  </ItemGroup>
  <Import Project="..\..\Shared\Linq.Enumerable\Linq.Enumerable.projitems" Label="Shared" />
