<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(TargetFrameworks);net10.0-maccatalyst</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <OutputType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">WinExe</OutputType>
    <RootNamespace>Benchmark.UI</RootNamespace>
    <AssemblyName>Benchmark.UI</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <DefineConstants>$(DefineConstants);BENCHMARK_UI_TYPED_CATALOG</DefineConstants>
    <ApplicationTitle>Seamless Benchmark</ApplicationTitle>
    <ApplicationId>com.seamless.benchmark</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.19041.0</TargetPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Syncfusion.Maui.Buttons" Version="33.2.15" />
    <PackageReference Include="Syncfusion.Maui.DataGrid" Version="33.2.15" />
    <PackageReference Include="Syncfusion.Licensing" Version="33.2.15" />
    <PackageReference Include="Syncfusion.Maui.Toolkit" Version="1.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Seamless.FLinq\Seamless.FLinq.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net10.0" />
    <ProjectReference Include="..\..\Shared\UI.Storage\UI.Storage.csproj" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.FLinq\Benchmark.System.Linq.Enumerable.FLinq.csproj" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.Linq\Benchmark.System.Linq.Enumerable.Linq.csproj" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.ZLinq\Benchmark.System.Linq.Enumerable.ZLinq.csproj" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.IEnumerable.FLinq\Benchmark.System.Linq.Enumerable.IEnumerable.FLinq.csproj" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.IEnumerable.Linq\Benchmark.System.Linq.Enumerable.IEnumerable.Linq.csproj" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.IEnumerable.ZLinq\Benchmark.System.Linq.Enumerable.IEnumerable.ZLinq.csproj" />
    <ProjectReference Include="..\Benchmark.Optimization.All\Benchmark.Optimization.All.csproj" />
    <ProjectReference Include="..\Benchmark.Optimization.NoRewrite\Benchmark.Optimization.NoRewrite.csproj" />
    <ProjectReference Include="..\Benchmark.Optimization.NoPipelineFusion\Benchmark.Optimization.NoPipelineFusion.csproj" />
    <ProjectReference Include="..\Benchmark.Optimization.NoPredicatePushdown\Benchmark.Optimization.NoPredicatePushdown.csproj" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.Range.FLinq\Benchmark.System.Linq.Enumerable.Range.FLinq.csproj" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.Range.Linq\Benchmark.System.Linq.Enumerable.Range.Linq.csproj" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.Range.ZLinq\Benchmark.System.Linq.Enumerable.Range.ZLinq.csproj" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.List.FLinq\Benchmark.System.Linq.Enumerable.List.FLinq.csproj" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.List.Linq\Benchmark.System.Linq.Enumerable.List.Linq.csproj" />
    <ProjectReference Include="..\Benchmark.System.Linq.Enumerable.List.ZLinq\Benchmark.System.Linq.Enumerable.List.ZLinq.csproj" />
    <ProjectReference Include="..\Benchmark.Persisted.Linq.Enumerable.FLinq\Benchmark.Persisted.Linq.Enumerable.FLinq.csproj" />
    <ProjectReference Include="..\Benchmark.Persisted.Linq.Enumerable.Linq\Benchmark.Persisted.Linq.Enumerable.Linq.csproj" />
    <ProjectReference Include="..\Benchmark.Persisted.Linq.Enumerable.ValueLinq\Benchmark.Persisted.Linq.Enumerable.ValueLinq.csproj" />
    <ProjectReference Include="..\Benchmark.Tsavorite.Linq.Enumerable.FLinq\Benchmark.Tsavorite.Linq.Enumerable.FLinq.csproj" />
    <ProjectReference Include="..\Benchmark.Tsavorite.Linq.Enumerable.Linq\Benchmark.Tsavorite.Linq.Enumerable.Linq.csproj" />
    <ProjectReference Include="..\Benchmark.Tsavorite.Linq.Enumerable.ValueLinq\Benchmark.Tsavorite.Linq.Enumerable.ValueLinq.csproj" />
    <ProjectReference Include="..\Benchmark.Persisted.Collections\Benchmark.Persisted.Collections.csproj" />
    <ProjectReference Include="..\Benchmark.Tsavorite.Collections\Benchmark.Tsavorite.Collections.csproj" />
  </ItemGroup>

  <Target Name="CopyBenchmarkWorkerHost" AfterTargets="Build" Condition="'$(IsCrossTargetingBuild)' != 'true' and '$(TargetDir)' != ''">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\Worker\Worker.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=net10.0" />

    <ItemGroup>
      <_BenchmarkWorkerFiles Include="$(MSBuildProjectDirectory)\..\Worker\bin\$(Configuration)\net10.0\Worker.exe" Condition="Exists('$(MSBuildProjectDirectory)\..\Worker\bin\$(Configuration)\net10.0\Worker.exe')" />
      <_BenchmarkWorkerFiles Include="$(MSBuildProjectDirectory)\..\Worker\bin\$(Configuration)\net10.0\Worker.dll" Condition="Exists('$(MSBuildProjectDirectory)\..\Worker\bin\$(Configuration)\net10.0\Worker.dll')" />
      <_BenchmarkWorkerFiles Include="$(MSBuildProjectDirectory)\..\Worker\bin\$(Configuration)\net10.0\Worker.deps.json" Condition="Exists('$(MSBuildProjectDirectory)\..\Worker\bin\$(Configuration)\net10.0\Worker.deps.json')" />
      <_BenchmarkWorkerFiles Include="$(MSBuildProjectDirectory)\..\Worker\bin\$(Configuration)\net10.0\Worker.runtimeconfig.json" Condition="Exists('$(MSBuildProjectDirectory)\..\Worker\bin\$(Configuration)\net10.0\Worker.runtimeconfig.json')" />
      <_BenchmarkWorkerFiles Include="$(MSBuildProjectDirectory)\..\Worker\bin\$(Configuration)\net10.0\Worker.pdb" Condition="Exists('$(MSBuildProjectDirectory)\..\Worker\bin\$(Configuration)\net10.0\Worker.pdb')" />
    </ItemGroup>

    <Copy SourceFiles="@(_BenchmarkWorkerFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'@(_BenchmarkWorkerFiles)' != ''" />
  </Target>

  <Import Project="..\Shared\UI\UI.projitems" Label="Shared" />
</Project>
