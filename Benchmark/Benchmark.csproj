<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(TargetFrameworks);net10.0-maccatalyst</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Benchmark</RootNamespace>
    <AssemblyName>Benchmark</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ApplicationTitle>Seamless Benchmark</ApplicationTitle>
    <ApplicationId>com.seamless.benchmark</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1F2937" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Syncfusion.Maui.DataGrid" Version="33.2.15" />
    <PackageReference Include="Syncfusion.Licensing" Version="33.2.15" />
    <PackageReference Include="Syncfusion.Maui.Toolkit" Version="1.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Benchmark.Worker\Benchmark.Worker.csproj" />
    <ProjectReference Include="..\Benchmark.DotNet.Linq.Enumerable.FLinq\Benchmark.DotNet.Linq.Enumerable.FLinq.csproj" />
    <ProjectReference Include="..\Benchmark.DotNet.Linq.Enumerable.ZLinq\Benchmark.DotNet.Linq.Enumerable.ZLinq.csproj" />
    <ProjectReference Include="..\Benchmark.Tsavorite.Linq.Enumerable.Linq\Benchmark.Tsavorite.Linq.Enumerable.Linq.csproj" />
    <ProjectReference Include="..\Benchmark.Tsavorite.Linq.Enumerable.FLinq\Benchmark.Tsavorite.Linq.Enumerable.FLinq.csproj" />
    <ProjectReference Include="..\Benchmark.Persisted.Linq.Enumerable.Linq\Benchmark.Persisted.Linq.Enumerable.Linq.csproj" />
    <ProjectReference Include="..\Benchmark.Persisted.Linq.Enumerable.FLinq\Benchmark.Persisted.Linq.Enumerable.FLinq.csproj" />
    <ProjectReference Include="..\Benchmark.Persisted.Collection\Benchmark.Persisted.Collection.csproj" />
    <ProjectReference Include="..\Benchmark.Tsavorite.Collection\Benchmark.Tsavorite.Collection.csproj" />
  </ItemGroup>

  <Target Name="CopyBenchmarkWorkerHost" AfterTargets="Build" Condition="'$(IsCrossTargetingBuild)' != 'true' and '$(TargetDir)' != ''">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\Benchmark.Worker\Benchmark.Worker.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=net10.0" />

    <ItemGroup>
      <_BenchmarkWorkerFiles Include="$(MSBuildProjectDirectory)\..\Benchmark.Worker\bin\$(Configuration)\net10.0\Benchmark.Worker.exe" Condition="Exists('$(MSBuildProjectDirectory)\..\Benchmark.Worker\bin\$(Configuration)\net10.0\Benchmark.Worker.exe')" />
      <_BenchmarkWorkerFiles Include="$(MSBuildProjectDirectory)\..\Benchmark.Worker\bin\$(Configuration)\net10.0\Benchmark.Worker.dll" Condition="Exists('$(MSBuildProjectDirectory)\..\Benchmark.Worker\bin\$(Configuration)\net10.0\Benchmark.Worker.dll')" />
      <_BenchmarkWorkerFiles Include="$(MSBuildProjectDirectory)\..\Benchmark.Worker\bin\$(Configuration)\net10.0\Benchmark.Worker.deps.json" Condition="Exists('$(MSBuildProjectDirectory)\..\Benchmark.Worker\bin\$(Configuration)\net10.0\Benchmark.Worker.deps.json')" />
      <_BenchmarkWorkerFiles Include="$(MSBuildProjectDirectory)\..\Benchmark.Worker\bin\$(Configuration)\net10.0\Benchmark.Worker.runtimeconfig.json" Condition="Exists('$(MSBuildProjectDirectory)\..\Benchmark.Worker\bin\$(Configuration)\net10.0\Benchmark.Worker.runtimeconfig.json')" />
      <_BenchmarkWorkerFiles Include="$(MSBuildProjectDirectory)\..\Benchmark.Worker\bin\$(Configuration)\net10.0\Benchmark.Worker.pdb" Condition="Exists('$(MSBuildProjectDirectory)\..\Benchmark.Worker\bin\$(Configuration)\net10.0\Benchmark.Worker.pdb')" />
    </ItemGroup>

    <Copy SourceFiles="@(_BenchmarkWorkerFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'@(_BenchmarkWorkerFiles)' != ''" />
  </Target>
</Project>
