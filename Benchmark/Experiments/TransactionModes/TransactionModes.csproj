<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><LangVersion>14</LangVersion>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks><IsPackable>false</IsPackable>
    <Features>InterceptorsPreview</Features><InterceptorsNamespaces>$(InterceptorsNamespaces);Intercept</InterceptorsNamespaces>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Intercept</InterceptorsPreviewNamespaces>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles><CompilerGeneratedFilesOutputPath>$(MSBuildProjectDirectory)/obj/$(Configuration)/generated</CompilerGeneratedFilesOutputPath>
    <WarningsAsErrors>$(WarningsAsErrors);FLINQ001;FLINQ002</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Seamless.Linq/Seamless.Linq.csproj" />
    <ProjectReference Include="../../../Seamless.Transactions/Seamless.Transactions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 試験用のWAL装置は製品のアセンブリから試験側へ移した。この実験も同じファイルを使う。 -->
    <Compile Include="../../../Tests/Seamless.Transactions.Tests/FakeWalDevice.cs" Link="FakeWalDevice.cs" />
    <ProjectReference Include="../../../Seamless.FLinq.Generator/Seamless.FLinq.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- 試作が Garnet.common の型を直接使う。元packageはsupport DLLの取得専用。Coreは修正済みprojectを参照する。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Garnet" Version="[2.2.8]" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
    <ProjectReference Include="../../../Seamless.Tsavorite.Core/Seamless.Tsavorite.Core.csproj" />
    <Reference Include="Garnet.common">
      <HintPath>$(PkgMicrosoft_Garnet)/lib/net10.0/Garnet.common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Tsavorite.devices.AzureStorageDevice">
      <HintPath>$(PkgMicrosoft_Garnet)/lib/net10.0/Tsavorite.devices.AzureStorageDevice.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Import Project="../../../Seamless.Tsavorite.Core/buildTransitive/Seamless.Tsavorite.Core.targets" />
</Project>
