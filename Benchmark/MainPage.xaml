<?xml version="1.0" encoding="utf-8" ?>
<!--
    この XAML は、画面の「変わりにくい外枠」だけを定義する。
    MAUI では XAML に Binding やテンプレートまで書けるが、この画面は Syncfusion DataGrid の動的列が多い。
    そのため、Binding・DataTemplate・列生成・クリック処理は C# に残し、XAML は AI と人間が画面構造を眺めやすい骨格に限定する。
-->
<ContentPage
    x:Class="Benchmark.Benchmarkページ"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Seamless Benchmark"
    BackgroundColor="#F8FAFC">

    <!--
        画面全体を「ツールバー」と「作業領域」の 2 行に分ける。
        RowDefinitions を XAML に置くと、C# の UI 生成コードを読まなくても画面の大枠が分かる。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- 1 行目はボタンや Picker の高さに合わせる。 -->
            <RowDefinition Height="Auto" />
            <!-- 2 行目は残りの高さを Benchmark グリッドと分析ペインで使う。 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            ツールバーの差し込み先。
            x:Name を付けると、XAML コンパイル時に code-behind 側へ同名フィールドが生成される。
            ここでは C# から this.ツールバー表示先.Content に実体を入れる。
        -->
        <ContentView x:Name="ツールバー表示先" />

        <!--
            メイン領域は左右 2 分割にする。
            ColumnDefinitions は固定デザインなので XAML に置き、比率や余白の意図を見た目の近くに残す。
        -->
        <Grid
            Grid.Row="1"
            ColumnSpacing="1"
            BackgroundColor="#CBD5E1">
            <Grid.ColumnDefinitions>
                <!-- 左側は Benchmark の表。既存画面の比率を保つため 0.56* にしている。 -->
                <ColumnDefinition Width="0.56*" />
                <!-- 右側は CPU 選択、Chart、結果一覧などの分析領域。 -->
                <ColumnDefinition Width="0.44*" />
            </Grid.ColumnDefinitions>

            <!--
                Benchmark グリッド側の外枠。
                SfDataGrid 本体は動的列・StackedHeaderRows・選択ジェスチャを持つため C# で生成する。
            -->
            <Grid
                Padding="8"
                RowSpacing="4"
                BackgroundColor="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Label
                    Text="Benchmark"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#0F172A" />

                <!--
                    Benchmark DataGrid の差し込み先。
                    MappingName など Syncfusion が string を要求する箇所は、C# の nameof と helper で管理する。
                -->
                <ContentView
                    x:Name="Benchmark表示先"
                    Grid.Row="1" />
            </Grid>

            <!--
                分析側の外枠。
                CPU 構成や Chart series は実行環境・選択状態で変わるため、内側は C# が組み立てる。
            -->
            <Grid
                Grid.Column="1"
                Padding="8"
                RowSpacing="4"
                BackgroundColor="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Label
                    Text="分析"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#0F172A" />

                <!--
                    右ペインの差し込み先。
                    タブ、CPU 表、Chart、結果一覧は Binding と動的生成が絡むため C# 側に残す。
                -->
                <ContentView
                    x:Name="分析表示先"
                    Grid.Row="1" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
