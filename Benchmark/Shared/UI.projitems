<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>{9A75284D-0FA1-40D3-A0D4-81DF6C571B36}</SharedGUID>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\..\Shared\UI.Core.projitems" />
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)UI\*.cs" />
    <MauiXaml Include="$(MSBuildThisFileDirectory)UI\App.xaml" Link="App.xaml" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Compile Include="$(MSBuildThisFileDirectory)UI\Platforms\Windows\*.cs" Link="Platforms\Windows\%(Filename)%(Extension)" />
    <ApplicationDefinition Include="$(MSBuildThisFileDirectory)UI\Platforms\Windows\App.xaml" Link="Platforms\Windows\App.xaml" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <Compile Include="$(MSBuildThisFileDirectory)UI\Platforms\MacCatalyst\*.cs" Link="Platforms\MacCatalyst\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon Include="$(MSBuildThisFileDirectory)UI\Resources\AppIcon\appicon.svg" Link="Resources\AppIcon\appicon.svg" />
    <MauiSplashScreen Include="$(MSBuildThisFileDirectory)UI\Resources\Splash\splash.svg" Link="Resources\Splash\splash.svg" Color="#1F2937" BaseSize="128,128" />
    <MauiImage Include="$(MSBuildThisFileDirectory)UI\Resources\Images\*.svg" Link="Resources\Images\%(Filename)%(Extension)" BaseSize="24,24" />
  </ItemGroup>
</Project>