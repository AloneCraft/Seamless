<Project>
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
  </PropertyGroup>

  <!-- NuGet 共通メタデータ。公開する 8 プロジェクトだけが IsPackable=true で上書きする。 -->
  <PropertyGroup>
    <Version>0.0.0</Version>
    <Authors>KazuhiroNomura</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/KazuhiroNomura/Seamless</PackageProjectUrl>
    <RepositoryUrl>https://github.com/KazuhiroNomura/Seamless</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectFile)'=='Benchmark.UI.csproj' Or '$(MSBuildProjectFile)'=='Benchmark.UI.UITests.csproj' Or '$(MSBuildProjectFile)'=='Benchmark.Dynamic.csproj' Or '$(MSBuildProjectFile)'=='Benchmark.Dynamic.Tests.csproj' Or '$(MSBuildProjectFile)'=='Benchmark.Dynamic.UITests.csproj' Or '$(MSBuildProjectFile)'=='Benchmark.Scalable.UI.csproj' Or '$(MSBuildProjectFile)'=='Benchmark.Tsavorite.ParameterSweep.UI.csproj'">
    <TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectFile)'=='Test.csproj' And '$(TargetFramework)'=='net10.0-windows'">
    <TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
  </PropertyGroup>
</Project>
