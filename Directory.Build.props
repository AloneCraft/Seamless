<Project>
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectFile)'=='Benchmark.UI.csproj' Or '$(MSBuildProjectFile)'=='Benchmark.UI.UITests.csproj' Or '$(MSBuildProjectFile)'=='Benchmark.Scalble.UI.csproj' Or '$(MSBuildProjectFile)'=='Tsavorite.ParameterSweep.UI.csproj'">
    <TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectFile)'=='Test.csproj' And '$(TargetFramework)'=='net10.0-windows'">
    <TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
  </PropertyGroup>
</Project>
