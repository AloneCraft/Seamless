<Project>
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('Benchmark.'))">
    <OutputType>Library</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
  </PropertyGroup>

  <PropertyGroup>
    <TsavoriteConfigurationName Condition="'$(TsavoriteConfigurationName)' == ''">$(Configuration)</TsavoriteConfigurationName>

    <TsavoriteTargetFramework Condition="'$(TsavoriteTargetFramework)' == '' and $([System.String]::Copy('$(TsavoriteConfigurationName)').EndsWith('Net8'))">net8.0</TsavoriteTargetFramework>
    <TsavoriteTargetFramework Condition="'$(TsavoriteTargetFramework)' == '' and $([System.String]::Copy('$(TsavoriteConfigurationName)').EndsWith('Net9'))">net9.0</TsavoriteTargetFramework>
    <TsavoriteTargetFramework Condition="'$(TsavoriteTargetFramework)' == '' and $([System.String]::Copy('$(TsavoriteConfigurationName)').EndsWith('Net10'))">net10.0</TsavoriteTargetFramework>
    <TsavoriteTargetFramework Condition="'$(TsavoriteTargetFramework)' == ''">net10.0</TsavoriteTargetFramework>

    <TsavoriteBaseConfiguration Condition="'$(TsavoriteBaseConfiguration)' == '' and $([System.String]::Copy('$(TsavoriteConfigurationName)').EndsWith('Net8'))">$([System.String]::Copy('$(TsavoriteConfigurationName)').Replace('Net8',''))</TsavoriteBaseConfiguration>
    <TsavoriteBaseConfiguration Condition="'$(TsavoriteBaseConfiguration)' == '' and $([System.String]::Copy('$(TsavoriteConfigurationName)').EndsWith('Net9'))">$([System.String]::Copy('$(TsavoriteConfigurationName)').Replace('Net9',''))</TsavoriteBaseConfiguration>
    <TsavoriteBaseConfiguration Condition="'$(TsavoriteBaseConfiguration)' == '' and $([System.String]::Copy('$(TsavoriteConfigurationName)').EndsWith('Net10'))">$([System.String]::Copy('$(TsavoriteConfigurationName)').Replace('Net10',''))</TsavoriteBaseConfiguration>
    <TsavoriteBaseConfiguration Condition="'$(TsavoriteBaseConfiguration)' == ''">$(TsavoriteConfigurationName)</TsavoriteBaseConfiguration>

    <LangVersion Condition="'$(LangVersion)' == '' and '$(TsavoriteTargetFramework)' != 'net10.0'">13.0</LangVersion>
    <NoWarn>CS9107</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TsavoriteBaseConfiguration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="$([System.String]::Copy('$(TsavoriteBaseConfiguration)').StartsWith('Debug')) and '$(TsavoriteBaseConfiguration)' != 'Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TsavoriteBaseConfiguration)' == 'Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="$([System.String]::Copy('$(TsavoriteBaseConfiguration)').StartsWith('Release')) and '$(TsavoriteBaseConfiguration)' != 'Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>
</Project>
