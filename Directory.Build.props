<Project>
  <Import Project="$(MSBuildThisFileDirectory)tools/build/SingleFileCompilation.props" />
  <ItemGroup>
    <CompilerVisibleProperty Include="SeamlessLinqAnalysis" />
    <CompilerVisibleProperty Include="SeamlessFLinqGeneration" />
  </ItemGroup>
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <ShouldUnsetParentConfigurationAndPlatform Condition="'$(ShouldUnsetParentConfigurationAndPlatform)'==''">false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <!-- IDE の共有 DLL は公開済み DB がファイルの指紋で参照する。
       管理画面だけのコミットで、共有ライブラリと生成器の指紋が変わらないようにする。 -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug' And ('$(MSBuildProjectName)'=='Compiler' Or '$(MSBuildProjectName)'=='Generator' Or '$(MSBuildProjectName)'=='Runtime' Or '$(MSBuildProjectName)'=='Database' Or '$(MSBuildProjectName)'=='Client' Or '$(MSBuildProjectName)'=='Tsavorite.Core')">
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- NuGet 共通メタデータ。出荷対象プロジェクトが IsPackable=true で上書きする。 -->
  <PropertyGroup>
    <Version>0.0.0</Version>
    <Authors>AloneCraft</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AloneCraft/Seamless</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AloneCraft/Seamless</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectFile)'=='Benchmark.Dynamic.UI.csproj' Or '$(MSBuildProjectFile)'=='Benchmark.Dynamic.Tests.csproj' Or '$(MSBuildProjectFile)'=='Benchmark.Scalable.UI.csproj'">
    <TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectFile)'=='Benchmark.Infrastructure.Tests.csproj' And '$(TargetFramework)'=='net10.0-windows'">
    <TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
  </PropertyGroup>
</Project>
