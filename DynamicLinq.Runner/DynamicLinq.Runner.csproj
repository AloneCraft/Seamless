<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TsavoriteTargetFramework Condition="'$(TsavoriteTargetFramework)' == ''">net10.0</TsavoriteTargetFramework>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(TsavoriteTargetFramework)</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Features>InterceptorsPreview</Features>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Intercept</InterceptorsPreviewNamespaces>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZLinq" Version="1.5.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Seamless\Seamless.csproj" />
    <!-- Normal reference: compile against Seamless.FLinq attributes used by Shared\DynamicLinq. -->
    <ProjectReference Include="..\Seamless.FLinq\Seamless.FLinq.csproj" />
    <!-- Analyzer reference: run the Seamless.FLinq source generator for this executable. -->
    <ProjectReference Include="..\Seamless.FLinq\Seamless.FLinq.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Import Project="..\Shared\DynamicLinq\DynamicLinq.projitems" Label="Shared" />
</Project>

