<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Execution.Tests</RootNamespace>
    <AssemblyName>Execution.Tests</AssemblyName>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Intercept;Intercept.Execution.Tests</InterceptorsNamespaces>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Intercept;Intercept.Execution.Tests</InterceptorsPreviewNamespaces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <Using Include="Xunit" />
    <ProjectReference Include="../Seamless/Seamless.csproj" />
    <ProjectReference Include="../Seamless.Execution/Seamless.Execution.csproj" />
    <ProjectReference Include="../Seamless.Linq/Seamless.Linq.csproj" />
    <ProjectReference Include="../Seamless.FLinq.Generator/Seamless.FLinq.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
