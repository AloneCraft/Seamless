<Page x:Class="Labo.Benchmark.Runner.Uno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Labo.Benchmark.Runner.Uno"
      Loaded="OnPageLoaded"
      KeyDown="OnPageKeyDown"
      KeyUp="OnPageKeyUp"
      MinWidth="1500"
      MinHeight="720"
      Background="#F8F7F2">
  <Grid Padding="20"
        RowSpacing="14"
        RowDefinitions="Auto,Auto,*,Auto">
    <Grid ColumnSpacing="12"
          ColumnDefinitions="320,560,120,150,70">
      <StackPanel Spacing="4">
        <TextBlock Text="Benchmark Runner"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="#202020" />
        <TextBlock Text="Select benchmark methods and run benchmark DLLs on selected CPUs."
                   Foreground="#5D625E" />
      </StackPanel>
      <Grid x:Name="ProjectGrid"
            Grid.Column="1"
            Width="560"
            ColumnSpacing="10"
            RowSpacing="0"
            ColumnDefinitions="270,270"
            RowDefinitions="20,20,20,20" />
      <ComboBox x:Name="ConfigurationComboBox"
                Grid.Column="2"
                MinWidth="120"
                SelectedIndex="1">
        <ComboBoxItem Content="Debug" />
        <ComboBoxItem Content="Release" />
      </ComboBox>
      <CheckBox x:Name="SingleFileCheckBox"
                Grid.Column="3"
                Content="Summary HTML"
                IsChecked="True"
                MinWidth="140"
                VerticalAlignment="Center" />
      <Button x:Name="LoadButton"
              Grid.Column="4"
              Content="Load"
              Click="OnLoadClick" />
    </Grid>

    <Grid Grid.Row="1"
          ColumnSpacing="10"
          RowSpacing="6"
          RowDefinitions="Auto,Auto"
          ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
      <Button Content="Select all"
              Click="OnSelectAllClick" />
      <Button Grid.Column="1"
              Content="Clear"
              Click="OnClearSelectionClick" />
      <Button x:Name="RunButton"
              Grid.Column="2"
              Content="Run"
              Click="OnRunClick" />
      <Button x:Name="CancelButton"
              Grid.Column="3"
              Content="Cancel"
              Click="OnCancelClick"
              IsEnabled="False" />
      <TextBlock x:Name="SelectionSummaryText"
                 Grid.Column="4"
                 VerticalAlignment="Center"
                 Foreground="#3D4540" />
      <ProgressRing x:Name="BusyRing"
                    Grid.Column="5"
                    Width="24"
                    Height="24"
                    IsActive="False" />
      <ProgressBar x:Name="ProgressBar"
                   Grid.Row="1"
                   Grid.ColumnSpan="4"
                   Height="8"
                   Minimum="0"
                   Maximum="1"
                   Value="0" />
      <TextBlock x:Name="ProgressText"
                 Grid.Row="1"
                 Grid.Column="4"
                 Grid.ColumnSpan="2"
                 Text="No run queued"
                 FontSize="12"
                 Foreground="#3D4540"
                 VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="2"
          ColumnSpacing="12"
          ColumnDefinitions="3*,2*">
      <Border BorderBrush="#D5D1C4"
              BorderThickness="1"
              Background="#FFFEFA"
              CornerRadius="6">
        <Grid RowDefinitions="Auto,*">
          <Grid Padding="6,2"
                ColumnDefinitions="24,2*,*,Auto">
            <TextBlock Grid.Column="1"
                       Text="Benchmark"
                       FontSize="11"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Column="2"
                       Text="Category"
                       FontSize="11"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Column="3"
                       Text="Method"
                       FontSize="11"
                       FontWeight="SemiBold" />
          </Grid>
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="BenchmarkItemsControl">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:BenchmarkItem">
                <Grid Height="18"
                      Padding="6,0"
                      ColumnDefinitions="24,2*,*,Auto"
                      Tag="{Binding}"
                      Tapped="OnBenchmarkRowTapped"
                      Background="Transparent">
                  <Border Grid.Column="0"
                          Width="12"
                          Height="12"
                          BorderBrush="#8F938D"
                          BorderThickness="1"
                          CornerRadius="2"
                          Background="#FFFFFF"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding CheckGlyph}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#202020" />
                  </Border>
                  <TextBlock Grid.Column="1"
                             Text="{Binding DisplayName}"
                             FontSize="11"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2"
                             Text="{Binding CategoryText}"
                             FontSize="11"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"
                             Foreground="#676B67" />
                  <TextBlock Grid.Column="3"
                             Text="{Binding MethodName}"
                             FontSize="11"
                             VerticalAlignment="Center"
                             Foreground="#676B67" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        </Grid>
      </Border>

      <Grid Grid.Column="1"
            RowSpacing="12"
            RowDefinitions="2*,3*">
        <Border BorderBrush="#D5D1C4"
                BorderThickness="1"
                Background="#FFFEFA"
                CornerRadius="6">
          <Grid RowDefinitions="Auto,*">
            <Grid Padding="8,4"
                  ColumnDefinitions="*,Auto">
              <TextBlock Text="CPU"
                         FontSize="12"
                         FontWeight="SemiBold" />
              <TextBlock x:Name="CpuSummaryText"
                         Grid.Column="1"
                         Text="0 / 0 CPU selected"
                         FontSize="12"
                         Foreground="#5D625E" />
            </Grid>
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="CpuItemsControl">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:CpuCoreInfo">
                    <Grid Height="24"
                          Padding="6,0"
                          ColumnDefinitions="*,Auto">
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                Click="OnCpuCheckBoxClick"
                                Content="{Binding DisplayText}"
                                FontSize="12"
                                Padding="0"
                                VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding AffinityText}"
                                 FontSize="11"
                                 Foreground="#676B67"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="#D5D1C4"
                BorderThickness="1"
                Background="#FFFEFA"
                CornerRadius="6">
          <Grid RowDefinitions="Auto,*">
            <Grid Padding="6,2"
                  ColumnDefinitions="1.2*,*,90,70,50">
              <TextBlock Text="Project"
                         FontSize="11"
                         FontWeight="SemiBold" />
              <TextBlock Grid.Column="1"
                         Text="Method"
                         FontSize="11"
                         FontWeight="SemiBold" />
              <TextBlock Grid.Column="2"
                         Text="CPU"
                         FontSize="11"
                         FontWeight="SemiBold" />
              <TextBlock Grid.Column="3"
                         Text="Status"
                         FontSize="11"
                         FontWeight="SemiBold" />
              <TextBlock Grid.Column="4"
                         Text="PID"
                         FontSize="11"
                         FontWeight="SemiBold" />
            </Grid>
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
              <ItemsControl x:Name="RunningItemsControl">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:BenchmarkRunItem">
                    <Grid Height="20"
                          Padding="6,0"
                          ColumnDefinitions="1.2*,*,90,70,50">
                      <TextBlock Text="{Binding ProjectDisplayName}"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding MethodName}"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2"
                                 Text="{Binding CpuDisplay}"
                                 FontSize="11"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3"
                                 Text="{Binding StatusText}"
                                 FontSize="11"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4"
                                 Text="{Binding ProcessIdText}"
                                 FontSize="11"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Grid Grid.Row="3"
          RowSpacing="6"
          RowDefinitions="Auto,Auto,160">
      <Grid ColumnSpacing="12"
            ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText"
                   Text="Ready"
                   Foreground="#3D4540" />
        <HyperlinkButton x:Name="ReportLinkButton"
                         Grid.Column="1"
                         Content="Open summary"
                         Visibility="Collapsed"
                         Click="OnOpenReportClick" />
      </Grid>
      <TextBox x:Name="LogTextBox"
               Grid.Row="2"
               AcceptsReturn="True"
               FontFamily="Cascadia Mono, Yu Gothic UI, Meiryo, Consolas"
               FontSize="12"
               IsReadOnly="True"
               TextWrapping="NoWrap"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
  </Grid>
</Page>
