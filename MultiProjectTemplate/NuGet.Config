<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="SeamlessLocal" value="../Work/VirtualDbFeed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="SeamlessLocal">
      <package pattern="Seamless" />
      <package pattern="Seamless.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="globalPackagesFolder" value="../Work/MultiProjectTemplate/packages" />
  </config>
</configuration>
