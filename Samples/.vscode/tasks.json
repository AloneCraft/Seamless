{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-sample-virtualdb",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Sample.VirtualDb/Sample.VirtualDb.csproj",
                "-m:1",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-sample-netshop",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Sample.NetShop/Sample.NetShop.csproj",
                "-r",
                "win-x64",
                "-m:1",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
