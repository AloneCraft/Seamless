<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Sample.FLinqChainVerifier.Cli</RootNamespace>
    <AssemblyName>Sample.FLinqChainVerifier.Cli</AssemblyName>
    <Features>InterceptorsPreview</Features>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Intercept</InterceptorsNamespaces>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Intercept</InterceptorsPreviewNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sample.FLinqChainVerifier.Core\Sample.FLinqChainVerifier.Core.csproj" />
    <ProjectReference Include="..\..\Seamless\Seamless.csproj" />
  </ItemGroup>
</Project>
