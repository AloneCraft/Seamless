<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Sample.NetShop.Core</RootNamespace>
    <AssemblyName>Sample.NetShop.Core</AssemblyName>
    <Features>InterceptorsPreview</Features>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Intercept</InterceptorsNamespaces>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Intercept</InterceptorsPreviewNamespaces>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sample.NetShop.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Seamless/Database/Database.csproj" />
    <ProjectReference Include="../../Seamless/Database/Generator/Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="../../Seamless/FLinq/Generator/Compiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <PropertyGroup>
    <SeamlessLinqAnalysis>false</SeamlessLinqAnalysis>
  </PropertyGroup>
</Project>
