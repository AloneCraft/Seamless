<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Seamless</RootNamespace>
    <AssemblyName>Seamless.Abstractions</AssemblyName>
    <PackageId>Seamless.Abstractions</PackageId>
    <Title>Seamless Abstractions</Title>
    <Description>Minimal public contracts shared by Seamless packages.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Artifacts\**" />
    <Compile Remove="Work\**" />
    <EmbeddedResource Remove="Artifacts\**" />
    <EmbeddedResource Remove="Work\**" />
    <None Remove="Artifacts\**" />
    <None Remove="Work\**" />
  </ItemGroup>
</Project>
