<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Seamless.Collections.Persisted</RootNamespace>
    <AssemblyName>Seamless.Collections.Persisted</AssemblyName>
    <PackageId>Seamless.Collections.Persisted</PackageId>
    <IsPackable>true</IsPackable>
    <Title>Seamless Persisted Collections</Title>
    <Description>File-backed persisted collections for Seamless.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Artifacts\**" />
    <Compile Remove="Work\**" />
    <Compile Include="Work\*.cs" />
    <EmbeddedResource Remove="Artifacts\**" />
    <EmbeddedResource Remove="Work\**" />
    <None Remove="Artifacts\**" />
    <None Remove="Work\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Seamless.Collections\Seamless.Collections.csproj" />
    <ProjectReference Include="..\Seamless.Execution\Seamless.Execution.csproj" />
  </ItemGroup>
</Project>
