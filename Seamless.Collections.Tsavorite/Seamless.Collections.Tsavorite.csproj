<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Seamless.Collections.Tsavorite</RootNamespace>
    <AssemblyName>Seamless.Collections.Tsavorite</AssemblyName>
    <PackageId>Seamless.Collections.Tsavorite</PackageId>
    <IsPackable>true</IsPackable>
    <Title>Seamless Tsavorite Collections</Title>
    <Description>Tsavorite-backed collections for Seamless.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Artifacts\**" />
    <Compile Remove="Work\**" />
    <EmbeddedResource Remove="Artifacts\**" />
    <EmbeddedResource Remove="Work\**" />
    <None Remove="Artifacts\**" />
    <None Remove="Work\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Garnet" Version="[2.2.1]" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Seamless.Collections\Seamless.Collections.csproj" />
    <ProjectReference Include="..\Seamless.Execution\Seamless.Execution.csproj" />
  </ItemGroup>
  <!-- 元packageはsupport DLLの取得専用。Coreは修正済みprojectを公開参照する。 -->
  <ItemGroup>
    <ProjectReference Include="../Seamless.Tsavorite.Core/Seamless.Tsavorite.Core.csproj" />
    <Reference Include="Garnet.common">
      <HintPath>$(PkgMicrosoft_Garnet)/lib/net10.0/Garnet.common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Tsavorite.devices.AzureStorageDevice">
      <HintPath>$(PkgMicrosoft_Garnet)/lib/net10.0/Tsavorite.devices.AzureStorageDevice.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Import Project="../Seamless.Tsavorite.Core/buildTransitive/Seamless.Tsavorite.Core.targets" />
</Project>
