<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Seamless.Collections</RootNamespace>
    <AssemblyName>Seamless.Collections</AssemblyName>
    <PackageId>Seamless.Collections</PackageId>
    <IsPackable>true</IsPackable>
    <Title>Seamless Collections</Title>
    <Description>Collection contracts, serializers, and the memory-mapped list foundation shared by Seamless collection packages.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Artifacts\**" />
    <Compile Remove="Work\**" />
    <EmbeddedResource Remove="Artifacts\**" />
    <EmbeddedResource Remove="Work\**" />
    <None Remove="Artifacts\**" />
    <None Remove="Work\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.*" />
  </ItemGroup>
</Project>
