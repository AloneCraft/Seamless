<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Seamless.Database.Generator</RootNamespace>
    <AssemblyName>Seamless.Database.Generator</AssemblyName>
    <PackageId>Seamless.Database.Generator</PackageId>
    <Title>Seamless Database Generator</Title>
    <Description>Database schema boilerplate source generator for Seamless.</Description>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- NU5128: lib/ を持たない analyzer パッケージでは正常。 -->
    <NoWarn>$(NoWarn);RS1041;RS2008;NU5128</NoWarn>
    <IsPackable>true</IsPackable>
    <!-- 生成器は lib/ ではなく analyzers/dotnet/cs/ へ入れる。lib/ に入ると参照アセンブリ扱いになり生成器として動かない。 -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- IncludeBuildOutput=false だと snupkg が空になり NU5017 で失敗するため symbols は作らない。 -->
    <IncludeSymbols>false</IncludeSymbols>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddGeneratorToPackage</TargetsForTfmSpecificContentInPackage>
    <!-- DevelopmentDependency は付けない。付けると利用者側で PrivateAssets=all 扱いになり、
         下で宣言する Seamless.Database への依存が流れず、生成コードがコンパイルできなくなる。 -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 生成コードが global::Seamless.Database.* を直接埋め込むため、ランタイムを依存として宣言する。
         ReferenceOutputAssembly="false" にすると nuspec の dependency ごと消える(実測)ので通常参照にする。
         この生成器は Seamless.Database の型を一切使わないので、参照はコンパイル上 inert。 -->
    <ProjectReference Include="..\Seamless.Database\Seamless.Database.csproj" />
  </ItemGroup>

  <Target Name="_AddGeneratorToPackage">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>
