<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>Seamless.Database.Server</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>seamless-server</ToolCommandName>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Seamless.Database.Server</RootNamespace>
    <AssemblyName>Seamless.Database.Server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Seamless.Database.Gateway\Seamless.Database.Gateway.csproj" />
    <ProjectReference Include="..\Seamless.Management.Server\WindowsServer.csproj" />
    <ProjectReference Include="..\Samples\Sample.NetShop.Core\Sample.NetShop.Core.csproj" />
  </ItemGroup>

  <Target Name="IncludeGatewayToolNotices" BeforeTargets="PackTool" Condition="'$(PackAsTool)' == 'true'">
    <PropertyGroup>
      <_ToolNoticeScript>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '../tools/management/Write-ThirdPartyNotices.ps1'))</_ToolNoticeScript>
      <_ToolPublishDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_ToolPublishDirectory>
      <_ToolNoticeArguments></_ToolNoticeArguments>
      <_ToolNoticeArguments Condition="'$(SeamlessPackageFallbackRoot)' != ''">$(_ToolNoticeArguments) -PackageFallbackRoot &quot;$(SeamlessPackageFallbackRoot)&quot;</_ToolNoticeArguments>
      <_ToolNoticeArguments Condition="'$(AppHostSourcePath)' != ''">$(_ToolNoticeArguments) -AppHostSourcePath &quot;$(AppHostSourcePath)&quot;</_ToolNoticeArguments>
    </PropertyGroup>
    <Exec Command="pwsh -NoProfile -File &quot;$(_ToolNoticeScript)&quot; -PublishedDirectory &quot;$(_ToolPublishDirectory).&quot; -PackageRoot &quot;$(NuGetPackageRoot)/.&quot; -ToolEntryAssembly &quot;$(AssemblyName)&quot;$(_ToolNoticeArguments)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../LICENSE" DestinationFolder="$(_ToolPublishDirectory)" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(_ToolPublishDirectory)THIRD-PARTY-NOTICES.md" RelativePath="THIRD-PARTY-NOTICES.md" />
      <ResolvedFileToPublish Include="$(_ToolPublishDirectory)ThirdParty/**/*" RelativePath="ThirdParty/%(RecursiveDir)%(Filename)%(Extension)" />
      <ResolvedFileToPublish Include="$(_ToolPublishDirectory)LICENSE" RelativePath="LICENSE" />
    </ItemGroup>
  </Target>
</Project>
