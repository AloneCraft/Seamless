<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Seamless.Database.SqlServer</RootNamespace>
    <AssemblyName>Seamless.Database.SqlServer</AssemblyName>
    <PackageId>Seamless.Database.SqlServer</PackageId>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="SystemCatalog\SqlServer17\*.tsv;SystemCatalog\SqlServer17\source.txt" LogicalName="Seamless.Database.SqlServer.SystemCatalog.SqlServer17.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SqlParserCS" Version="0.6.5" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
    <!-- SqlClient の間接参照を、CVE-2026-84008 と CVE-2026-70162 が修正された .NET 10 向けの版へ更新する。 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.102.0" />
    <ProjectReference Include="..\Seamless.Database\Seamless.Database.csproj" />
    <ProjectReference Include="..\Seamless.Database.Rdbms\Seamless.Database.Rdbms.csproj" />
    <!-- 取り込むビューを C# のビューへ訳す(T-SQL 翻訳器の段階4)。 -->
    <ProjectReference Include="..\Seamless.Database.SqlTranslation\Seamless.Database.SqlTranslation.csproj" />
    <!-- bit の型(Types.Bit)はここにある(取り込んだ DB の成果物が SqlClient を持たずに済むよう移した)。 -->
    <ProjectReference Include="..\Seamless.Database.SqlServer.Functions\Seamless.Database.SqlServer.Functions.csproj" />
    <!-- 書き出し(SqlServerDatabaseExporter)が、DB の定義の読み直し(SeamlessCatalogReader)と取り込みの進み具合の型を使う。 -->
    <ProjectReference Include="..\Seamless.Database.Transfer\Seamless.Database.Transfer.csproj" />
  </ItemGroup>
</Project>
