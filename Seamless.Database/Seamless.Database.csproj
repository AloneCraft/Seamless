<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Seamless.Database</RootNamespace>
    <AssemblyName>Seamless.Database</AssemblyName>
    <PackageId>Seamless.Database</PackageId>
    <IsPackable>true</IsPackable>
    <Title>Seamless Database</Title>
    <Description>Declarative database container runtime (Table/View/TableFunction) backed by Seamless Tsavorite collections.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Artifacts\**" />
    <Compile Remove="Work\**" />
    <EmbeddedResource Remove="Artifacts\**" />
    <EmbeddedResource Remove="Work\**" />
    <None Remove="Artifacts\**" />
    <None Remove="Work\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Seamless.Transactions.Collections\Seamless.Transactions.Collections.csproj" />
    <ProjectReference Include="..\Seamless.Execution\Seamless.Execution.csproj" />
    <ProjectReference Include="..\Seamless.Linq\Seamless.Linq.csproj" />
    <ProjectReference Include="..\Seamless.Collections.Persisted\Seamless.Collections.Persisted.csproj" />
    <ProjectReference Include="..\Seamless.Collections.Tsavorite\Seamless.Collections.Tsavorite.csproj" />
  </ItemGroup>
</Project>
