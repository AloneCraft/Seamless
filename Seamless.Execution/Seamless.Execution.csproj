<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Seamless.Execution</RootNamespace>
    <AssemblyName>Seamless.Execution</AssemblyName>
    <IsPackable>true</IsPackable>
    <Description>Execution scopes, shared resource budgets and deterministic codecs for Seamless.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Seamless.Collections/Seamless.Collections.csproj" />
    <EmbeddedResource Include="Profiles/measured.json" LogicalName="Seamless.Execution.Profiles.measured.json" />
  </ItemGroup>
</Project>
