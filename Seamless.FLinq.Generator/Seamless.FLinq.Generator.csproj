<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Seamless.FLinq.Generator</RootNamespace>
    <AssemblyName>Seamless.FLinq.Generator</AssemblyName>
    <PackageId>Seamless.FLinq.Generator</PackageId>
    <Title>Seamless FLinq</Title>
    <Description>Compile-time LINQ rewriting source generator for Seamless.</Description>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- NU5128: lib/ を持たない analyzer パッケージでは正常。 -->
    <NoWarn>$(NoWarn);RS1041;RS2008;CS9107;NU5128</NoWarn>
    <IsPackable>true</IsPackable>
    <!-- 生成器は lib/ ではなく analyzers/dotnet/cs/ へ入れる。lib/ に入ると参照アセンブリ扱いになり生成器として動かない。 -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>false</IncludeContentInPack>
    <!-- IncludeBuildOutput=false だと snupkg が空になり NU5017 で失敗するため symbols は作らない。 -->
    <IncludeSymbols>false</IncludeSymbols>
    <NuspecFile>Seamless.FLinq.Generator.nuspec</NuspecFile>
    <NuspecProperties>version=$(Version);targetPath=$(TargetPath)</NuspecProperties>
    <!-- DevelopmentDependency は付けない。付けると利用者側で PrivateAssets=all 扱いになり、
         下で宣言する Seamless.Linq への依存が流れず、生成コードがコンパイルできなくなる。 -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="_SetFLinqNuspecProperties" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <NuspecProperties>version=$(Version);targetPath=$(TargetPath)</NuspecProperties>
    </PropertyGroup>
  </Target></Project>
