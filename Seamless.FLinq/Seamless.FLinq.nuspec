<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>Seamless.FLinq</id>
    <version>$version$</version>
    <title>Seamless FLinq</title>
    <authors>KazuhiroNomura</authors>
    <description>Compile-time LINQ rewriting source generator for Seamless.</description>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/KazuhiroNomura/Seamless</projectUrl>
    <repository type="git" url="https://github.com/KazuhiroNomura/Seamless" />
    <dependencies>
      <group targetFramework="netstandard2.0">
        <dependency id="Seamless.Linq" version="[$version$]" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="$targetPath$" target="analyzers/dotnet/cs" />
  </files>
</package>