<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Seamless</RootNamespace>
    <AssemblyName>Seamless.Linq</AssemblyName>
    <PackageId>Seamless.Linq</PackageId>
    <Title>Seamless LINQ</Title>
    <Description>Shared LINQ runtime support for Seamless collection packages.</Description>
  </PropertyGroup>
</Project>
