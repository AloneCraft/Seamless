<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Seamless.Linq</RootNamespace>
    <AssemblyName>Seamless.Linq</AssemblyName>
    <PackageId>Seamless.Linq</PackageId>
    <IsPackable>true</IsPackable>
    <Title>Seamless LINQ Runtime</Title>
    <Description>Value-enumerable LINQ runtime used by Seamless and FLinq generated code.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Artifacts\**" />
    <Compile Remove="Work\**" />
    <EmbeddedResource Remove="Artifacts\**" />
    <EmbeddedResource Remove="Work\**" />
    <None Remove="Artifacts\**" />
    <None Remove="Work\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Seamless.Collections.Persisted\Seamless.Collections.Persisted.csproj" />
    <ProjectReference Include="..\Seamless.Collections.Tsavorite\Seamless.Collections.Tsavorite.csproj" />
    <ProjectReference Include="..\Seamless.Linq.Analyzers\Seamless.Linq.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- 参照解決後の @(Analyzer) から実出力を拾う。bin\$(Configuration)\netstandard2.0 のハードコードを避ける。 -->
  <Target Name="PackAnalyzer" BeforeTargets="_GetPackageFiles" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <None Include="@(Analyzer->WithMetadataValue('ReferenceSourceTarget','ProjectReference'))" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
