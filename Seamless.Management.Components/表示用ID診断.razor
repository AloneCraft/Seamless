<section class="小案内" role="status" aria-label="@表示文言.取得("表示用IDの状態")" data-identity-status>
    <strong>@表示文言.取得("{0}の表示用ID",DB名)</strong>
    <span>@表示文言.取得("{0}件 · {1}",件数,表示文言.取得(保存状態))</span>
    @foreach(var 診断 in 診断一覧){<p>@診断</p>}
    <p>@表示文言.取得("名前変更をまたぐ文書復元への接続は準備中です。現在の復元条件は同じ版・成果物です。")</p>
</section>
@code{
    [Parameter]public string DB名{get;set;}="";
    [Parameter]public int 件数{get;set;}
    [Parameter]public string 保存状態{get;set;}="";
    [Parameter]public string[] 診断一覧{get;set;}=[];
}
