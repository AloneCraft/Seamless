<section class="計画要素説明" aria-label="@表示文言.取得("この要素の意味")">
    <h5>@表示文言.取得("この要素の意味")</h5>
    <p>@表示文言.取得(this.説明)</p>
    @if(ノード.Kind=="SourceOperator"){
        <p>@表示文言.取得("SourceOperatorは元クエリの演算です。具体的な条件・選択列・キーは、記録されたExpressionと対応コードで確認できます。")</p>
    }
    <details><summary>@表示文言.取得("識別子・型・未収集の読み方")</summary>
        <p>@表示文言.取得("sourceで始まるIDは元ソース位置に基づく識別子です。数値はUTF16の開始位置と長さで、実行順や所要時間ではありません。")</p>
        <p>@表示文言.取得("出力型は型解析の結果です。NULL許容性の不明は未記録を示します。未収集の時間・CPU・I/Oをゼロとは扱いません。")</p>
    </details>
</section>
@code{
    [Parameter,EditorRequired]public ExecutionPlanNode ノード{get;set;}=null!;
    private string 説明=>this.ノード.Kind switch{
        "SourceOperator"=>this.演算説明,
        "Fragment"=>"FLinqが採用した処理の構成要素です。具体的な実装情報は記録されたプロパティで確認できます。",
        "PipelineStage"=>"FLinqが採用したパイプラインの一段階です。入力と出力、処理の設定は記録されたプロパティで確認できます。",
        "Expression"=>"元クエリ内の式です。演算の依存関係を示し、独立した実行タスクを意味しません。",
        "RuntimeCondition"=>"生成コードが実行時に判定する条件として記録された要素です。条件が今回成立したかは実測が必要です。",
        "LoweringDecision"=>"生成器による書き換え判断の記録です。Before・After・規則IDで内容を確認できます。",
        _=>"この種類の一般説明は未登録です。Kind・Label・記録されたプロパティと対応コードを確認してください。"
    };
    private string 演算説明=>this.ノード.Label switch{
        "Where"=>"条件を満たす要素を選びます。",
        "Select"=>"各要素から必要な値や列を取り出して変換します。",
        "OrderBy" or "ThenBy"=>"指定したキーで昇順に並べます。ThenByは前の並び順に次のキーを追加します。",
        "OrderByDescending" or "ThenByDescending"=>"指定したキーで降順に並べます。ThenByDescendingは前の並び順に次のキーを追加します。",
        "Join"=>"一致するキーを持つ入力同士を結びます。",
        "GroupJoin"=>"キーに一致する要素をグループとして結びます。",
        "GroupBy"=>"同じキーを持つ要素をグループにまとめます。",
        "Sum"=>"数値を合計します。",
        "Any"=>"該当する要素が存在するかを判定します。",
        "Count" or "LongCount"=>"要素数を求めます。条件がある場合は条件を満たす要素を数えます。",
        "ToArray"=>"結果を配列として実体化します。",
        "ToList"=>"結果をリストとして実体化します。",
        "Take"=>"先頭から指定した件数の要素を取り出します。",
        "Skip"=>"先頭から指定した件数の要素を読み飛ばします。",
        "Distinct"=>"等価な要素の重複を除きます。",
        "Union"=>"いずれかの入力に含まれる要素を返します。",
        "Intersect"=>"両方の入力に含まれる要素を返します。",
        "Except"=>"左の入力に含まれ、右の入力には含まれない要素を返します。",
        "Concat"=>"入力の列を連結します。",
        _=>"元クエリに書かれた演算です。実際の処理は対応コードの呼び出し先と記録されたプロパティで確認できます。"
    };
}
