<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Seamless.RelationStudio.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Seamless.RelationStudio"
    Shell.FlyoutBehavior="Disabled"
    Title="Seamless.RelationStudio">

    <TabBar>
        <Tab Title="Grid">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>
        <Tab Title="Chart">
            <ShellContent ContentTemplate="{DataTemplate local:ChartPage}" Route="ChartPage" />
        </Tab>
    </TabBar>

</Shell>
