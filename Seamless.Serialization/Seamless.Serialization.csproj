<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Seamless</RootNamespace>
    <AssemblyName>Seamless.Serialization</AssemblyName>
    <PackageId>Seamless.Serialization</PackageId>
    <Title>Seamless Serialization</Title>
    <Description>Serialization contracts and built-in serializers for Seamless storage packages.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Artifacts\**" />
    <Compile Remove="Work\**" />
    <EmbeddedResource Remove="Artifacts\**" />
    <EmbeddedResource Remove="Work\**" />
    <None Remove="Artifacts\**" />
    <None Remove="Work\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.*" />
  </ItemGroup>
</Project>
