<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Seamless</RootNamespace>
    <AssemblyName>Seamless.Tsavorite.Collections</AssemblyName>
    <PackageId>Seamless.Tsavorite.Collections</PackageId>
    <Title>Seamless Collections Tsavorite</Title>
    <Description>Tsavorite-backed collections for Seamless.</Description>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Garnet" Version="2.0.1-beta.5" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Seamless.Abstractions\Seamless.Abstractions.csproj" />
    <ProjectReference Include="..\Seamless.Linq\Seamless.Linq.csproj" />
    <ProjectReference Include="..\Seamless.Persisted.Collections\Seamless.Persisted.Collections.csproj" />
    <ProjectReference Include="..\Seamless.SourceGenerators\Seamless.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <PropertyGroup>
    <SeamlessGenerateLinqEnumerable>true</SeamlessGenerateLinqEnumerable>
    <SeamlessLinqEnumerableNamespace>Seamless.Tsavorite.Linq</SeamlessLinqEnumerableNamespace>
    <SeamlessLinqEnumerableSourceType>global::Seamless.Collections.ISet&lt;TSource&gt;</SeamlessLinqEnumerableSourceType>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="SeamlessGenerateLinqEnumerable" />
    <CompilerVisibleProperty Include="SeamlessLinqEnumerableNamespace" />
    <CompilerVisibleProperty Include="SeamlessLinqEnumerableSourceType" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TsavoriteGarnetPackageVersion</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFileName('$(PkgMicrosoft_Garnet)'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
