<div class="DB子一覧" role="group" aria-label="@表示文言.取得("DBの内容")">
    <所属オブジェクト一覧 @ref="所属一覧[固定所属]" DBID="@DBID" 表示順世代="@表示順世代" 表示順可能か="表示順可能か" 定義="定義" 公開定義="公開定義" 公開時の項目="公開時の項目" 公開時の問い合わせ列="公開時の問い合わせ列" 削除項目="削除項目.Where(項目=>項目.Schema==固定所属)" 型候補="型候補" 列確定時="列確定時" 未保存変更時="未保存変更時" 選択オブジェクト="選択オブジェクト" 展開状態="展開状態" オブジェクト="オブジェクト.Where(項目=>項目.Schema.Length==0)" 公開済みか="公開済みか" 編集可能か="編集可能か" 編集操作停止中か="編集操作停止中か" 選択時="選択時" 作成要求時="作成要求時" メニュー要求時="メニュー要求時" 対象操作="対象操作"/>
    @* DB 直下は固定の見出し(テーブル・ビュー・関数・スキーマ)だけを並べ、作ったスキーマは「スキーマ」の見出しの下に置く。 *@
    @if(表示スキーマ.Length>0||削除スキーマ.Length>0||編集可能か&&対象操作 is not null){
    <div class="オブジェクト分類">
        <対象操作ホスト 追加ボタンを表示するか="false" メニュー要求時="メニュー要求時" ID="@("group:"+ツリー展開状態.スキーマ分類+":")" 名前="@表示文言.取得("スキーマ")" 展開中か="展開状態.分類展開中か(固定所属,ツリー展開状態.スキーマ分類)" 展開変更時="展開=>展開状態.分類を開閉(固定所属,ツリー展開状態.スキーマ分類,展開)">
            <span class="分類名">@表示文言.取得("スキーマ")</span><span class="件数">@(表示スキーマ.Length+削除スキーマ.Length)</span>
        </対象操作ホスト>
        <div data-tree-children class="オブジェクト子一覧" hidden="@(!展開状態.分類展開中か(固定所属,ツリー展開状態.スキーマ分類))">
        @foreach(var 名前 in 表示スキーマ){
            <div @key="名前" class="スキーマ枝">
                <対象操作ホスト 追加ボタンを表示するか="false" メニュー要求時="メニュー要求時" ID="@("schema:"+名前)" 名前="@名前" 選択中か="@(選択オブジェクト is null&&選択スキーマ==名前)" 展開中か="展開状態.スキーマ展開中か(名前)" 展開変更時="展開=>展開状態.スキーマを開閉(名前,展開)" 選択時="()=>所属選択時.InvokeAsync(名前)" 行操作="@スキーマ行操作(名前)">
                    <span class="DBアイコン"><操作アイコン 種類="スキーマ"/></span><span class="対象名">@名前</span>
                </対象操作ホスト>
                    <div data-tree-children class="スキーマ子一覧" hidden="@(!展開状態.スキーマ展開中か(名前))"><所属オブジェクト一覧 @ref="所属一覧[名前]" DBID="@DBID" 表示順世代="@表示順世代" 表示順可能か="表示順可能か" 定義="定義" 公開定義="公開定義" 公開時の項目="公開時の項目" 公開時の問い合わせ列="公開時の問い合わせ列" 削除項目="削除項目.Where(項目=>項目.Schema==名前)" 型候補="型候補" 列確定時="列確定時" 未保存変更時="未保存変更時" 選択オブジェクト="選択オブジェクト" 展開状態="展開状態" 所属="@名前" オブジェクト="オブジェクト.Where(項目=>項目.Schema==名前)" 公開済みか="公開済みか" 編集可能か="@(編集可能か&&スキーマ.Contains(名前,StringComparer.Ordinal))" 編集操作停止中か="編集操作停止中か" 選択時="選択時" 作成要求時="作成要求時" メニュー要求時="メニュー要求時" 対象操作="対象操作"/></div>
            </div>
        }
        @foreach(var 名前 in 削除スキーマ){
            <div class="対象行 下書き削除行"><div class="対象内容"><span class="DBアイコン"><操作アイコン 種類="スキーマ"/></span><del class="対象名 下書き削除">@名前</del></div>
                @if(編集可能か&&対象操作?.削除取消 is not null){
                    <button type="button" class="行右ボタン" aria-label="@表示文言.取得("削除を取り消す")" title="@表示文言.取得("削除を取り消す")" disabled="@(編集操作停止中か||スキーマ処理中か)" @onclick="()=>スキーマ復元Async(名前)"><操作アイコン 種類="戻す"/></button>
                }
            </div>
        }
        @if(編集可能か&&対象操作 is not null){
            @if(スキーマ作成中か){
                <div class="ツリー追加行" role="group" aria-label="@表示文言.取得("スキーマを追加")"><操作アイコン 種類="スキーマ"/><インライン名前入力 名前="新しいスキーマ名" プレースホルダー="新しいスキーマ名" クラス="ツリー追加入力" 無効か="@(編集操作停止中か||スキーマ処理中か)" 確定時="スキーマ確定Async" 取消時="()=>スキーマ作成中か=false"/></div>
            }else{
                <button type="button" class="テキストボタン ツリー追加行" disabled="@編集操作停止中か" @onclick="()=>{スキーマ作成中か=true;スキーマ案内=null;}"><操作アイコン 種類="追加"/>@表示文言.取得("スキーマを追加")</button>
            }
        }
        </div>
        @if(スキーマ案内 is not null){<p class="ツリー列診断" role="status">@スキーマ案内</p>}
    </div>
    }
</div>
@code{
    [Parameter]public ツリー対象操作? 対象操作{get;set;}
    private string[] 表示スキーマ=>オブジェクト.Any(項目=>項目.Kind is "SystemProperty" or "SystemView")?スキーマ.Append(DatabaseSystemObjects.Schema).Distinct(StringComparer.Ordinal).ToArray():スキーマ;
    private bool スキーマ作成中か,スキーマ処理中か;
    private string? スキーマ案内;
    private async Task スキーマ確定Async(string 名前){
        if(this.対象操作 is null||this.編集操作停止中か||this.スキーマ処理中か){return;}
        this.スキーマ処理中か=true;
        try{var 結果=await this.対象操作.スキーマ作成(名前);this.スキーマ案内=結果.案内;if(結果.案内 is null){this.スキーマ作成中か=false;this.展開状態.分類を開閉(固定所属,ツリー展開状態.スキーマ分類,true);
            // 表・ビューの作成と同じく、親へ未保存の変更を知らせて描き直させる(知らせないと木のスキーマの一覧が古いまま残る)。
            await this.未保存変更時.InvokeAsync();}}
        catch(ManagementException 例外){this.スキーマ案内=例外.Message;}
        finally{this.スキーマ処理中か=false;}
    }
    // スキーマの行の右端の削除。中身のあるスキーマは理由を表示して消さない。
    private RenderFragment? スキーマ行操作(string 名前){
        if(!this.編集可能か||this.対象操作?.スキーマ削除 is null||!this.スキーマ.Contains(名前,StringComparer.Ordinal)){return null;}
        return @<text><button type="button" class="行右ボタン" title="@表示文言.取得("削除")" aria-label="@表示文言.取得("{0}を削除",名前)" disabled="@(編集操作停止中か||スキーマ処理中か)" @onclick="()=>スキーマ削除Async(名前)" @onclick:stopPropagation="true"><操作アイコン 種類="削除"/></button></text>;
    }
    private async Task スキーマ削除Async(string 名前){
        if(this.対象操作?.スキーマ削除 is not{} 削除||this.編集操作停止中か||this.スキーマ処理中か){return;}
        this.スキーマ処理中か=true;
        try{var 結果=await 削除(名前);this.スキーマ案内=結果.案内;if(結果.案内 is null){this.展開状態.スキーマを開閉(名前,false);await this.未保存変更時.InvokeAsync();}}
        catch(ManagementException 例外){this.スキーマ案内=例外.Message;}
        finally{this.スキーマ処理中か=false;}
    }
    private async Task スキーマ復元Async(string 名前){
        if(this.対象操作?.削除取消 is not{} 戻す||this.編集操作停止中か||this.スキーマ処理中か){return;}
        this.スキーマ処理中か=true;
        try{var 結果=await 戻す(名前,"Schema");this.スキーマ案内=結果.案内;if(結果.案内 is null){await this.未保存変更時.InvokeAsync();}}
        catch(ManagementException 例外){this.スキーマ案内=例外.Message;}
        finally{this.スキーマ処理中か=false;}
    }
    [Parameter]public string[] スキーマ{get;set;}=[];
    [Parameter]public CatalogObject[] オブジェクト{get;set;}=[];
    [Parameter]public CatalogObject? 選択オブジェクト{get;set;}
    [Parameter]public Func<CatalogObject,bool>? 公開済みか{get;set;}
    [Parameter]public string 選択スキーマ{get;set;}="";
    [Parameter]public bool 編集可能か{get;set;}
    [Parameter]public bool 編集操作停止中か{get;set;}
    [Parameter]public EventCallback<string> 所属選択時{get;set;}
    [Parameter]public EventCallback<CatalogObject> 選択時{get;set;}
    [Parameter]public EventCallback<対象操作要求> 作成要求時{get;set;}
    [Parameter]public EventCallback<対象操作要求> メニュー要求時{get;set;}
    [Parameter]public ツリー展開状態 展開状態{get;set;}=new();
    [Parameter]public Definition? 定義{get;set;}
    [Parameter]public Definition? 公開定義{get;set;}
    [Parameter]public Func<CatalogObject,CatalogObject?>? 公開時の項目{get;set;}
    [Parameter]public Func<CatalogObject,bool,string,string?>? 公開時の問い合わせ列{get;set;}
    [Parameter]public CatalogObject[] 削除項目{get;set;}=[];
    [Parameter]public string[] 削除スキーマ{get;set;}=[];
    [Parameter]public IEnumerable<string> 型候補{get;set;}=[];
    [Parameter]public Func<ツリー列編集要求,Task<ObjectDefinitionEdit>>? 列確定時{get;set;}
    [Parameter]public EventCallback 未保存変更時{get;set;}
    [Parameter]public string DBID{get;set;}="";
    [Parameter]public string 表示版{get;set;}="";
    [Parameter]public bool 表示順可能か{get;set;}
    private string 表示順世代=Guid.NewGuid().ToString("N"),読取DBID="",読取版="";
    private Definition? 順序の定義;
    private CatalogObject[] 順序の対象=[];
    protected override void OnParametersSet(){
        if(this.読取DBID!=this.DBID||this.読取版!=this.表示版||!ReferenceEquals(this.順序の定義,this.定義)||!this.順序の対象.SequenceEqual(this.オブジェクト)){
            this.展開状態.表示順序.既定順に戻す();this.表示順世代=Guid.NewGuid().ToString("N");this.読取DBID=this.DBID;this.読取版=this.表示版;this.順序の定義=this.定義;this.順序の対象=this.オブジェクト.ToArray();
        }
    }
    public bool 表示順を変更できるか(string ID,int 差)=>this.表示順可能か&&this.展開状態.表示順序.移動できるか(this.オブジェクト,ID,差);
    public Task 表示順を変更Async(string ID,int 差){if(this.表示順可能か){this.展開状態.表示順序.移動(this.オブジェクト,ID,差);}return this.InvokeAsync(this.StateHasChanged);}
    public Task 表示順を戻すAsync(string ID){this.展開状態.表示順序.既定順に戻す(this.オブジェクト,ID);return this.InvokeAsync(this.StateHasChanged);}
    public Task 表示順をドロップAsync(string 所属,string 種類,string 世代,string ID,string 対象ID,bool 前か){
        if(this.表示順可能か&&this.表示順世代==世代){this.展開状態.表示順序.対象位置へ移動(this.オブジェクト,所属,種類,ID,対象ID,前か);}return this.InvokeAsync(this.StateHasChanged);
    }
    public bool 未保存か=>this.スキーマ作成中か||this.所属一覧.Values.Any(一覧=>一覧.未保存か);
    private const string 固定所属="";
    private readonly Dictionary<string,所属オブジェクト一覧> 所属一覧=new(StringComparer.Ordinal);
    public async Task 列追加を開始Async(string ID){
        var 項目=this.オブジェクト.Single(項目=>項目.Kind=="Table"&&項目.Id==ID);if(項目.Schema.Length>0){this.展開状態.スキーマを開閉(項目.Schema,true);}
        if(this.所属一覧.TryGetValue(項目.Schema,out var 一覧)){await 一覧.列追加を開始Async(ID);}await this.InvokeAsync(this.StateHasChanged);
    }
}
