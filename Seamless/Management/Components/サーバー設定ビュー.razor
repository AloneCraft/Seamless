@implements IDisposable
@inject IManagementOperations 管理操作

<section class="文書領域 サーバー設定画面" hidden="@(!表示中か)" aria-label="@表示文言.取得("サーバー設定")">
    <div class="種類ラベル">SYSTEM</div><追加メニューホスト ID="settings" 名前="@表示文言.取得("サーバー設定")" 登録="追加コマンド" 実行時="@(ID=>追加コマンド.実行Async(ID,"settings"))" 追加可能か="@(!処理中か&&情報 is not null)"><h1>@表示文言.取得("サーバー設定")</h1></追加メニューホスト>
    <p class="文書説明">@(表示文言.取得("管理接続と通信予算、参照監査の設定をサーバーへ保存します。"))</p>
    @if(案内.Length>0){<div class="状態通知" role="status" data-エラー="@エラーか.ToString().ToLowerInvariant()">@案内</div>}
    @if(情報 is{} 現在){
        <div class="設定稼働情報"><div>@if(現在.ExecutionMode==ManagementExecutionMode.Embedded){<small>@(表示文言.取得("実行形態"))</small><strong>@(表示文言.取得("組み込み同期"))</strong>}else{<small>@(表示文言.取得("管理TCP · 実行中"))</small><strong>@現在.Running.Address · @現在.ActualTcpPort</strong>}</div><div><small>@(表示文言.取得("ブラウザー · 実行中"))</small><strong>@現在.ManagerOrigin</strong></div><div><small>@(表示文言.取得("プロセス"))</small><strong>PID @現在.ProcessId</strong></div><div><small>@(表示文言.取得("保存版"))</small><strong>v@(現在.Version)@if(現在.RestartRequired){@(" "+表示文言.取得("· 再起動待ち"))}</strong></div></div>
        <details class="設定保存先"><summary>@(表示文言.取得("管理領域と起動元"))</summary><dl><dt>@表示文言.取得("管理領域")</dt><dd>@現在.Root</dd><dt>@表示文言.取得("証明書")</dt><dd>@現在.Certificate</dd><dt>@表示文言.取得("起動ファイル")</dt><dd>@現在.ConfigurationFile</dd><dt>@表示文言.取得("起動引数の指定")</dt><dd>@string.Join(", ",現在.CommandLineOverrides.Select(項目=>表示文言.取得(項目名(項目))))</dd></dl></details>
        @if(現在.ExecutionMode==ManagementExecutionMode.Embedded){<p class="小案内">@(表示文言.取得("ローカルManagerと参照監査を設定できます。ネイティブTCPと外部受付の設定はサーバー型で編集します。"))</p>}
        <form @onsubmit="保存Async" @onsubmit:preventDefault>
            <div class="設定見出し"><h2>@(表示文言.取得("次回起動時の設定"))</h2><button type="button" class="控えめボタン" disabled="@処理中か" @onclick="再取得Async"><操作アイコン 種類="最新の設定を取得"/>@(表示文言.取得("最新の設定を取得"))</button></div>
            @if(現在.CommandLineOverrides.Length>0){<p class="小案内">@(表示文言.取得("起動引数で指定した項目は読み取り専用です。"))</p>}
            <fieldset class="設定入力枠" disabled="@処理中か"><legend>@(表示文言.取得("接続"))</legend><div class="設定入力一覧">
                <label>@(表示文言.取得("管理TCPのIPアドレス"))<input aria-label="@表示文言.取得("管理TCPのIPアドレス")" @bind:get="編集値.Address" @bind:set="値=>値変更時Async(編集値 with{Address=値})" @bind:event="oninput" readonly="@固定か(nameof(ManagementServerSettings.Address))" required/></label>
                <label>@(表示文言.取得("管理TCPのポート"))<input type="number" aria-label="@表示文言.取得("管理TCPのポート")" @bind:get="編集値.Port" @bind:set="値=>値変更時Async(編集値 with{Port=値})" @bind:event="oninput" readonly="@固定か(nameof(ManagementServerSettings.Port))" min="0" max="65535" required/></label>
                <label>@(表示文言.取得("ローカルManagerのポート"))<input type="number" aria-label="@表示文言.取得("ローカルManagerのポート")" @bind:get="編集値.ManagerPort" @bind:set="値=>値変更時Async(編集値 with{ManagerPort=値})" @bind:event="oninput" readonly="@固定か(nameof(ManagementServerSettings.ManagerPort))" min="0" max="65535" required/></label>
            </div><p class="小案内">@(表示文言.取得("ポート0は自動割り当てです。ローカルManagerは同じPCから接続できます。"))</p></fieldset>
            <details @key="@("budget-"+設定展開世代)" class="設定詳細" open="@通信予算展開か"><summary>@(表示文言.取得("通信予算"))</summary><fieldset class="設定入力枠" disabled="@処理中か"><div class="設定入力一覧">
                <label>@(表示文言.取得("受信バッファ予算（バイト）"))<input type="number" aria-label="@表示文言.取得("受信バッファ予算")" placeholder="@表示文言.取得("既定")" @bind:get="編集値.MaximumBufferedRequestBytes" @bind:set="値=>値変更時Async(編集値 with{MaximumBufferedRequestBytes=値})" @bind:event="oninput" readonly="@固定か(nameof(ManagementServerSettings.MaximumBufferedRequestBytes))" min="1"/></label>
                <label>@(表示文言.取得("送信待ち予算（バイト）"))<input type="number" aria-label="@表示文言.取得("送信待ち予算")" placeholder="@表示文言.取得("既定")" @bind:get="編集値.MaximumPendingWriteBytes" @bind:set="値=>値変更時Async(編集値 with{MaximumPendingWriteBytes=値})" @bind:event="oninput" readonly="@固定か(nameof(ManagementServerSettings.MaximumPendingWriteBytes))" min="1"/></label>
                <label>@(表示文言.取得("応答送信期限（ミリ秒）"))<input type="number" aria-label="@表示文言.取得("応答送信期限")" placeholder="@表示文言.取得("既定")" @bind="応答期限ミリ秒" @bind:event="oninput" @bind:after="変更通知Async" readonly="@固定か(nameof(ManagementServerSettings.ResponseWriteTimeout))" min="1" max="4294967294"/></label>
            </div></fieldset></details>
            <fieldset class="設定入力枠" disabled="@処理中か"><legend>@(表示文言.取得("参照監査"))</legend><label class="設定チェック"><input type="checkbox" aria-label="@表示文言.取得("参照監査を有効にする")" @bind:get="編集値.ReadAuditEnabled" @bind:set="値=>値変更時Async(編集値 with{ReadAuditEnabled=値})" disabled="@固定か(nameof(ManagementServerSettings.ReadAuditEnabled))"/>@(表示文言.取得("参照監査を有効にする"))</label><div class="設定入力一覧">
                <label>@(表示文言.取得("集計期間（秒）"))<input type="number" aria-label="@表示文言.取得("参照監査の集計期間")" @bind:get="編集値.ReadAuditWindowSeconds" @bind:set="値=>値変更時Async(編集値 with{ReadAuditWindowSeconds=値})" @bind:event="oninput" readonly="@固定か(nameof(ManagementServerSettings.ReadAuditWindowSeconds))" min="1" max="86400" required/></label>
                <label>@(表示文言.取得("保存間隔（秒）"))<input type="number" aria-label="@表示文言.取得("参照監査の保存間隔")" @bind:get="編集値.ReadAuditSaveSeconds" @bind:set="値=>値変更時Async(編集値 with{ReadAuditSaveSeconds=値})" @bind:event="oninput" readonly="@固定か(nameof(ManagementServerSettings.ReadAuditSaveSeconds))" min="0.01" max="86400" step="0.01" required/></label>
            </div><p class="小案内">@表示文言.取得("実行中の集計期間 {0} 秒 · 保存間隔 {1} 秒",現在.Running.ReadAuditWindowSeconds,現在.Running.ReadAuditSaveSeconds)</p></fieldset>
            <details @key="@("external-"+設定展開世代)" class="設定詳細" open="@外部受付展開か"><summary>@(表示文言.取得("外部ブラウザーの受付"))</summary><fieldset class="設定入力枠" disabled="@処理中か"><label class="設定チェック"><input type="checkbox" aria-label="@表示文言.取得("外部Managerを有効にする")" checked="@(編集値.ExternalManagerOrigin is not null)" @onchange="外部変更時Async" disabled="@固定か(nameof(ManagementServerSettings.ExternalManagerOrigin))"/>@(表示文言.取得("外部Managerを有効にする"))</label>
                @if(編集値.ExternalManagerOrigin is not null){<div class="設定入力一覧"><label>@(表示文言.取得("HTTPSの公開起点"))<input aria-label="@表示文言.取得("外部ManagerのHTTPS起点")" @bind:get="編集値.ExternalManagerOrigin" @bind:set="値=>値変更時Async(編集値 with{ExternalManagerOrigin=値})" @bind:event="oninput" readonly="@固定か(nameof(ManagementServerSettings.ExternalManagerOrigin))" required/></label><label>@(表示文言.取得("待受けIPアドレス"))<input aria-label="@表示文言.取得("外部ManagerのIPアドレス")" @bind:get="編集値.ExternalManagerAddress" @bind:set="値=>値変更時Async(編集値 with{ExternalManagerAddress=値})" @bind:event="oninput" readonly="@固定か(nameof(ManagementServerSettings.ExternalManagerAddress))" required/></label></div><p class="小案内">@(表示文言.取得("HTTPSと利用者ごとの認証・認可を使います。"))</p>}
            </fieldset></details>
            <div class="設定保存操作"><button type="button" class="控えめボタン" disabled="@処理中か" @onclick="取消時Async"><操作アイコン 種類="編集を取り消す"/>@(表示文言.取得("編集を取り消す"))</button><button type="submit" class="主要ボタン" disabled="@(処理中か||!編集ありか)"><操作アイコン 種類="保存（再起動時に反映）"/>@(表示文言.取得("保存（再起動時に反映）"))</button></div>
        </form>
        <復元の手順ビュー/>
    }else if(読込中か){<p role="status">@(表示文言.取得("設定を読み込み中…"))</p>}
</section>
