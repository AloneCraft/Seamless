<section class="表入力カード" aria-label="@表示文言.取得("問い合わせの下書き")">
    <h3>@表示文言.取得("{0}の下書き",表示文言.取得(種類名))</h3>
    <div class="名前入力列">
        <label>@(表示文言.取得("名前"))<input aria-label="@表示文言.取得("問い合わせ名")" @bind="名前" @bind:event="oninput" @bind:after="入力を通知Async" readonly="@(定義.OriginalPath is not null)"/></label>
        @if(定義.Kind!=DatabaseQueryKind.View){<label>@(表示文言.取得("戻り型"))<型入力 ラベル="戻り型" 値="@戻り型" 候補="型候補" 値変更時="async 型=>{戻り型=型;await 入力を通知Async();}"/></label>}
    </div>
    @if(定義.Kind!=DatabaseQueryKind.View){
        <h4>@(表示文言.取得("引数"))</h4><編集グリッド 名前="関数の引数">
            <見出し><th class="行操作列"></th><th>@(表示文言.取得("名前"))</th><th>@(表示文言.取得("C#型"))</th></見出し>
            <行>
            @foreach(var 引数 in 引数一覧){<tr @key="引数"><td class="行操作列"><行操作 名前="@表示文言.取得("{0}引数",引数.名前)" 前へ追加時="async()=>{引数一覧.Insert(引数一覧.IndexOf(引数),new());await 入力を通知Async();}" 後へ追加時="async()=>{引数一覧.Insert(引数一覧.IndexOf(引数)+1,new());await 入力を通知Async();}" 削除時="async()=>{引数一覧.Remove(引数);await 入力を通知Async();}"/></td><td><input aria-label="@表示文言.取得("引数名")" @bind="引数.名前" @bind:event="oninput" @bind:after="入力を通知Async"/></td><td><型入力 ラベル="引数の型" 値="@引数.型" 値変更時="async 型=>{引数.型=型;await 入力を通知Async();}" 候補="型候補"/></td></tr>}
            </行>
        </編集グリッド><button class="テキストボタン" @onclick="async()=>{引数一覧.Add(new());await 入力を通知Async();}"><操作アイコン 種類="引数を追加"/>@(表示文言.取得("引数を追加"))</button>
    }
    @* ビューとテーブル関数の行の型は、表の列と同じく画面で編集する(I11)。処理本体はこの行の型を返す。 *@
    @if(定義.Kind==DatabaseQueryKind.View||DatabaseDesigner.FunctionElementType(戻り型) is not null){
        <h4>@(表示文言.取得("結果列"))</h4><編集グリッド 名前="問い合わせの結果列">
            <見出し><th class="行操作列"></th><th>@(表示文言.取得("列名"))</th><th>@(表示文言.取得("C#型"))</th></見出し>
            <行>
            @foreach(var 列 in 列一覧){<tr @key="列"><td class="行操作列"><行操作 名前="@表示文言.取得("{0}結果列",列.名前)" 前へ追加時="async()=>{列一覧.Insert(列一覧.IndexOf(列),new());await 入力を通知Async();}" 後へ追加時="async()=>{列一覧.Insert(列一覧.IndexOf(列)+1,new());await 入力を通知Async();}" 削除時="async()=>{列一覧.Remove(列);await 入力を通知Async();}"/></td><td><input aria-label="@表示文言.取得("結果列名")" @bind="列.名前" @bind:event="oninput" @bind:after="入力を通知Async"/></td><td><型入力 ラベル="結果列の型" 値="@列.型" 候補="型候補" 値変更時="async 型=>{列.型=型;await 入力を通知Async();}"/></td></tr>}
            </行>
        </編集グリッド><button class="テキストボタン" @onclick="async()=>{列一覧.Add(new());await 入力を通知Async();}"><操作アイコン 種類="結果列を追加"/>@(表示文言.取得("結果列を追加"))</button>
    }
    <div class="処理本体ラベル">@(表示文言.取得("C#処理本体"))<コードエディター ラベル="C#処理本体" 行数="8" 値="@本体" 値変更時="async 値=>{本体=値;await 入力を通知Async();}"/></div>
    @if(定義.Kind==DatabaseQueryKind.View){<p class="小案内">@表示文言.取得("処理本体は、結果列の行の型の集合を返してください。")</p>}
    else{<p class="小案内">@表示文言.取得("戻り型を ISet<行の型> にするとテーブル関数になり、結果列を編集できます。")</p>}
    <p class="小案内">@(表示文言.取得("container からDB直下と各スキーマを参照できます。"))</p>
    <div class="表入力操作"><span></span><button class="控えめボタン" @onclick="取消時"><操作アイコン 種類="取消"/>@(表示文言.取得("取消"))</button><button class="主要ボタン" @onclick="反映時Async"><操作アイコン 種類="下書きに反映"/>@(表示文言.取得("下書きに反映"))</button></div>
</section>
@code{
    [Parameter,EditorRequired]public QueryDesign 定義{get;set;}=default!;
    [Parameter]public IEnumerable<string> 型候補{get;set;}=[];
    [Parameter]public EventCallback<QueryDesign> 確定時{get;set;}
    [Parameter]public EventCallback<QueryDesign> 入力変更時{get;set;}
    [Parameter]public EventCallback 取消時{get;set;}
    private QueryDesign? 読み込んだ定義;
    private string 名前="",戻り型="int",本体="";
    private readonly List<入力> 引数一覧=[],列一覧=[];
    private string 種類名{get{if(this.定義.Kind==DatabaseQueryKind.View){return "ビュー";}return "関数";}}
    protected override void OnParametersSet(){
        if(ReferenceEquals(this.定義,this.読み込んだ定義)){return;}
        this.読み込んだ定義=this.定義;this.名前=this.定義.Name;this.戻り型=this.定義.ReturnType;this.本体=this.定義.Body;
        this.引数一覧.Clear();this.引数一覧.AddRange(this.定義.Parameters.Select(引数=>new 入力{名前=引数.Name,型=引数.Type}));
        this.列一覧.Clear();this.列一覧.AddRange(this.定義.Columns.Select(列=>new 入力{名前=列.Name,型=列.Type}));
    }
    private QueryDesign 入力内容(){
        var 種類=this.定義.Kind;
        if(種類!=DatabaseQueryKind.View){種類=DatabaseQueryKind.ScalarFunction;if(DatabaseDesigner.FunctionElementType(this.戻り型) is not null){種類=DatabaseQueryKind.TableFunction;}}
        return this.定義 with{Kind=種類,Name=this.名前,ReturnType=this.戻り型,Body=this.本体,Parameters=this.引数一覧.Select(引数=>new ParameterDesign(引数.名前,引数.型)).ToArray(),Columns=this.列一覧.Select(列=>new ColumnDesign(列.名前,列.型,false)).ToArray()};
    }
    private Task 反映時Async()=>this.確定時.InvokeAsync(this.入力内容());
    private Task 入力を通知Async(){
        if(!this.入力変更時.HasDelegate){return Task.CompletedTask;}
        var 入力=this.入力内容();this.読み込んだ定義=入力;return this.入力変更時.InvokeAsync(入力);
    }
    private sealed class 入力{public string 名前{get;set;}="Column";public string 型{get;set;}="int";}
}
