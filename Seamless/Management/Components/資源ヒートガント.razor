@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime スクリプト
<link rel="stylesheet" href="_content/Seamless.Management.Components/resource-heat.css"/>
<link rel="stylesheet" href="_content/Seamless.Management.Components/execution-plan.css"/>
<section @ref="根" class="資源ヒートガント 計画グラフ" aria-label="@表示文言.取得("資源使用ヒートガント")">
    <h3>@表示文言.取得("資源使用ヒートガント")</h3>
    <div class="計画グラフ操作">
        <グラフ表示操作/>
        <label>@表示文言.取得("帰属範囲")<select aria-label="@表示文言.取得("資源の帰属範囲")" @bind="範囲" @bind:after="再配置">@foreach(var scope in new[]{"Host","Process","Query","Node"}){<option value="@scope">@表示文言.取得(範囲名(scope))</option>}</select></label>
        <label>@表示文言.取得("資源の種類")<select aria-label="@表示文言.取得("資源の種類")" @bind="種類" @bind:after="再配置"><option value="">@表示文言.取得("すべて")</option>@foreach(var kind in this.記録?.Lanes.Select(lane=>lane.Kind).Distinct(StringComparer.Ordinal)??[]){<option value="@kind">@kind</option>}</select></label>
        <label>@表示文言.取得("配色")<select aria-label="@表示文言.取得("ヒートマップの配色")" @bind="配色"><option value="Continuous">@表示文言.取得("連続")</option><option value="Steps">@表示文言.取得("段階")</option><option value="Mono">@表示文言.取得("モノクロ")</option><option value="Accessible">@表示文言.取得("色覚対応")</option></select></label>
        <label><input type="checkbox" @bind="数値か"/>@表示文言.取得("数値を重ねる")</label>
        <label><input type="checkbox" @bind="折線か"/>@表示文言.取得("観測窓の折線を重ねる")</label>
        <label>@表示文言.取得("ノードを検索")<input type="search" value="@this.検索" @oninput="this.検索時Async"/></label>
        <button type="button" class="控えめボタン" @onclick="()=>this.倍率=Math.Clamp(this.倍率*1.5,1,8)">@表示文言.取得("拡大")</button><button type="button" class="控えめボタン" @onclick="()=>this.倍率=1">@表示文言.取得("全体表示")</button>
    </div>
    <div class="ヒート再生操作">
        <button type="button" class="控えめボタン" disabled="@(this.配置 is null||!this.表示中か)" @onclick="this.再生切替時Async">@表示文言.取得(this.再生名)</button>
        <label>@表示文言.取得("再生速度")<select value="@数(this.再生速度)" @onchange="this.速度変更時Async">@foreach(var speed in new[]{0.25,0.5,1,2,4,8}){<option value="@数(speed)">@数(speed)×</option>}</select></label>
        <button type="button" class="控えめボタン" @onclick="this.全時間時Async">@表示文言.取得("全時間範囲")</button>
    </div>
    <p class="小案内">@表示文言.取得("ホスト全体、プロセス、クエリ寄与、ノード寄与を区別します。色は各レーンの百分率の分母に従います。")</p>
    @if(this.エラー is not null){<p role="alert">@this.エラー</p>}
    else if(this.記録 is not{} 記録||this.配置 is not{} 図){<p role="status">@表示文言.取得("資源サンプルは未収集です。次回の実行で資源計測を指定できます。")</p>}
    else{
        <p class="小案内">@表示文言.取得("実行ID") @記録.ExecutionId · @表示文言.取得("収集間隔") @記録.RequestedInterval.TotalMilliseconds.ToString("0.###") ms · @記録.Clock.Id · @記録.Clock.TicksPerSecond @表示文言.取得("ticks/秒")</p>
        @if(記録.DroppedSamples>0){<p role="status">@表示文言.取得("欠落サンプル {0}",記録.DroppedSamples)</p>}
        @if(図.非対応時計区間数>0){<p role="status">@表示文言.取得("共通時計への対応が不明な実行区間 {0}",図.非対応時計区間数)</p>}
        @if(図.表示省略数>0){<p role="status">@表示文言.取得("表示上限によるサンプル省略 {0}",図.表示省略数)</p>}
        @if(図.レーン.Length==0){<p role="status">@表示文言.取得("この帰属範囲の資源レーンは未収集です。")</p>}
        @if(this.選択ノード is not null&&!図.サンプル.Any(sample=>sample.値.Node==this.選択ノード)){<p role="status">@表示文言.取得("選択ノードへ帰属する資源サンプルは未収集です。")</p>}
        <div class="計画グラフ画面 ヒート画面" tabindex="0" aria-label="@表示文言.取得("資源使用の共通時間軸")">
            <div class="ヒート固定軸" style="@($"width:{数(this.倍率*100)}%")"><svg viewBox="@($"0 0 {資源ヒート配置.幅} 36")" role="img" aria-label="@表示文言.取得("共通の経過時間軸")">
                @for(var index=0;index<=5;index++){
                    var x=資源ヒート配置.左端+資源ヒート配置.描画幅*index/5d;var time=(decimal)図.開始+((decimal)図.終了-図.開始)*index/5;
                    <g class="ヒート軸"><text x="@数(x)" y="22">@経過表示(time,記録.Clock) ms</text></g>
                }
            </svg></div>
            <svg viewBox="@($"0 0 {資源ヒート配置.幅} {図.高さ}")" style="@($"width:{数(this.倍率*100)}%")" role="img" aria-label="@表示文言.取得("クエリ区間と資源サンプル")">
                <title>@表示文言.取得("クエリ区間と資源サンプル")</title>
                @for(var index=0;index<=5;index++){
                    var x=資源ヒート配置.左端+資源ヒート配置.描画幅*index/5d;
                    <g class="ヒート軸"><path d="@($"M{数(x)} 35 V{図.高さ-20}")"/></g>
                }
                @foreach(var interval in 図.実行区間){
                    <g class="ヒート実行" data-区間="@interval.値.Id" data-選択中="@選択か(interval.値.Node).ToString().ToLowerInvariant()" @onclick="()=>選択時Async(interval.値.Node)"><title>@interval.値.Scope · @interval.値.InstanceId</title><text x="8" y="@(interval.Y+15)">@interval.値.LaneId</text><rect x="@数(interval.X)" y="@interval.Y" width="@数(interval.幅)" height="18"/></g>
                }
                @foreach(var lane in 図.レーン){
                    <g class="ヒートレーン" data-レーン="@lane.値.Id" data-親="@lane.値.ParentId"><text x="8" y="@(lane.Y+14)"><title>@レーン説明(lane.値)</title>@lane.値.Label</text><path d="@($"M{資源ヒート配置.左端} {lane.Y+21} H{資源ヒート配置.左端+資源ヒート配置.描画幅}")"/></g>
                }
                @foreach(var sample in 図.サンプル){
                    <g class="@サンプルクラス(sample)" data-状態="@sample.値.State" data-出所="@sample.値.Evidence" data-帰属="@sample.レーン.Scope" data-選択中="@選択か(sample.値.Node).ToString().ToLowerInvariant()" @onclick="()=>選択時Async(sample.値.Node)">
                        <title>@サンプル説明(sample)</title>
                        @if(sample.値.Aggregation=="Instant"||sample.幅==0){<path d="@($"M{数(sample.X)} {sample.Y+1} l5 8 -5 8 -5 -8 Z")" style="@($"fill:{サンプル色(sample.値)}")"/>}
                        else{<rect x="@数(sample.X)" y="@(sample.Y+1)" width="@数(sample.幅)" height="18" style="@($"fill:{サンプル色(sample.値)}")"/>}
                        @if(this.数値か&&sample.幅>=35&&sample.値.Percent is{} percent){<g><text class="ヒート数値" x="@数(sample.X+sample.幅/2)" y="@(sample.Y+14)">@percent.ToString("0.#")%</text></g>}
                    </g>
                }
                @if(this.折線か&&this.折線 is{} 折線){
                    @foreach(var line in 折線.区間){<path class="ヒート折線" d="@line.経路"><title>@line.レーンID · @line.最小値 → @line.最大値 @line.単位</title></path>}
                    @foreach(var point in 折線.点){<circle class="ヒート折線点" cx="@数(point.X)" cy="@数(point.Y)" r="2.5"><title>@point.レーンID · @point.値 @point.単位</title></circle>}
                }
                <g class="ヒートカーソル"><path d="@($"M{数(資源ヒート配置.左端+資源ヒート配置.描画幅*this.時刻位置/1000d)} 35 V{図.高さ-20}")"/></g>
            </svg>
        </div>
        <label class="ヒート時刻">@表示文言.取得("表示時刻")<input type="range" min="0" max="1000" step="1" value="@this.時刻位置" @oninput="this.時刻変更時Async"/></label>
        <div class="ヒート時間選択">
            <label>@表示文言.取得("表示範囲の開始")<input type="range" min="0" max="999" value="@this.選択開始位置" @oninput="this.開始変更時Async"/></label>
            <label>@表示文言.取得("表示範囲の終了")<input type="range" min="1" max="1000" value="@this.選択終了位置" @oninput="this.終了変更時Async"/></label>
        </div>
        @if(this.折線か){<p class="小案内">@表示文言.取得("折線は各レーンの独立尺度です。観測窓の値だけを結び、欠落区間を補間しません。時点観測は点で表示します。")</p>}
        <div class="ヒート凡例">@foreach(var percent in new[]{0,20,40,60,80,95,100}){<span><i style="@($"background:{資源ヒート配置.色(percent,this.配色)}")"></i>@percent%</span>}<span>@表示文言.取得("不明・未対応・欠落は状態と理由で区別します。")</span></div>
        <p class="小案内">@表示文言.取得("帯は観測窓、ひし形は時点観測です。窓の外は未観測です。100%を超える値は数値に残し、配色は100%を上限とします。")</p>
        <details><summary>@表示文言.取得("指標・百分率の分母・トポロジー")</summary>@foreach(var lane in 図.レーン){<p><strong>@lane.値.Label</strong> · @lane.値.Scope · @lane.値.Metric · @lane.値.Unit<br/>@レーン説明(lane.値)</p>}</details>
        @if(記録.Persistence is{} 保存){<p role="status">@表示文言.取得("資源記録の状態") · @表示文言.取得(保存状態名(保存.State)) @保存.Reason</p>}
        @if(記録.Diagnostics.Length>0){<details><summary>@表示文言.取得("収集診断 {0} 件",記録.Diagnostics.Length)</summary>@foreach(var diagnostic in 記録.Diagnostics){<p title="@diagnostic">@診断表示(diagnostic)</p>}</details>}
    }
</section>

@code{
    [Parameter]public ResourceHeatTrace? 記録{get;set;}
    [Parameter]public QueryVisualizationData? 実行データ{get;set;}
    [Parameter]public PlanNodeRef? 選択ノード{get;set;}
    [Parameter]public EventCallback<PlanNodeRef?> 選択時{get;set;}
    [Parameter]public string 検索{get;set;}="";
    [Parameter]public EventCallback<string> 検索変更時{get;set;}
    [Parameter]public bool 表示中か{get;set;}=true;
    [Parameter]public PlanSnapshotHeatSettings? 初期保存設定{get;set;}
    public PlanSnapshotHeatSettings 保存設定=>new(this.範囲,this.種類,this.配色,this.数値か,this.倍率,this.時刻位置){Overlay=this.折線か,PlaybackSpeed=this.再生速度,RangeStart=this.範囲開始,RangeEnd=this.範囲終了};
    private PlanSnapshotHeatSettings? 適用済み設定;
    private string 範囲="Host",種類="",配色="Continuous";
    private bool 数値か,破棄済みか;
    private double 倍率=1;
    private int 時刻位置;
    private bool 折線か;
    private double 再生速度=1;
    private long? 範囲開始,範囲終了;
    private int 選択開始位置,選択終了位置=1000;
    private 資源ヒート配置? 全配置;
    private 資源折線配置? 折線;
    private ResourceHeatTrace? 前記録;
    private CancellationTokenSource? 再生取消;
    private Task 再生タスク=Task.CompletedTask;
    private string 再生名{get{if(this.再生取消 is null){return "再生";}return "停止";}}
    private 資源ヒート配置? 配置;
    private string? エラー;
    private ElementReference 根;
    private IJSObjectReference? モジュール,表示操作;
    private readonly SemaphoreSlim 初期化=new(1,1);
    protected override void OnParametersSet(){
        if(!ReferenceEquals(this.前記録,this.記録)){this.前記録=this.記録;this.再生取消?.Cancel();this.範囲開始=null;this.範囲終了=null;this.適用済み設定=null;}
        if(!this.表示中か){this.再生取消?.Cancel();}
        if(this.初期保存設定 is{} 設定&&設定!=this.適用済み設定){this.適用済み設定=設定;this.範囲=設定.Scope;this.種類=設定.Kind;this.配色=設定.Palette;this.数値か=設定.ShowNumbers;this.倍率=設定.Zoom;this.時刻位置=設定.Cursor;this.折線か=設定.Overlay;this.再生速度=設定.PlaybackSpeed;this.範囲開始=設定.RangeStart;this.範囲終了=設定.RangeEnd;}
        this.再配置();
    }
    private void 再配置(){
        this.配置=null;this.全配置=null;this.折線=null;this.エラー=null;if(this.記録 is null){return;}
        try{
            string? kind=null;if(this.種類.Length>0){kind=this.種類;}
            this.全配置=資源ヒート配置.作成(this.記録,this.実行データ,this.範囲,kind);
            this.配置=資源ヒート配置.作成(this.記録,this.実行データ,this.範囲,kind,this.範囲開始,this.範囲終了);this.折線=資源折線配置.作成(this.配置);
            var 長さ=Math.Max(1m,(decimal)this.全配置.終了-this.全配置.開始);
            this.選択開始位置=(int)(((decimal)this.配置.開始-this.全配置.開始)*1000/長さ);this.選択終了位置=1000;
            if(this.範囲終了 is{} 終了){this.選択終了位置=Math.Clamp((int)(((decimal)終了-this.全配置.開始)*1000/長さ),1,1000);}
            this.選択開始位置=Math.Clamp(this.選択開始位置,0,this.選択終了位置-1);
        }catch(InvalidDataException exception){this.エラー=exception.Message;}
    }
    private async Task 再生切替時Async(){
        if(this.再生取消 is not null){await this.停止Async();return;}
        if(this.配置 is not{} 図||this.記録 is not{} 記録||!this.表示中か||this.破棄済みか){return;}
        if(this.時刻位置>=1000){this.時刻位置=0;}
        var 取消=new CancellationTokenSource();this.再生取消=取消;this.再生タスク=this.再生Async(図,記録.Clock.TicksPerSecond,this.時刻位置,this.再生速度,取消);
    }
    private async Task 再生Async(資源ヒート配置 図,long 周波数,int 開始位置,double 速度,CancellationTokenSource 取消){
        var 開始=System.Diagnostics.Stopwatch.GetTimestamp();using var 時計=new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        try{
            while(await 時計.WaitForNextTickAsync(取消.Token)){
                var 秒=System.Diagnostics.Stopwatch.GetElapsedTime(開始).TotalSeconds;
                var 位置=資源折線配置.再生位置(開始位置,秒,速度,図.開始,図.終了,周波数);
                await this.InvokeAsync(()=>{if(!this.破棄済みか&&!取消.IsCancellationRequested){this.時刻位置=位置;this.StateHasChanged();}});
                if(位置>=1000){break;}
            }
        }catch(OperationCanceledException)when(取消.IsCancellationRequested){}
        finally{if(ReferenceEquals(this.再生取消,取消)){this.再生取消=null;}取消.Dispose();if(!this.破棄済みか){await this.InvokeAsync(this.StateHasChanged);}}
    }
    private async Task 停止Async(){this.再生取消?.Cancel();await this.再生タスク;}
    private async Task 速度変更時Async(ChangeEventArgs 値){await this.停止Async();if(double.TryParse(値.Value?.ToString(),NumberStyles.Float,CultureInfo.InvariantCulture,out var 速度)&&速度 is 0.25 or 0.5 or 1 or 2 or 4 or 8){this.再生速度=速度;}}
    private async Task 時刻変更時Async(ChangeEventArgs 値){await this.停止Async();if(int.TryParse(値.Value?.ToString(),out var 位置)){this.時刻位置=Math.Clamp(位置,0,1000);}}
    private async Task 全時間時Async(){await this.停止Async();this.範囲開始=null;this.範囲終了=null;this.時刻位置=0;this.再配置();}
    private async Task 開始変更時Async(ChangeEventArgs 値){if(int.TryParse(値.Value?.ToString(),out var 位置)){await this.時間範囲変更Async(Math.Clamp(位置,0,this.選択終了位置-1),this.選択終了位置);}}
    private async Task 終了変更時Async(ChangeEventArgs 値){if(int.TryParse(値.Value?.ToString(),out var 位置)){await this.時間範囲変更Async(this.選択開始位置,Math.Clamp(位置,this.選択開始位置+1,1000));}}
    private async Task 時間範囲変更Async(int 開始,int 終了){
        await this.停止Async();if(this.全配置 is not{} 図){return;}
        long Tick(int 位置)=>(long)decimal.Round(図.開始+((decimal)図.終了-図.開始)*位置/1000);
        this.範囲開始=Tick(開始);this.範囲終了=Tick(終了);this.時刻位置=0;this.再配置();
    }
    private bool 選択か(PlanNodeRef? value)=>value is not null&&value==this.選択ノード;
    private Task 選択時Async(PlanNodeRef? value){if(value is null){return Task.CompletedTask;}return this.選択時.InvokeAsync(value);}
    private static string 保存状態名(string 状態)=>状態 switch{"Queued"=>"保存待ち","Saved"=>"保存済み","Dropped"=>"記録を破棄","Failed"=>"保存失敗",_=>"未収集"};
    private static string 診断表示(string 診断){
        var 表示=診断;
        if(診断.StartsWith("ResponseOnly:",StringComparison.Ordinal)){表示="この記録は実行結果の応答だけに保持されています。";}
        else if(診断.StartsWith("Host and process counters",StringComparison.Ordinal)){表示="ホストとプロセスの観測には同時実行された別の処理も含まれます。クエリ・ノードへの寄与は推定していません。";}
        else if(診断.StartsWith("Collection overhead",StringComparison.Ordinal)){表示="観測コストを経過時間に含みます。実際の観測窓とOSカウンターの分解能を確認してください。";}
        else if(診断=="NotImplemented: PCIe utilization, NUMA bandwidth and hardware performance counters are not collected."){表示="PCIe使用率、NUMA帯域、ハードウェア性能カウンターは未収集です。";}
        else if(診断.StartsWith("Topology describes",StringComparison.Ordinal)){表示="トポロジーはこのOS環境の情報です。仮想資源とOSのメモリ領域を物理ホストの構成として扱いません。";}
        else if(診断.StartsWith("SampleLimit:",StringComparison.Ordinal)){表示="収集件数の上限に達した後の観測は省略されています。";}
        else if(診断.StartsWith("ResponseLimit:",StringComparison.Ordinal)){表示="応答の容量上限に合わせて資源資料を省略しました。";}
        return 表示文言.取得(表示);
    }
    private Task 検索時Async(ChangeEventArgs value)=>this.検索変更時.InvokeAsync(value.Value?.ToString()??"");
    private string サンプルクラス(資源サンプル配置 value){var name="ヒートサンプル";if(value.値.State!="Available"){name+=" ヒート欠測 ヒート"+value.値.State;}if(!string.IsNullOrWhiteSpace(this.検索)&&(value.レーン.Label.Contains(this.検索,StringComparison.OrdinalIgnoreCase)||value.値.Node?.NodeId.Contains(this.検索,StringComparison.OrdinalIgnoreCase)==true)){name+=" ヒート一致";}return name;}
    private string サンプル色(ResourceSample value){if(value.State!="Available"||value.Percent is null){return "#dfe5e4";}return 資源ヒート配置.色(value.Percent.Value,this.配色);}
    private static string レーン説明(ResourceLane lane){var text=lane.Metric+" · "+lane.Unit;if(lane.PercentBasis is{} basis){text+=" · "+basis.Description+" · "+basis.Capacity+" "+basis.Unit+" · "+basis.Source;}if(lane.Topology is not null){text+=" · "+string.Join(" · ",lane.Topology.Select(pair=>pair.Key+"="+pair.Value));}return text;}
    private static string サンプル説明(資源サンプル配置 value){var sample=value.値;var text=value.レーン.Label+" · "+sample.State+" · "+sample.Evidence+" · "+sample.Aggregation+" · "+sample.StartTimestamp+" → "+sample.EndTimestamp;if(sample.Value is{} amount){text+=" · "+amount.ToString("0.###",CultureInfo.CurrentCulture)+" "+value.レーン.Unit;}if(sample.Percent is{} percent){text+=" · "+percent.ToString("0.###",CultureInfo.CurrentCulture)+"%";}if(sample.MissingReason is{} reason){text+=" · "+reason;}return text+" · "+レーン説明(value.レーン);}
    private static string 経過表示(decimal timestamp,ResourceHeatClock clock)=>((timestamp-clock.AnchorTimestamp)/clock.TicksPerSecond*1000).ToString("0.###",CultureInfo.CurrentCulture);
    private static string 範囲名(string value)=>value switch{"Host"=>"システム全体","Process"=>"プロセス全体","Query"=>"クエリ寄与","Node"=>"ノード寄与",_=>value};
    private static string 数(double value)=>value.ToString("0.###",CultureInfo.InvariantCulture);
    protected override async Task OnAfterRenderAsync(bool firstRender){await this.初期化.WaitAsync();try{if(this.破棄済みか||this.表示操作 is not null){return;}this.モジュール=await this.スクリプト.InvokeAsync<IJSObjectReference>("import","./_content/Seamless.Management.Components/execution-plan.js");this.表示操作=await this.モジュール.InvokeAsync<IJSObjectReference>("グラフ表示を初期化",this.根);}catch(JSDisconnectedException){}finally{this.初期化.Release();}}
    public async ValueTask DisposeAsync(){if(this.破棄済みか){return;}this.破棄済みか=true;await this.停止Async();await this.初期化.WaitAsync();try{await スクリプト参照.解放Async(this.表示操作,this.モジュール);}finally{this.初期化.Release();}}
}
