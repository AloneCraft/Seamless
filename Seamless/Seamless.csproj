<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Seamless</RootNamespace>
    <AssemblyName>Seamless</AssemblyName>
    <PackageId>Seamless</PackageId>
    <Title>Seamless</Title>
    <Description>Convenience entry package for Seamless runtime, collections, LINQ, and database generation.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Seamless.Abstractions\Seamless.Abstractions.csproj" />
    <ProjectReference Include="..\Seamless.Serialization\Seamless.Serialization.csproj" />
    <ProjectReference Include="..\Seamless.Linq\Seamless.Linq.csproj" />
    <ProjectReference Include="..\Seamless.Collections.Persisted\Seamless.Collections.Persisted.csproj" />
    <ProjectReference Include="..\Seamless.Collections.Tsavorite\Seamless.Collections.Tsavorite.csproj" />
    <ProjectReference Include="..\Seamless.SourceGenerator\Seamless.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\Seamless.Database\Seamless.Database.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <PropertyGroup>
    <SeamlessGenerateLinqEnumerable>true</SeamlessGenerateLinqEnumerable>
    <SeamlessLinqEnumerableNamespace>Seamless.Linq</SeamlessLinqEnumerableNamespace>
    <SeamlessLinqEnumerableSourceType>global::Seamless.Collections.ISet&lt;TSource&gt;</SeamlessLinqEnumerableSourceType>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="SeamlessGenerateLinqEnumerable" />
    <CompilerVisibleProperty Include="SeamlessLinqEnumerableNamespace" />
    <CompilerVisibleProperty Include="SeamlessLinqEnumerableSourceType" />
  </ItemGroup>

</Project>
