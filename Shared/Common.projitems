<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Common\TestInfrastructure\**\*.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)Common\TestInfrastructure\TsavoriteBase.cs" Condition="'$(Tsavorite)'!='true'" />
    <Compile Remove="$(MSBuildThisFileDirectory)Common\TestInfrastructure\TsavoriteConsumerExtensions.cs" Condition="'$(Tsavorite)'!='true'" />
    <Compile Remove="$(MSBuildThisFileDirectory)Common\TestInfrastructure\PersistedBase.cs" Condition="'$(Persisted)'!='true'" />
    <Compile Remove="$(MSBuildThisFileDirectory)Common\TestInfrastructure\PersistedConsumerExtensions.cs" Condition="'$(Persisted)'!='true'" />
  </ItemGroup>
</Project>
