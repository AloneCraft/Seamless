<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>{B30EBE1D-B5F9-49BE-A7FB-491F47D95AB6}</SharedGUID>
  </PropertyGroup>
  <PropertyGroup>
    <Persisted>true</Persisted>
    <Tsavorite>true</Tsavorite>
    <DefineConstants>$(DefineConstants);PERSISTED;TSAVORITE</DefineConstants>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\Common\Common.projitems" />
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)OptimizationBenchmarks.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)OptimizationTypes.cs" />
    <PackageReference Include="ZLinq" Version="1.5.6" />
  </ItemGroup>
</Project>