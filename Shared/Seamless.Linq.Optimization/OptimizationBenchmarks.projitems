<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>{B30EBE1D-B5F9-49BE-A7FB-491F47D95AB6}</SharedGUID>
  </PropertyGroup>
  <PropertyGroup>
    <Persisted>true</Persisted>
    <Tsavorite>true</Tsavorite>
    <DefineConstants>$(DefineConstants);PERSISTED;TSAVORITE</DefineConstants>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\Common\Common.projitems" />
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)TsavoritePushdown.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)TsavoritePipeline.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Tsavorite.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PersistedPushdown.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PersistedPipeline.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Persisted.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)RangePushdown.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)RangePipeline.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Range.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ListPushdown.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ListPipeline.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)List.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ListSource.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)EnumerablePushdown.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)EnumerablePipeline.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)IEnumerable.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)EnumerableSource.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ArrayPushdown.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ArrayPipeline.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Array.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)OptimizationSettings.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PredicatePushdown.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PipelineFusion.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Rewrite.cs" />
    <PackageReference Include="ZLinq" Version="1.5.6" />
  </ItemGroup>
</Project>