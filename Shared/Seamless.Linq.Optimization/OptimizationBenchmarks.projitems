<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>{B30EBE1D-B5F9-49BE-A7FB-491F47D95AB6}</SharedGUID>
  </PropertyGroup>
  <PropertyGroup>
    <Persisted>true</Persisted>
    <Tsavorite>true</Tsavorite>
    <DefineConstants>$(DefineConstants);PERSISTED;TSAVORITE</DefineConstants>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\Common\Common.projitems" />
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Rewrite\Array.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Rewrite\IEnumerable.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Rewrite\List.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Rewrite\Persisted.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Rewrite\Range.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Rewrite\Tsavorite.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PipelineFusion\Array.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PipelineFusion\IEnumerable.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PipelineFusion\List.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PipelineFusion\Persisted.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PipelineFusion\Range.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PipelineFusion\Tsavorite.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PredicatePushdown\Array.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PredicatePushdown\IEnumerable.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PredicatePushdown\List.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PredicatePushdown\Persisted.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PredicatePushdown\Range.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PredicatePushdown\Tsavorite.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ListSource.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)EnumerableSource.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)OptimizationSettings.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PredicatePushdown.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PipelineFusion.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Rewrite.cs" />
    <PackageReference Include="ZLinq" Version="1.5.6" />
  </ItemGroup>
</Project>