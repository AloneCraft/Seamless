{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ビルド (Debug)",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/Seamless.Application.slnx", "-c", "Debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "ビルド (Release)",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/Seamless.Application.slnx", "-c", "Release"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
