<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Seamless.Application.Schema</AssemblyName>
    <RootNamespace>Seamless.Application.Schema</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(SeamlessRepositoryRoot)'!=''">
    <ProjectReference Include="$(SeamlessRepositoryRoot)/Seamless/Database/Client/Client.csproj" />
    <ProjectReference Include="$(SeamlessRepositoryRoot)/Seamless/Database/Generator/Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(SeamlessRepositoryRoot)'==''">
    <PackageReference Include="Seamless" Version="$(SeamlessPackageVersion)" />
  </ItemGroup>
</Project>
