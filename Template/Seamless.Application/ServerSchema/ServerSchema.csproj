<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Seamless.Application.ServerSchema</AssemblyName>
    <RootNamespace>Seamless.Application.ServerSchema</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Schema/Schema.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(SeamlessRepositoryRoot)'!=''">
    <ProjectReference Include="$(SeamlessRepositoryRoot)/Seamless/Database/Database.csproj" />
    <ProjectReference Include="$(SeamlessRepositoryRoot)/Seamless/Database/Server/Server.csproj" />
    <ProjectReference Include="$(SeamlessRepositoryRoot)/Seamless/Database/Generator/Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(SeamlessRepositoryRoot)/Seamless/FLinq/Generator/Compiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(SeamlessRepositoryRoot)'==''">
    <PackageReference Include="Seamless" Version="$(SeamlessPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <PropertyGroup>
    <SeamlessLinqAnalysis>false</SeamlessLinqAnalysis>
  </PropertyGroup>
</Project>
