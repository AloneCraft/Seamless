<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TsavoriteTargetFramework Condition="'$(TsavoriteTargetFramework)' == ''">net10.0</TsavoriteTargetFramework>
    <TargetFramework>$(TsavoriteTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <Features>InterceptorsPreview</Features>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Intercept</InterceptorsPreviewNamespaces>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>Test</AssemblyName>
    <RootNamespace>Test</RootNamespace>
    <DefineConstants>$(DefineConstants);TSAVORITE2_0BETA3</DefineConstants>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Seamless\Collections\artifacts\**" />
    <EmbeddedResource Remove="Seamless\Collections\artifacts\**" />
    <EmbeddedResource Remove="Seamless\Collections\Garnet\**" />
    <None Remove="Seamless\Collections\artifacts\**" />
    <None Remove="Seamless\Collections\Garnet\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="JetBrains.Profiler.Api" Version="1.*" />
    <PackageReference Include="MemoryPack" Version="1.*" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Microsoft.Garnet" Version="2.0.1-beta.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ZLinq">
      <HintPath>$(NuGetPackageRoot)zlinq/1.5.6/lib/net10.0/ZLinq.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Seamless.Collections.Abstractions\Seamless.Collections.Abstractions.csproj" />
    <ProjectReference Include="..\Seamless.Collections.Persisted\Seamless.Collections.Persisted.csproj" />
    <ProjectReference Include="..\Tsavorite.Collections\Seamless.Collections.Tsavorite.csproj" />
    <ProjectReference Include="..\FLinq\FLinq.csproj" />
    <ProjectReference Include="..\SourceGenerator.Shared\SourceGenerator.Shared.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\FLinq\FLinq.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\TsavoriteDB\TsavoriteDB.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Benchmark.Runner.Uno\Benchmark.Runner.Uno\BenchmarkRunnerModels.cs" Link="Benchmark.Runner.Uno\BenchmarkRunnerModels.cs" />
    <Compile Include="..\Benchmark.Runner.Uno\Benchmark.Runner.Uno\CpuPresetCatalog.cs" Link="Benchmark.Runner.Uno\CpuPresetCatalog.cs" />
    <Compile Include="..\Benchmark.Runner.Uno\Benchmark.Runner.Uno\BenchmarkReportFormatter.cs" Link="Benchmark.Runner.Uno\BenchmarkReportFormatter.cs" />
    <Compile Include="..\Benchmark.Runner.Uno\Benchmark.Runner.Uno\CsvStringBuilderExtensions.cs" Link="Benchmark.Runner.Uno\CsvStringBuilderExtensions.cs" />
  </ItemGroup>
</Project>
