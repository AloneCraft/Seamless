<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TsavoriteTargetFramework Condition="'$(TsavoriteTargetFramework)' == ''">net10.0</TsavoriteTargetFramework>
    <TargetFramework>$(TsavoriteTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <Features>InterceptorsPreview</Features>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Intercept</InterceptorsPreviewNamespaces>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>Test</AssemblyName>
    <RootNamespace>Test</RootNamespace>
    <DefineConstants>$(DefineConstants);TSAVORITE2_0BETA3</DefineConstants>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Seamless\Collections\artifacts\**" />
    <EmbeddedResource Remove="Seamless\Collections\artifacts\**" />
    <EmbeddedResource Remove="Seamless\Collections\Garnet\**" />
    <None Remove="Seamless\Collections\artifacts\**" />
    <None Remove="Seamless\Collections\Garnet\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="JetBrains.Profiler.Api" Version="1.*" />
    <PackageReference Include="MemoryPack" Version="1.*" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Microsoft.Garnet" Version="2.0.1-beta.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ZLinq">
      <HintPath>$(NuGetPackageRoot)zlinq/1.5.6/lib/net10.0/ZLinq.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DynamicLinq.Runner\DynamicLinq.Runner.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Benchmark.Worker\Benchmark.Worker.csproj" />
    <ProjectReference Include="..\Test.System.Linq.Enumerable.Linq\Test.System.Linq.Enumerable.Linq.csproj" PrivateAssets="all" Aliases="BenchmarkLinq" />
    <ProjectReference Include="..\Test.System.Linq.Enumerable.FLinq\Test.System.Linq.Enumerable.FLinq.csproj" PrivateAssets="all" Aliases="BenchmarkFLinq" />
    <ProjectReference Include="..\Test.System.Linq.Enumerable.ZLinq\Test.System.Linq.Enumerable.ZLinq.csproj" PrivateAssets="all" Aliases="BenchmarkZLinq" />
    <ProjectReference Include="..\Seamless.Abstractions\Seamless.Abstractions.csproj" />
    <ProjectReference Include="..\Seamless.Linq\Seamless.Linq.csproj" />
    <ProjectReference Include="..\Seamless.Persisted.Collections\Seamless.Persisted.Collections.csproj" />
    <ProjectReference Include="..\Seamless.Tsavorite.Collections\Seamless.Tsavorite.Collections.csproj" />
    <ProjectReference Include="..\Seamless.FLinq\Seamless.FLinq.csproj" />
    <ProjectReference Include="..\Seamless.SourceGenerators\Seamless.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\Seamless.FLinq\Seamless.FLinq.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\Seamless.Database\Seamless.Database.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
</Project>
