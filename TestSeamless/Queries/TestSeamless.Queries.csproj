  <ItemGroup>
    <PackageReference Include="Seamless.Database.Client" Version="$(SeamlessPackageVersion)" />
    <PackageReference Include="Seamless.FLinq.Generator" Version="$(SeamlessPackageVersion)" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Schema/TestSeamless.Schema.csproj" />
    <Compile Include="$(GenerationDirectory)/queries/**/*.cs" />
  </ItemGroup>
</Project>
