<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>TestSeamless.Queries</AssemblyName>
    <RootNamespace>TestSeamless.Queries</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Intercept</InterceptorsNamespaces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Seamless" Version="$(SeamlessPackageVersion)" />
    <ProjectReference Include="../Schema/TestSeamless.Schema.csproj" />
    <Compile Include="$(GenerationDirectory)/queries/**/*.cs" />
  </ItemGroup>
</Project>
