<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>Database.Query.Tests</AssemblyName>
    <RootNamespace>Database.Query.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <PackageReference Include="MemoryPack" Version="1.*" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../Seamless.Database.Query/Seamless.Database.Query.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/*.json" />
  </ItemGroup>
  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Features>InterceptorsPreview</Features>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Intercept</InterceptorsPreviewNamespaces>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Seamless.TestKit/Seamless.TestKit.csproj" />
    <ProjectReference Include="../../Seamless.Database.Generator/Seamless.Database.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    <ProjectReference Include="../../Seamless.FLinq.Generator/Seamless.FLinq.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    <Using Include="Seamless.Collections" />
    <Using Include="Seamless.Collections.Tsavorite" />
    <Using Include="Seamless.TestKit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Seamless.Database.Compilation/Seamless.Database.Compilation.csproj" />
    <ProjectReference Include="../../Seamless.Database.Client/Seamless.Database.Client.csproj" />
    <ProjectReference Include="../../Seamless.Database.Rdbms/Seamless.Database.Rdbms.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <ProjectReference Include="../../Seamless.Database/Seamless.Database.csproj" />
    <ProjectReference Include="../../Seamless.Linq/Seamless.Linq.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../tools/Database.Verification/Database.Verification.csproj" />
    <ProjectReference Include="../../Seamless.Database.Transfer/Seamless.Database.Transfer.csproj" />
    <ProjectReference Include="../../Seamless.Database.SqlServer/Seamless.Database.SqlServer.csproj" />
  </ItemGroup>
</Project>
