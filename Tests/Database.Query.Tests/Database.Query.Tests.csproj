<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>Database.Query.Tests</AssemblyName>
    <RootNamespace>Database.Query.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <PackageReference Include="MemoryPack" Version="1.*" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../Seamless/Database/Database.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/*.json" />
  </ItemGroup>
  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Features>InterceptorsPreview</Features>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Intercept</InterceptorsPreviewNamespaces>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Seamless.TestKit/Seamless.TestKit.csproj" />
    <ProjectReference Include="../../Seamless/Database/Generator/Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    <ProjectReference Include="../../Seamless/FLinq/Generator/Compiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    <Using Include="Seamless.Collections" />
    <Using Include="Seamless.Collections.Tsavorite" />
    <Using Include="Seamless.TestKit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Seamless/Database/Client/Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <ProjectReference Include="../../Seamless/Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../tools/Database.Verification/Database.Verification.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <SeamlessLinqAnalysis>false</SeamlessLinqAnalysis>
  </PropertyGroup>
</Project>
