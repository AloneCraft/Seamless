<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Database.SqlTranslation.Tests</RootNamespace>
    <AssemblyName>Database.SqlTranslation.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../Seamless.Database.SqlTranslation/Seamless.Database.SqlTranslation.csproj" />
    <ProjectReference Include="../../Seamless.Linq/Seamless.Linq.csproj" />
    <ProjectReference Include="../../Seamless.Collections/Seamless.Collections.csproj" />
    <ProjectReference Include="../../Seamless.FLinq.Generator/Seamless.FLinq.Generator.csproj" ReferenceOutputAssembly="true" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Database.Query.Tests/Fixtures/*.json" LogicalName="Fixtures.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Seamless.Database.SqlServer.Functions/Seamless.Database.SqlServer.Functions.csproj" />
  </ItemGroup>
</Project>
