<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><LangVersion>14</LangVersion><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsTestProject>true</IsTestProject>
    <RootNamespace>Database.SqlTranslation.Tests</RootNamespace><AssemblyName>Database.SqlTranslation.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" /><PackageReference Include="xunit" Version="2.9.3" /><PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
    <!-- SqlClient の間接参照を、CVE-2026-84008 と CVE-2026-70162 が修正された .NET 10 向けの版へ更新する。 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../Seamless.Database.SqlTranslation/Seamless.Database.SqlTranslation.csproj" />
    <ProjectReference Include="../../Seamless.Linq/Seamless.Linq.csproj" />
    <ProjectReference Include="../../Seamless.Collections/Seamless.Collections.csproj" />
    <!-- GROUP BY の訳し方の実験で、FLinq の生成器を小さなコードに当てる(この試験プロジェクト自身には生成器をかけない)。 -->
    <ProjectReference Include="../../Seamless.FLinq.Generator/Seamless.FLinq.Generator.csproj" ReferenceOutputAssembly="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- 本物の SQL Server から取った、サンプルDBのビューの定義と列(Database.Query.Tests と同じもの)。 -->
    <EmbeddedResource Include="../Database.Query.Tests/Fixtures/*.json" LogicalName="Fixtures.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
