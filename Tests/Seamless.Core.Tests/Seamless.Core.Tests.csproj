<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <StartupObject>Seamless.Transactions.Tests.ProcessEntryPoint</StartupObject>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Seamless.Core.Tests</RootNamespace>
    <AssemblyName>Seamless.Core.Tests</AssemblyName>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Intercept;Intercept.Seamless.Core.Tests</InterceptorsNamespaces>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Intercept;Intercept.Seamless.Core.Tests</InterceptorsPreviewNamespaces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../Seamless/Database/Database.csproj" />
    <ProjectReference Include="../../Seamless/Database/Client/Client.csproj" />
    <ProjectReference Include="../../Seamless/Runtime.csproj" />
    <ProjectReference Include="../Seamless.TestKit/Seamless.TestKit.csproj" />
    <ProjectReference Include="../../Seamless/FLinq/Generator/Compiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Features>InterceptorsPreview</Features>
    <DefineConstants>$(DefineConstants);BENCH_AS_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Persisted/Work/**" />
    <Compile Include="Persisted/Work/*.cs" />
    <EmbeddedResource Remove="Persisted/Work/**" />
    <None Remove="Persisted/Work/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MemoryPack" Version="1.*" />
    <PackageReference Include="ZLinq" Version="1.5.6" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Common" />
    <Using Include="BenchmarkDotNet.Attributes" />
    <Using Include="Seamless.Collections" />
    <Using Include="Seamless.TestKit" />
    <Using Include="ZLinq" />
  </ItemGroup>
  <Import Project="../../Shared/Persisted.Collections/Persisted.Collections.projitems" Label="Shared" />
  <ItemGroup>
    <PackageReference Include="Microsoft.Garnet" Version="[2.2.8]" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Seamless.Collections.Tsavorite" />
  </ItemGroup>
  <Import Project="../../Shared/Tsavorite.Collections/Tsavorite.Collections.projitems" Label="Shared" />
  <ItemGroup>
    <ProjectReference Include="../../Seamless/Tsavorite/Core/Tsavorite.Core.csproj" />
    <Reference Include="Garnet.common">
      <HintPath>$(PkgMicrosoft_Garnet)/lib/net10.0/Garnet.common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Tsavorite.devices.AzureStorageDevice">
      <HintPath>$(PkgMicrosoft_Garnet)/lib/net10.0/Tsavorite.devices.AzureStorageDevice.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Import Project="../../Seamless/Tsavorite/Core/buildTransitive/Seamless.Tsavorite.Core.targets" />
  <ItemGroup>
    <Compile Remove="../../Shared/Common/TestInfrastructure/AssemblyInfo.cs" />
  </ItemGroup>
  <PropertyGroup>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    </ItemGroup>
  <PropertyGroup>
    <SeamlessLinqAnalysis>false</SeamlessLinqAnalysis>
  </PropertyGroup>
</Project>
