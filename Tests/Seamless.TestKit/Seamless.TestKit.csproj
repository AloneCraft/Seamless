<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Seamless.TestKit</RootNamespace>
    <AssemblyName>Seamless.TestKit</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Artifacts/**" />
    <Compile Remove="Work/**" />
    <EmbeddedResource Remove="Artifacts/**" />
    <EmbeddedResource Remove="Work/**" />
    <None Remove="Artifacts/**" />
    <None Remove="Work/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.*" />
    <PackageReference Include="Microsoft.Garnet" Version="[2.2.8]" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="xunit.assert" Version="2.9.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Seamless/Database/Database.csproj" />
    <ProjectReference Include="../../Seamless/Database/Generator/Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    <ProjectReference Include="../../Seamless/FLinq/Generator/Compiler.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Seamless/Tsavorite/Core/Tsavorite.Core.csproj" />
    <Reference Include="Garnet.common">
      <HintPath>$(PkgMicrosoft_Garnet)/lib/net10.0/Garnet.common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Tsavorite.devices.AzureStorageDevice">
      <HintPath>$(PkgMicrosoft_Garnet)/lib/net10.0/Tsavorite.devices.AzureStorageDevice.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Import Project="../../Seamless/Tsavorite/Core/buildTransitive/Seamless.Tsavorite.Core.targets" />
</Project>
