<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Seamless.Collections.Tsavorite</RootNamespace>
    <AssemblyName>Seamless.Collections.Tsavorite</AssemblyName>
    <PackageId>Seamless.Collections.Tsavorite</PackageId>
    <Title>Seamless Collections Tsavorite</Title>
    <Description>Tsavorite-backed collections for Seamless.</Description>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Garnet" Version="2.0.1-beta.5" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Seamless.Collections.Abstractions\Seamless.Collections.Abstractions.csproj" />
    <ProjectReference Include="..\Seamless.Collections.Persisted\Seamless.Collections.Persisted.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TsavoriteGarnetPackageVersion</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFileName('$(PkgMicrosoft_Garnet)'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>