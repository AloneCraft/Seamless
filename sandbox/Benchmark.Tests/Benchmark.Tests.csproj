<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Features>InterceptorsPreview</Features>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Intercept</InterceptorsPreviewNamespaces>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Seamless.Benchmarks</RootNamespace>
    <!-- 各[Benchmark]を[BenchFact]としてテストエクスプローラで実行する -->
    <DefineConstants>$(DefineConstants);BENCH_AS_TEST</DefineConstants>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj/Generated</CompilerGeneratedFilesOutputPath>
    <!-- CS8002: Referenced assembly does not have a strong name.-->
    <NoWarn>$(NoWarn);CS8002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="BenchmarkDotNet.Attributes" />
    <Using Include="BenchmarkDotNet.Configs" />
    <Using Include="BenchmarkDotNet.Engines" />
    <Using Include="System.Collections.Immutable" />
    <Using Include="System.Collections.Frozen" />
    <!-- 共有ベンチ各ファイルの ZLinq / [NoLinqRewrite] を暗黙で解決 -->
    <Using Include="ZLinq" />
    <Using Include="Tsavorite.SourceGenerator" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ZLinq">
      <HintPath>$(NuGetPackageRoot)zlinq/1.5.6/lib/net10.0/ZLinq.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tsavorite.Collections\Tsavorite.Collections.csproj" />
    <ProjectReference Include="..\..\src\FLinq\FLinq.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!-- ベンチマーク本体は共有プロジェクトから取り込む（Benchmark.csproj と共有） -->
  <Import Project="..\Benchmark.Shared\Benchmark.Shared.projitems" Label="Shared" />

</Project>
