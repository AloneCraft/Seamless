<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Features>InterceptorsPreview</Features>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Intercept</InterceptorsPreviewNamespaces>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj/Generated</CompilerGeneratedFilesOutputPath>
    <!-- CS8002: Referenced assembly does not have a strong name.-->
    <NoWarn>$(NoWarn);CS8002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="BenchmarkDotNet.Artifacts\**" />
    <Compile Remove="Benchmarks\ComplexChain\**" />
    <Compile Remove="Benchmarks\Helpers\**" />
    <Compile Remove="Benchmarks\SimpleChain\**" />
    <EmbeddedResource Remove="BenchmarkDotNet.Artifacts\**" />
    <EmbeddedResource Remove="Benchmarks\ComplexChain\**" />
    <EmbeddedResource Remove="Benchmarks\Helpers\**" />
    <EmbeddedResource Remove="Benchmarks\SimpleChain\**" />
    <None Remove="BenchmarkDotNet.Artifacts\**" />
    <None Remove="Benchmarks\ComplexChain\**" />
    <None Remove="Benchmarks\Helpers\**" />
    <None Remove="Benchmarks\SimpleChain\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="C:\Users\kazuh\.nuget\packages\microsoft.visualstudio.diagnosticshub.benchmarkdotnetdiagnosers\18.7.37220.1\contentFiles\cs\any\BenchmarkProfilerAgentConfig.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="C:\Users\kazuh\.nuget\packages\microsoft.diagnostics.tracing.traceevent\3.1.21\buildTransitive\..\build\native\x86\KernelTraceControl.dll" />
    <None Remove="C:\Users\kazuh\.nuget\packages\microsoft.diagnostics.tracing.traceevent\3.1.21\buildTransitive\..\build\native\x86\KernelTraceControl.Win61.dll" />
    <None Remove="C:\Users\kazuh\.nuget\packages\microsoft.diagnostics.tracing.traceevent\3.1.21\buildTransitive\..\build\native\x86\msdia140.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
    <PackageReference Include="Kokuban" Version="0.2.0" />
    <PackageReference Include="Microsoft.VisualStudio.DiagnosticsHub.BenchmarkDotNetDiagnosers" Version="18.7.37220.1" />
    <PackageReference Include="ZLinq" Version="1.5.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Enable implicit usings of BenchmarkDotNet namespaces -->
    <Using Include="BenchmarkDotNet.Attributes" />
    <Using Include="BenchmarkDotNet.Configs" />
    <Using Include="BenchmarkDotNet.Engines" />
    <!-- Enable implicit usings for Immutable/Frozen Collections to use System.Linq extension methods -->
    <Using Include="System.Collections.Immutable" />
    <Using Include="System.Collections.Frozen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tsavorite.Collections\Tsavorite.Collections.csproj" />
    <!-- Build dependency: ensure SourceGenerator DLL is up to date -->
    <ProjectReference Include="..\..\src\FLinq\FLinq.csproj" ReferenceOutputAssembly="false" Private="false" Condition="'$(Configuration)' != 'SystemLinq'" />
  </ItemGroup>

  <!-- Add SourceGenerator as Analyzer directly (works only after first build of SourceGenerator) -->
  <ItemGroup Condition="'$(Configuration)' != 'SystemLinq'">
    <Analyzer Include="$(MSBuildThisFileDirectory)../../src/FLinq/bin/Debug/net10.0/FLinq.dll" Condition="'$(Configuration)' == 'Debug' and Exists('$(MSBuildThisFileDirectory)../../src/FLinq/bin/Debug/net10.0/FLinq.dll')" />
    <Analyzer Include="$(MSBuildThisFileDirectory)../../src/FLinq/bin/Release/net10.0/FLinq.dll" Condition="'$(Configuration)' == 'Release' and Exists('$(MSBuildThisFileDirectory)../../src/FLinq/bin/Release/net10.0/FLinq.dll')" />
  </ItemGroup>






  <!-- Custom target to cleanup `bin`, and `BenchmarkDotNet.Artifacts` directories. (`obj` is retained. Because it cause intellisense error when deleted) -->
  <Target Name="CleanBenchmarkDotNetArtifacts" BeforeTargets="Clean" Condition="Exists('bin')">
    <RemoveDir ContinueOnError="WarnAndContinue" Directories="$(MSBuildThisFileDirectory)bin" />
    <RemoveDir ContinueOnError="WarnAndContinue" Directories="$(MSBuildThisFileDirectory)BenchmarkDotNet.Artifacts" />
  </Target>
</Project>
