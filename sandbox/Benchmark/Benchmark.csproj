<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Features>InterceptorsPreview</Features>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Intercept</InterceptorsPreviewNamespaces>
    <!-- CS8002: Referenced assembly does not have a strong name.-->
    <NoWarn>$(NoWarn);CS8002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
    <PackageReference Include="Kokuban" Version="0.2.0" />
    <PackageReference Include="ZLinq" Version="1.5.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Enable implicit usings of BenchmarkDotNet namespaces -->
    <Using Include="BenchmarkDotNet.Attributes" />
    <Using Include="BenchmarkDotNet.Configs" />
    <Using Include="BenchmarkDotNet.Engines" />
    <!-- Enable implicit usings for Immutable/Frozen Collections to use System.Linq extension methods -->
    <Using Include="System.Collections.Immutable" />
    <Using Include="System.Collections.Frozen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Seamless\Seamless.csproj" />
    <!-- Build dependency: ensure SourceGenerator DLL is up to date -->
    <ProjectReference Include="..\..\src\Seamless.SourceGenerator\Seamless.SourceGenerator.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      Condition="'$(Configuration)' != 'SystemLinq'" />
  </ItemGroup>

  <!-- Add SourceGenerator as Analyzer directly (works only after first build of SourceGenerator) -->
  <ItemGroup Condition="'$(Configuration)' != 'SystemLinq'">
    <Analyzer Include="$(MSBuildThisFileDirectory)../../src/Seamless.SourceGenerator/bin/Debug/net10.0/Seamless.SourceGenerator.dll"
              Condition="'$(Configuration)' == 'Debug' and Exists('$(MSBuildThisFileDirectory)../../src/Seamless.SourceGenerator/bin/Debug/net10.0/Seamless.SourceGenerator.dll')" />
    <Analyzer Include="$(MSBuildThisFileDirectory)../../src/Seamless.SourceGenerator/bin/Release/net10.0/Seamless.SourceGenerator.dll"
              Condition="'$(Configuration)' == 'Release' and Exists('$(MSBuildThisFileDirectory)../../src/Seamless.SourceGenerator/bin/Release/net10.0/Seamless.SourceGenerator.dll')" />
  </ItemGroup>

  <!-- Exclude ZLinq-specific benchmark files -->
  <ItemGroup>
    <Compile Remove="Benchmarks/**" />
    <Compile Include="Benchmarks/Seamless/**" />
    <Compile Include="Benchmarks/WhereSelectStringJoin.cs" />
    <Compile Include="Benchmarks/LibraryComparison.cs" />
    <Compile Remove="BenchmarkDotNet/ExtensionMethods/ConsumerExtensions.cs" />
    <Compile Remove="BenchmarkDotNet/ExtensionMethods/ConsumerExtensions.BinaryOperations.cs" />
    <Compile Remove="BenchmarkDotNet/ExtensionMethods/ConsumerExtensions.UnaryOperations.cs" />
    <Compile Remove="BenchmarkDotNet/Filters/ZLinqNuGetVersionFilter.cs" />
    <Compile Remove="BenchmarkDotNet/BenchmarkConfigs/NuGetVersionsBenchmarkConfig.cs" />
    <Compile Remove="ExtensionMethods/**" />
    <Compile Remove="TestData/**" />
    <Compile Remove="Models/**" />
    <Compile Remove="BenchmarkDotNet/EventProcessors/**" />
    <Compile Remove="BenchmarkDotNet/ExtensionMethods/SummariesExtensions.cs" />
    <Compile Remove="BenchmarkDotNet/ExtensionMethods/SummaryTableExtensions.cs" />
  </ItemGroup>

  <!-- Settings for SystemLinqBenchmarkConfig: disable interceptor, use plain System.Linq -->
  <PropertyGroup Condition="'$(Configuration)'=='SystemLinq'">
    <DefineConstants>$(DefineConstants);USE_SYSTEM_LINQ</DefineConstants>
  </PropertyGroup>

  <!-- Custom target to cleanup `bin`, and `BenchmarkDotNet.Artifacts` directories. (`obj` is retained. Because it cause intellisense error when deleted) -->
  <Target Name="CleanBenchmarkDotNetArtifacts" BeforeTargets="Clean" Condition="Exists('bin')">
    <RemoveDir ContinueOnError="WarnAndContinue" Directories="$(MSBuildThisFileDirectory)bin" />
    <RemoveDir ContinueOnError="WarnAndContinue" Directories="$(MSBuildThisFileDirectory)BenchmarkDotNet.Artifacts" />
  </Target>
</Project>
