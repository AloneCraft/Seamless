{
  "profiles": {
    "Default": {
      "commandName": "Project",
      "workingDirectory": "."
    },
    "RunAllBenchmark(Debug)": {
      "commandName": "Project",
      "environmentVariables": {
        "BDN_DEBUG": "1"
      }
    },
    "RunAll1FileBenchmark(Debug)": {
      "commandName": "Project",
      "environmentVariables": {
        "BDN_DEBUG": "1",
        "SEAMLESS_BENCHMARK_SINGLE_FILE": "1"
      }
    },
    "Run All Benchmarks": {
      "commandName": "Project"
    },
    "Run All 1 File Benchmarks": {
      "commandName": "Project",
      "environmentVariables": {
        "SEAMLESS_BENCHMARK_SINGLE_FILE": "1"
      }
    },
    "Run All Benchmarks with --join": {
      "commandName": "Project",
      "commandLineArgs": "--filter * --join"
    },
    "List Benchmark": {
      "commandName": "Project",
      "commandLineArgs": "--list tree"
    },
    "Help": {
      "commandName": "Project",
      "commandLineArgs": "--help"
    }
  }
}
