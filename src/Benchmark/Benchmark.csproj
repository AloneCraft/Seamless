<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <Configurations>Debug;Release;Debug1;Release1;Debug2;Release2</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageReference Include="MemoryPack" Version="1.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug1' or '$(Configuration)' == 'Release1'">
    <ProjectReference Include="..\Seamless1\Seamless1.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug2' And '$(Configuration)' != 'Release2'">
    <ProjectReference Include="..\Seamless2\Seamless2.csproj" />
  </ItemGroup>
</Project>
