<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(SeamlessTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <Features>InterceptorsPreview</Features>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Intercept</InterceptorsPreviewNamespaces>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <Configurations>Debug;DebugNet8;DebugNet9;DebugNet10;Release;ReleaseNet8;ReleaseNet9;ReleaseNet10;Release001;Release002;Release004;Release008;Release016;Release032;Release064;Release128;Release256;Release512</Configurations>
    <RootNamespace>BenchmarkExe</RootNamespace>
    <AssemblyName>Benchmark</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <SeamlessBenchmarkOutputLabel Condition="'$(SeamlessBenchmarkOutputLabel)' == ''">Seamless</SeamlessBenchmarkOutputLabel>

    <SeamlessBenchmarkOutputFrameworkLabel Condition="'$(SeamlessTargetFramework)' == 'net8.0'">net8</SeamlessBenchmarkOutputFrameworkLabel>
    <SeamlessBenchmarkOutputFrameworkLabel Condition="'$(SeamlessTargetFramework)' == 'net9.0'">net9</SeamlessBenchmarkOutputFrameworkLabel>
    <SeamlessBenchmarkOutputFrameworkLabel Condition="'$(SeamlessTargetFramework)' == 'net10.0'">net10</SeamlessBenchmarkOutputFrameworkLabel>
    <SeamlessBenchmarkOutputFrameworkLabel Condition="'$(SeamlessBenchmarkOutputFrameworkLabel)' == ''">$(SeamlessTargetFramework)</SeamlessBenchmarkOutputFrameworkLabel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SeamlessBaseConfiguration)' == 'Debug'">
	<DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
	<Optimize>false</Optimize>
	<DebugType>portable</DebugType>
	<DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SeamlessBaseConfiguration)' == 'Release'">
	<Optimize>true</Optimize>
	<DebugType>portable</DebugType>
	<DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([System.String]::Copy('$(SeamlessBaseConfiguration)').StartsWith('Release')) and '$(SeamlessBaseConfiguration)' != 'Release'">
	<Optimize>true</Optimize>
	<DebugType>portable</DebugType>
	<DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BenchmarkProjectDir</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SeamlessBenchmarkOutputLabel</_Parameter1>
      <_Parameter2>$(SeamlessBenchmarkOutputLabel)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SeamlessBenchmarkOutputFrameworkLabel</_Parameter1>
      <_Parameter2>$(SeamlessBenchmarkOutputFrameworkLabel)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SeamlessBaseConfiguration</_Parameter1>
      <_Parameter2>$(SeamlessBaseConfiguration)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="BenchmarkColumnsConfig.cs" />
    <Compile Include="BenchmarkScale.cs" />
    <Compile Include="DictionaryStoreBenchmark.cs" />
    <Compile Include="DictionaryApiSurfaceBenchmark.cs" />
    <Compile Include="HashSetApiSurfaceBenchmark.cs" />
    <Compile Include="ListApiSurfaceBenchmark.cs" />
    <Compile Include="LinqSequenceFusionBenchmark.cs" />
    <Compile Include="SetOperationCapacityBenchmark.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="bin\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="bin\**" />
    <None Remove="obj\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageReference Include="MemoryPack" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Seamless.SourceGenerator\Seamless.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Seamless\Seamless.csproj" />
  </ItemGroup>
</Project>
