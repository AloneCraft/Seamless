<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Seamless.Collections</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
	<DefineConstants>$(DefineConstants);TSAVORITE2_0BETA3</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Collection\**" />
    <Compile Remove="Devices\**" />
    <Compile Remove="RelationalDatabase\**" />
    <Compile Remove="Serializer\**" />
    <EmbeddedResource Remove="Collection\**" />
    <EmbeddedResource Remove="Devices\**" />
    <EmbeddedResource Remove="RelationalDatabase\**" />
    <EmbeddedResource Remove="Serializer\**" />
    <None Remove="Collection\**" />
    <None Remove="Devices\**" />
    <None Remove="RelationalDatabase\**" />
    <None Remove="Serializer\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Global.cs" />
    <Compile Remove="IRelation.cs" />
    <Compile Remove="KeyComparer.cs" />
    <Compile Remove="Relation.cs" />
    <Compile Remove="Tuple.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.*" />
    <PackageReference Include="Microsoft.Garnet" Version="2.0.0-beta.3" />    <PackageReference Include="ZLinq" Version="1.*" />
  </ItemGroup>

  <Import Project="..\Seamless.Collections\Seamless.Collections.projitems" Label="Shared" />

</Project>
