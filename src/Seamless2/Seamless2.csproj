<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(SeamlessTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Seamless</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
	<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	<DefineConstants>$(DefineConstants);TSAVORITE2_0BETA3</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.*" />
    <PackageReference Include="Microsoft.Garnet" Version="2.0.0-beta.3" GeneratePathProperty="true" />
    <PackageReference Include="ZLinq" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SeamlessGarnetPackageVersion</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFileName('$(PkgMicrosoft_Garnet)'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Import Project="..\Seamless\Seamless.projitems" Label="Shared" />

  <ItemGroup>
    <Compile Remove="G:\GitHub\Seamless\Seamless\src\Seamless\Collections\ICreate.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ScanIteratorFunctions\" />
  </ItemGroup>

</Project>
