<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Tsavorite</RootNamespace>
    <AssemblyName>Tsavorite.Collections</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.*" />
    <PackageReference Include="Microsoft.Garnet" Version="2.0.1-beta.3" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TsavoriteGarnetPackageVersion</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFileName('$(PkgMicrosoft_Garnet)'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
