<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(SeamlessTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Test.Seamless</RootNamespace>
    <DefineConstants>$(DefineConstants);TSAVORITE2_0BETA3</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="artifacts\**" />
    <Compile Remove="Garnet\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <EmbeddedResource Remove="Garnet\**" />
    <None Remove="artifacts\**" />
    <None Remove="Garnet\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="..\Test.Seamless\CheckpointRecoveryTests.cs" />
    <Compile Remove="..\Test.Seamless\TestKeyComparer.cs" />
    <Compile Remove="..\Test.Seamless\TestRelation.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="8.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MemoryPack" Version="1.*" />
    <PackageReference Include="Microsoft.Garnet" Version="2.0.0-beta.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="JetBrains.Profiler.Api" Version="1.*" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <Import Project="..\Test.Seamless\Test.Seamless.projitems" Label="Shared" />
  <ItemGroup>
    <Compile Remove="..\Test.Seamless\CheckpointRecoveryTests.cs" />
    <Compile Remove="..\Test.Seamless\TestKeyComparer.cs" />
    <Compile Remove="..\Test.Seamless\TestRelation.cs" />
    <Compile Remove="..\Test.Seamless\SessionFunctions\ManagedAdd.cs" />
    <Compile Remove="..\Test.Seamless\SessionFunctions\UnmanagedAdd.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Seamless2\Seamless2.csproj" />
  </ItemGroup>
</Project>
